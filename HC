		private readonly IReportHT152EGRepository _repo;
		private readonly IWebHostEnvironment _env;

		static ReportHT152EGController()
		{
			// Required by RDLC renderer in .NET Core for some encodings
			Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
		}

		public ReportHT152EGController(IReportHT152EGRepository repo, IWebHostEnvironment env)
		{
			_repo = repo;
			_env = env;
		}

		[HttpGet]
		public async Task<IActionResult> Index()
		{
			var EMCNO = HttpContext.Session.GetString("EventId") ?? "";

			var vm = new ReportGroupsHT152Vm
			{
				EMCNO = EMCNO,
				SelectedHotelId = "",
				Comments = ""
			};

			var hotels = await _repo.BindHotelList(EMCNO);
			vm.Hotels.Clear();
			vm.Hotels.Add(new SelectItemVm("", "-- Select Hotel --"));
			if (hotels != null) vm.Hotels.AddRange(hotels);

			vm.EnsureDefaults();
			return View(vm);
		}

		// ✅ Called when hotel changes (auto bind From/To)
		[HttpPost]
		public async Task<IActionResult> GetDefaultFromTo([FromBody] Ht152DefaultFromToRequestVm req)
		{
			req.EMCNO = HttpContext.Session.GetString("EventId") ?? req.EMCNO;
			var USNNO = HttpContext.Session.GetString("USNNO") ?? "";

			// 1) existing call to API (gets From/To + EMNNO resolved)
			var result = await _repo.GetDefaultFromTo(req);
			if (result == null) return Ok(null);

			//  OVERRIDE only TO values with current datetime
			if (result != null)
			{
				var now = DateTime.Now;

				result.ToDate = now.ToString("MM/dd/yyyy", System.Globalization.CultureInfo.InvariantCulture);

				var hour12 = now.Hour % 12;
				if (hour12 == 0) hour12 = 12;

				result.ToHour = hour12.ToString("00");
				result.ToMin = now.Minute.ToString("00");
				result.ToAmPm = now.Hour >= 12 ? "PM" : "AM";
			}


			// 2) ✅ also fetch history for this hotel
			var history = await _repo.GetExportReportList(new ApiExportHistoryRequest
			{
				USNNO = USNNO,
				EMNNO = result.EMNNO,
				HTNNO = req.HotelId
			});

			result.History = history ?? new List<ReportRowVm>();

			return Ok(result);
		}



		// ✅ Main: Generate New/Changed/Canceled, save pdf, insert EXPORT_REPORT_LIST, return history
		[HttpPost]
		public async Task<IActionResult> Process([FromBody] Ht152ProcessRequestVm req)
		{
			var EMCNO = HttpContext.Session.GetString("EventId") ?? "";
			var USNNO = HttpContext.Session.GetString("USNNO") ?? ""; // adjust if your session key differs
			var currentDate = DateTime.Now;

			if (req.HotelId <= 0) return BadRequest("Hotel required");

			var actions = new List<string>();
			if (req.ChkNew) actions.Add("New");
			if (req.ChkChanged) actions.Add("Changed");
			if (req.ChkCanceled) actions.Add("Canceled");
			if (actions.Count == 0) return BadRequest("Select at least one report type");

			var generated = new List<Ht152GeneratedItemVm>();

			int resolvedEmnno = 0;
			string htcacro = "";

			foreach (var action in actions)
			{
				var apiReq = new ApiHt152ReportDataRequest
				{
					Action = action,
					EMCNO = EMCNO,
					EMNNO = resolvedEmnno,     // 0 on first call; API can resolve from EMCNO
					HTNNO = req.HotelId,
					REPORTID = req.REPORTID,   // pass your legacy reportId if you have
					USER = USNNO,
					CurrentDate = currentDate,

					FromDate = req.FromDate,
					ToDate = req.ToDate,
					FrmHour = req.FrmHour,
					FrmMin = req.FrmMin,
					FrmAmPm = req.FrmAmPm,
					ToHour = req.ToHour,
					ToMin = req.ToMin,
					ToAmPm = req.ToAmPm,
				};

				var apiResp = await _repo.GetReportData(apiReq);
				if (apiResp == null) continue;

				resolvedEmnno = apiResp.EMNNO;
				htcacro = apiResp.HTCACRO;

				// convert API rows -> DataTable for RDLC
				var dt = ToDataTable(apiResp.Rows);

				// pick RDLC + dataset name same as legacy
				var (rdlcName, dsName) = action switch
				{
					"New" => ("HT152_New.rdlc", "NewDataSet"),
					"Changed" => ("HT152_Changed.rdlc", "ChangedDataSet"),
					"Canceled" => ("HT152_Canceled.rdlc", "CanceledDataSet"),
					_ => throw new ArgumentOutOfRangeException()
				};

				// Adjust this path to where you store RDLC in Web project
				var rdlcPath = Path.Combine(_env.ContentRootPath, "Forms", "Reports", rdlcName);

				// legacy parameters dateFrom/dateTo
				var fromDt = BuildDateTime(req.FromDate, req.FrmHour, req.FrmMin, req.FrmAmPm);
				var toDt = BuildDateTime(req.ToDate, req.ToHour, req.ToMin, req.ToAmPm);

				//var pdfBytes = RenderPdf_AspNetCoreReporting(rdlcPath, dsName, dt,
				//    new Dictionary<string, string>
				//    {
				//	    ["dateFrom"] = fromDt.ToString("MM/dd/yyyy HH:mm"),
				//	    ["dateTo"] = toDt.ToString("MM/dd/yyyy HH:mm")
				//    });

				// save to wwwroot/Forms/Reports/ReportsFolder (so url works)
				var stamp = currentDate.ToString("MM-dd-yyyy HH-mm-ss");
				var fileName = $"{EMCNO}_{htcacro}_{action}_{stamp} {req.ToAmPm}.pdf";
				var relUrl = $"/Forms/Reports/ReportsFolder/{fileName}";

				var folder = Path.Combine(_env.WebRootPath, "Forms", "Reports", "ReportsFolder");
				Directory.CreateDirectory(folder);

				var physicalPath = Path.Combine(folder, fileName);
				//	await System.IO.File.WriteAllBytesAsync(physicalPath, pdfBytes);

				// insert EXPORT_REPORT_LIST (same as legacy Global.InsertReportList)
				await _repo.InsertReportList(new ApiInsertReportListRequest
				{
					USNNO = USNNO,
					EMNNO = resolvedEmnno,
					HTNNO = req.HotelId,
					RPTURL = relUrl,          // store URL, not physical path
					RPTTYPE = action,
					CURRENTDATE = currentDate
				});

				generated.Add(new Ht152GeneratedItemVm
				{
					Type = action,
					Url = relUrl,
					FileName = fileName
				});
			}

			// refresh history list
			var history = await _repo.GetExportReportList(new ApiExportHistoryRequest
			{
				USNNO = USNNO,
				EMNNO = resolvedEmnno,
				HTNNO = req.HotelId
			});

			return Ok(new { generated, history });
		}

		// ---------------- helpers ----------------

		private static DateTime BuildDateTime(string mmddyyyy, string hour, string min, string ampm)
		{
			var d = DateTime.ParseExact(mmddyyyy, "MM/dd/yyyy", CultureInfo.InvariantCulture);

			int h = int.Parse(hour);
			int m = int.Parse(min);

			// same legacy conversion
			if (ampm == "PM" && h != 12) h += 12;
			if (ampm == "AM" && h == 12) h = 0;

			return new DateTime(d.Year, d.Month, d.Day, h, m, 0);
		}

		private static DataTable ToDataTable(List<Dictionary<string, object?>> rows)
		{
			var dt = new DataTable();
			if (rows == null || rows.Count == 0) return dt;

			// columns
			foreach (var col in rows[0].Keys)
				dt.Columns.Add(col);

			// rows
			foreach (var r in rows)
			{
				var dr = dt.NewRow();
				foreach (var kv in r)
					dr[kv.Key] = kv.Value ?? DBNull.Value;

				dt.Rows.Add(dr);
			}
			return dt;
		}

