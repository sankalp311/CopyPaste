/* Simple REPORTS insert for 5 RMNNOs (with mapping + output new RMNNO) */

SET NOCOUNT ON;

DECLARE @Map TABLE (SourceRMNNO INT, RdlcFile VARCHAR(200));
INSERT INTO @Map VALUES
(815, 'TT_BlkDetail_forClient_Exp_.rdlc'),
(812, 'TT-JoelsReport.rdlc'),
(806, 'TT-RoomRatesDepositNoSvcChg.rdlc'),
(783, 'TT_BlkDetailwithPickupSQLSUB.rdlc'),
(724, 'Ht142.rdlc');

DECLARE @NewMap TABLE (SourceRMNNO INT, NewRMNNO INT, RdlcFile VARCHAR(200));

INSERT INTO REPORTS
(
    CUNNO, RMCSYSTEM, RMCACRO, RMCNAME, RMCCMT, RMCSTATUS, RMCGROUP, RMCWHERE,
    RMCREPORT, RMCTYPE, RMCRUN, RMCINDWHERE, RMCTBL1, RMCTBL2, RMCTBL3, RMCTBL4,
    RMCTBL5, RMCPREPROCESS, RMCWHERE2, RMCFORM, RMCWHERE3, RMCPOSTPROCESS,
    RMCINDWHERE2, RMCINDWHERE3, RMCFORMULANAME, RMCFORMULA, RMNPRINTTOFILE,
    RMNEXPORT, RMNSOURCETYPE, RMNVERSION, RMNAFFILIATE, RMCEXPORTTYPE,
    RMNNO_GUID, RMNNO_IMP
)
OUTPUT
    M.SourceRMNNO,
    INSERTED.RMNNO,
    M.RdlcFile
INTO @NewMap (SourceRMNNO, NewRMNNO, RdlcFile)
SELECT
    R.CUNNO,
    R.RMCSYSTEM,
    R.RMCACRO + ' - RDLC',
    R.RMCNAME,
    R.RMCCMT,
    R.RMCSTATUS,
    R.RMCGROUP,
    R.RMCGROUP,
    M.RdlcFile,
    R.RMCTYPE,
    R.RMCRUN,
    R.RMCINDWHERE,
    R.RMCTBL1,
    R.RMCTBL2,
    R.RMCTBL3,
    R.RMCTBL4,
    R.RMCTBL5,
    R.RMCPREPROCESS,
    R.RMCWHERE2,
    R.RMCFORM,
    R.RMCWHERE3,
    R.RMCPOSTPROCESS,
    R.RMCINDWHERE2,
    R.RMCINDWHERE3,
    R.RMCFORMULANAME,
    R.RMCFORMULA,
    R.RMNPRINTTOFILE,
    R.RMNEXPORT,
    R.RMNSOURCETYPE,
    R.RMNVERSION,
    R.RMNAFFILIATE,
    R.RMCEXPORTTYPE,
    R.RMNNO_GUID,
    R.RMNNO_IMP
FROM REPORTS R
JOIN @Map M ON M.SourceRMNNO = R.RMNNO
WHERE NOT EXISTS
(
    SELECT 1
    FROM REPORTS X
    WHERE X.RMCACRO   = R.RMCACRO + ' - RDLC'
      AND X.RMCREPORT = M.RdlcFile
);

-- New RMNNO result
SELECT CAST(NewRMNNO AS varchar(20)) + ' - ' + RdlcFile AS NewRMNNO_And_Report
FROM @NewMap
ORDER BY NewRMNNO;
