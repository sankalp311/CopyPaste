RDLC values and expression

Start Date     - [EMDTBEG]
Event Name     - [EMCNM]
Event #        - [EMCNO]
Rooms Contracted - =Fields!Amount_Reserved.Value + Fields!Adjustments.Value
Rooms Not Blocked - =(Fields!Amount_Reserved.Value+Fields!Adjustments.Value)-(Fields!Block_Amount_Reserved.Value+Fields!Block_Adjustments.Value)
Rooms Blocked    - =Fields!Block_Amount_Reserved.Value+Fields!Block_Adjustments.Value
Picked Up Rooms  - =Fields!General_Pickups.Value+Fields!Block_Pickups.Value
Rooms Available (in Blocks) - =Fields!Block_Remaining_Available.Value
Reservtion Shut Down - [EODDATE]

below is sql sp 
CREATE PROCEDURE [dbo].[sp_ICM_RPT_Events_Inventory_Rollup_ALL_RDLC]  
AS  
BEGIN  
    SET NOCOUNT ON;  
    SET ANSI_WARNINGS OFF;  
  
    ------------------------------------------------------------  
    -- 1) Cache the option rows once (avoid repeated scans)  
    ------------------------------------------------------------  
    IF OBJECT_ID('tempdb..#Opt') IS NOT NULL DROP TABLE #Opt;  
  
    SELECT eo.EMNNO, eo.EODDATE  
    INTO #Opt  
    FROM ICM.dbo.EVENT_OPTIONS eo  
    WHERE eo.EOCGROUP = 'ONLINEREG_OPTIONS'  
      AND eo.EOCNAME  = 'ONLINEREGCLOSES';  
  
    CREATE CLUSTERED INDEX IX_Opt_EMNNO ON #Opt(EMNNO);  
  
    ------------------------------------------------------------  
    -- 2) Eligible events only once  
    ------------------------------------------------------------  
    IF OBJECT_ID('tempdb..#Events') IS NOT NULL DROP TABLE #Events;  
  
    SELECT  e.EMNNO,  
            e.EMCNM,  
            e.EMCNO,  
            e.EMCREGISTRARNAME,  
            e.EMNMAXBLK,  
            e.EMDTBEG,  
            e.CUNNO  
    INTO #Events  
    FROM ICM.dbo.EVENTS e  
    JOIN (SELECT DISTINCT EMNNO FROM #Opt) o ON o.EMNNO = e.EMNNO  
    WHERE e.CUNNO > 1;  
  
    CREATE CLUSTERED INDEX IX_Events_EMNNO ON #Events(EMNNO);  
  
    ------------------------------------------------------------  
    -- 3) Inventory rollup (per event)  
    ------------------------------------------------------------  
    IF OBJECT_ID('tempdb..#Inv') IS NOT NULL DROP TABLE #Inv;  
  
    SELECT  ev.EMNNO,  
            SUM(hi.HINAMOUNTRESERVED)       AS Amount_Reserved,  
            SUM(hi.HINREMAININGAVAILABLE)   AS Remaining_Available,  
            SUM(hi.HINADJUSTMENTS)          AS Adjustments,  
            SUM(hi.HINOVERBOOKAMOUNT)       AS Overbook  
    INTO #Inv  
    FROM #Events ev  
    JOIN ICM.dbo.HOTEL h                 ON h.EMNNO = ev.EMNNO  
    JOIN ICM.dbo.HOTELROOMCATEGORIES hrc ON hrc.HTNNO = h.HTNNO  
    JOIN ICM.dbo.HOTELINVENTORY hi       ON hi.HRNNO = hrc.HRNNO  
    GROUP BY ev.EMNNO;  
  
    CREATE CLUSTERED INDEX IX_Inv_EMNNO ON #Inv(EMNNO);  
  
    ------------------------------------------------------------  
    -- 4) Block Inventory rollup (per event)  
    --    NOTE: Keep SAME null semantics as your original:  
    --    use (HBCLNM + HBCFNM) NOT IN (...)  (NOT CONCAT)  
    ------------------------------------------------------------  
    IF OBJECT_ID('tempdb..#BlockInv') IS NOT NULL DROP TABLE #BlockInv;  
  
    SELECT  ev.EMNNO,  
            SUM(hrbi.RBNAMOUNTRESERVED)       AS Block_Amount_Reserved,  
            SUM(hrbi.RBNREMAININGAVAILABLE)   AS Block_Remaining_Available,  
            SUM(hrbi.RBNADJUSTMENTS)          AS Block_Adjustments  
    INTO #BlockInv  
    FROM #Events ev  
    JOIN ICM.dbo.HOTEL h                      ON h.EMNNO = ev.EMNNO  
    JOIN ICM.dbo.HOTELROOMBLOCKS hrb          ON hrb.HTNNO = h.HTNNO  
    JOIN ICM.dbo.HOTELROOMBLOCKINVENTORY hrbi ON hrbi.HBNNO = hrb.HBNNO  
    WHERE (hrb.HBCLNM + hrb.HBCFNM) NOT IN ('CompTournament', 'BillingsleyJohn')  
    GROUP BY ev.EMNNO;  
  
    CREATE CLUSTERED INDEX IX_BlockInv_EMNNO ON #BlockInv(EMNNO);  
  
    ------------------------------------------------------------  
    -- 5) Pickups in ONE PASS (General + Block together)  
    ------------------------------------------------------------  
    IF OBJECT_ID('tempdb..#Pickups') IS NOT NULL DROP TABLE #Pickups;  
  
    SELECT  ev.EMNNO,  
            -- General pickups: reservation NOT tied to block (HBNNO IS NULL)  
            SUM(CASE WHEN r.HBNNO IS NULL THEN 1 ELSE 0 END) AS General_Pickups,  
  
            -- Block pickups: reservation tied to block, exclude the two names  
            SUM(CASE WHEN r.HBNNO IS NOT NULL  
                      AND (hrb.HBCLNM + hrb.HBCFNM) NOT IN ('CompTournament', 'BillingsleyJohn')  
                     THEN 1 ELSE 0 END) AS Block_Pickups  
    INTO #Pickups  
    FROM #Events ev  
    JOIN ICM.dbo.REGMST rm            ON rm.EMNNO = ev.EMNNO  
    JOIN ICM.dbo.RESERVATIONS r       ON r.RGNNO = rm.RGNNO  
                                    AND r.RSDTXLD IS NULL  
    JOIN ICM.dbo.RESNIGHTS rn         ON rn.RSNNO = r.RSNNO  
    LEFT JOIN ICM.dbo.HOTELROOMBLOCKS hrb ON hrb.HBNNO = r.HBNNO  
    GROUP BY ev.EMNNO;  
  
    CREATE CLUSTERED INDEX IX_Pickups_EMNNO ON #Pickups(EMNNO);  
  
    ------------------------------------------------------------  
    -- 6) Final output (same columns + order)  
    ------------------------------------------------------------  
    SELECT  
        ev.EMNNO,  
        ev.EMCNM,  
        ev.EMCNO,  
        ev.EMCREGISTRARNAME,  
  
        inv.Amount_Reserved,  
        inv.Remaining_Available,  
        inv.Adjustments,  
        inv.Overbook,  
  
        ISNULL(bi.Block_Amount_Reserved, 0)      AS Block_Amount_Reserved,  
        ISNULL(bi.Block_Remaining_Available, 0)  AS Block_Remaining_Available,  
        ISNULL(bi.Block_Adjustments, 0)          AS Block_Adjustments,  
  
        ISNULL(pk.General_Pickups, 0)            AS General_Pickups,  
        ISNULL(pk.Block_Pickups, 0)              AS Block_Pickups,  
  
        ev.EMNMAXBLK,  
        ev.EMDTBEG,  
        opt.EODDATE,  
        ev.CUNNO  
    FROM #Events ev  
    JOIN #Opt opt       ON opt.EMNNO = ev.EMNNO  
    JOIN #Inv inv       ON inv.EMNNO = ev.EMNNO  
    LEFT JOIN #BlockInv bi ON bi.EMNNO = ev.EMNNO  
    LEFT JOIN #Pickups pk  ON pk.EMNNO = ev.EMNNO  
      
  
END  

