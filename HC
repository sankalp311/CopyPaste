          #region ===== Page Load ===================================================================

          protected void Page_Load(object sender, EventArgs e)
          {
               Server.ScriptTimeout = 3600;

               InitSecureQueryFromToken();

               string rawToken = (Request.QueryString["t"] ?? Convert.ToString(RouteData.Values["t"]) ?? "").Trim();
               _secureToken = rawToken;

               if (string.IsNullOrWhiteSpace(rawToken))
               {
                    Response.Redirect("~/Default.aspx", false);
                    Context.ApplicationInstance.CompleteRequest();
                    return;
               }

               if (string.IsNullOrEmpty(rawToken))
               {
                    throw new InvalidOperationException("For security reasons, this Room Block Confirmation link is no longer active or appears incorrect.");

               }

               if (IsPostBack) return;

               ProcessRequest();
          }

