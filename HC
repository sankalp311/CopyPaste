INSERT INTO dbo.rsREPORTS (USNNO, RMNNO)
    SELECT
        u.USNNO,
        v.RMNNO
    FROM dbo.USERINFO u
    CROSS JOIN (VALUES
        (908)
    ) v(RMNNO)
    WHERE
        u.USNNO NOT IN (44, 94)
        AND NOT EXISTS
        (
            SELECT 1
            FROM dbo.rsREPORTS rr
            WHERE rr.USNNO = u.USNNO
              AND rr.RMNNO = v.RMNNO
        );
