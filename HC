          #region ===== Main Flow ===================================================================

          private void ProcessRequest()
          {
               string cs = ConfigurationManager.ConnectionStrings["ICMReportConnectionString"].ConnectionString;

               try
               {
                    string type = (Q("Type") ?? "").Trim();
                    string sessionId = FirstNonEmpty(Q("SUSessionID"), Q("sessionid")).Trim();
                    string blockNo = (Q("BlockNo") ?? "").Trim();
                    string emnno = (Q("EMNNO") ?? "").Trim();
                    string emailFlag = (Q("Email") ?? "").Trim();

                    TraceLog("ENTER ProcessRequest | Type=" + type + " | EMNNO=" + emnno + " | BlockNo=" + blockNo + " | Email=" + emailFlag, null, "ENTER");

                    if (!"Block".Equals(type, StringComparison.OrdinalIgnoreCase))
                    {
                         WriteAndEnd("Invalid Type. Expected Type=Block.");
                         return;
                    }

                    if (string.IsNullOrWhiteSpace(sessionId))
                    {
                         WriteAndEnd("Missing session.");
                         return;
                    }

                    if (!ValidateSessionId(sessionId, cs))
                    {
                         WriteAndEnd("Invalid session!");
                         return;
                    }

                    int emnnoInt;
                    if (!int.TryParse(emnno, out emnnoInt) || emnnoInt <= 0)
                    {
                         WriteAndEnd("Invalid EMNNO.");
                         return;
                    }

                    int hbnno;
                    if (!int.TryParse(blockNo, out hbnno) || hbnno <= 0)
                    {
                         WriteAndEnd("Invalid BlockNo/HBNNO.");
                         return;
                    }

                    DataSet ds = GetDataFromSp(cs, emnnoInt, hbnno);

                    if (ds == null || ds.Tables.Count == 0)
                    {
                         WriteAndEnd("No data returned from stored procedure.");
                         return;
                    }

                    if (!HasAnyRows(ds))
                    {
                         WriteAndEnd("No data found for the supplied EMNNO and BlockNo.");
                         return;
                    }

                    ReportRequestRow tokenRow = GetReportRequestByToken(_secureToken, cs);
                    HotelBlockEmailInfo blockInfo = GetHotelBlockEmailInfo(cs, hbnno);

                    string eventName = FirstNonEmpty(
                        GetFirstValue(ds, "EMCNM"),
                        GetFirstValue(ds, "EventName"),
                        GetFirstValue(ds, "EMCNO")
                    ).Trim();

                    string hbcno = FirstNonEmpty(
                        GetFirstValue(ds, "HBCNO"),
                        GetFirstValue(ds, "HBCNNO"),
                        blockInfo != null ? blockInfo.HbcNo : ""
                    ).Trim();

                    string pdfFileName = !string.IsNullOrWhiteSpace(hbcno)
                        ? SafeFilePart(hbnno.ToString()) + "_" + SafeFilePart(hbcno) + ".pdf"
                        : SafeFilePart(hbnno.ToString()) + ".pdf";

                    byte[] pdfBytes = BuildPdfBytes(ds, emnnoInt, hbnno);

                    if (pdfBytes == null || pdfBytes.Length == 0)
                    {
                         WriteAndEnd("Failed to generate PDF.");
                         return;
                    }

                    if (IsYes(emailFlag))
                    {
                         string toEmail = blockInfo != null ? blockInfo.ToEmail : "";

                         if (string.IsNullOrWhiteSpace(toEmail))
                         {
                              WriteAndEnd("No email found in HOTELROOMBLOCKS (HBCEMAIL) for this BlockNo.");
                              return;
                         }

                         // Priority:
                         // 1. EmailTemplate saved in ReportRequest table against token
                         // 2. HOTEL.HTCBLKEMAILMESSAGE
                         // 3. blank body
                         string rawBody = FirstNonEmpty(
                             tokenRow != null ? tokenRow.EmailTemplate : "",
                             blockInfo != null ? blockInfo.HotelEmailHtml : ""
                         );

                         string bodyHtml = NormalizeEmailBody(rawBody);

                         string subject =
                             "RoomBlock Receipt:" +
                             (string.IsNullOrWhiteSpace(eventName) ? "" : eventName);
                         // If Block Code required in the subject then uncomment below code
                         // " - " +
                         // hbnno +
                         // (string.IsNullOrWhiteSpace(hbcno) ? "" : " " + hbcno);

                         SendPdfByEmail(
                             pdfBytes,
                             pdfFileName,
                             toEmail,
                             subject,
                             bodyHtml
                         );

                         TraceLog("Email sent successfully to " + toEmail + " | Subject=" + subject, null, "EMAIL");
                         //  WriteAndEnd("Email sent successfully.");
                         CloseWindowAfterEmail("Email sent successfully.");
                         return;
                    }

                    StreamPdfInline(pdfBytes, pdfFileName);
                    TraceLog("EXIT ProcessRequest", null, "EXIT");
               }
               catch (Exception ex)
               {
                    Exception root = GetRootException(ex);
                    TraceLog("ProcessRequest ERROR", root, "ERROR");
                    WriteAndEnd(root.Message);


               }
          }

          private ReportRequestRow GetReportRequestByToken(string token, string cs)
          {
               if (string.IsNullOrWhiteSpace(token))
                    return null;

               Guid tokenGuid;
               if (!Guid.TryParse(token, out tokenGuid))
                    return null;

               const string sql = @"
          SELECT TOP 1
              InnerQueryString,
              EmailTemplate
          FROM dbo.ReportRequest
          WHERE Token = @Token";

               using (SqlConnection con = new SqlConnection(cs))
               using (SqlCommand cmd = new SqlCommand(sql, con))
               {
                    cmd.CommandType = CommandType.Text;
                    cmd.Parameters.Add("@Token", SqlDbType.UniqueIdentifier).Value = tokenGuid;

                    con.Open();
                    using (SqlDataReader dr = cmd.ExecuteReader())
                    {
                         if (!dr.Read())
                              return null;

                         return new ReportRequestRow
                         {
                              InnerQueryString = dr["InnerQueryString"] == DBNull.Value ? "" : Convert.ToString(dr["InnerQueryString"]),
                              EmailTemplate = dr["EmailTemplate"] == DBNull.Value ? "" : Convert.ToString(dr["EmailTemplate"])
                         };
                    }
               }
          }

          private HotelBlockEmailInfo GetHotelBlockEmailInfo(string cs, int hbnno)
          {
               const string sql = @"
          SELECT TOP 1
              LTRIM(RTRIM(ISNULL(HB.HBCEMAIL, ''))) AS HBCEMAIL,
              LTRIM(RTRIM(CONVERT(NVARCHAR(100), ISNULL(HB.HBCNO, '')))) AS HBCNO,
              ISNULL(H.HTCBLKEMAILMESSAGE, '') AS HTCBLKEMAILMESSAGE
          FROM dbo.HOTELROOMBLOCKS HB
          INNER JOIN dbo.HOTEL H
              ON H.HTNNO = HB.HTNNO
          WHERE HB.HBNNO = @HBNNO";

               using (SqlConnection con = new SqlConnection(cs))
               using (SqlCommand cmd = new SqlCommand(sql, con))
               {
                    cmd.CommandType = CommandType.Text;
                    cmd.Parameters.Add("@HBNNO", SqlDbType.Int).Value = hbnno;

                    con.Open();
                    using (SqlDataReader dr = cmd.ExecuteReader())
                    {
                         if (!dr.Read())
                              return new HotelBlockEmailInfo();

                         return new HotelBlockEmailInfo
                         {
                              ToEmail = dr["HBCEMAIL"] == DBNull.Value ? "" : Convert.ToString(dr["HBCEMAIL"]).Trim(),
                              HbcNo = dr["HBCNO"] == DBNull.Value ? "" : Convert.ToString(dr["HBCNO"]).Trim(),
                              HotelEmailHtml = dr["HTCBLKEMAILMESSAGE"] == DBNull.Value ? "" : Convert.ToString(dr["HTCBLKEMAILMESSAGE"])
                         };
                    }
               }
          }

