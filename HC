          /// <summary>
          /// Explicit RDLC binding using provided dataset names (kept for reference).
          /// </summary>
          private void BindToReport(string rdlcVirtualPath, List<string> datasetNames, DataSet data)
          {
               if (data == null || data.Tables.Count == 0)
                    throw new InvalidOperationException("Stored proc returned no result sets.");

               string rdlcPath = Server.MapPath(NormalizeRdlcPath(rdlcVirtualPath));
               if (!File.Exists(rdlcPath))
                    throw new FileNotFoundException("RDLC not found: " + rdlcPath);

               // 1) Read RDLC XML and remove white fills so Excel gridlines can show
               string xml = File.ReadAllText(rdlcPath);

               // common patterns inside <Style>…<BackgroundColor>White</BackgroundColor>…
               xml = Regex.Replace(xml,
                   @"<BackgroundColor>\s*(White|#FFFFFF|RGB\(\s*255\s*,\s*255\s*,\s*255\s*\))\s*</BackgroundColor>",
                   "<BackgroundColor>Transparent</BackgroundColor>",
                   RegexOptions.IgnoreCase);

               // optional: if *any* BackgroundColor is set, make it Transparent
               xml = Regex.Replace(xml, @"<BackgroundColor>.*?</BackgroundColor>",
                               "<BackgroundColor>Transparent</BackgroundColor>", RegexOptions.Singleline);

               rv.Reset();
               rv.ProcessingMode = ProcessingMode.Local;

               // 2) Load from the modified XML string
               using (var sr = new StringReader(xml))
                    rv.LocalReport.LoadReportDefinition(sr);

               // 3) Data sources
               rv.LocalReport.DataSources.Clear();
               for (int i = 0; i < data.Tables.Count; i++)
               {
                    string name = (i < datasetNames.Count && !string.IsNullOrWhiteSpace(datasetNames[i]))
                                  ? datasetNames[i]
                                  : (data.Tables[i].TableName ?? $"Table{i}");
                    rv.LocalReport.DataSources.Add(new ReportDataSource(name, data.Tables[i]));
               }

               rv.LocalReport.Refresh();
          }

          /// <summary>
          /// Smart binder: maps SP result tables to RDLC datasets by best column overlap; fills params.
          /// </summary>
          /// 
          private void BindToReportAuto(string rdlcVirtualPath, DataSet spResult, bool forExcel)
          {
               TraceLog($"ENTER BindToReportAuto | RDLC={rdlcVirtualPath} | Tables={spResult?.Tables.Count}", stage: "ENTER");

               if (spResult == null)
                    throw new InvalidOperationException("No DataSet returned from stored procedure.");
               if (spResult.Tables.Count == 0)
                    throw new InvalidOperationException("Stored proc returned no result sets.");

               // ---- Load RDLC and (optionally) clean background ----
               var rdlcPath = Server.MapPath(NormalizeRdlcPath(rdlcVirtualPath));
               var xml = File.ReadAllText(rdlcPath);

               // Make white cells transparent for nicer Excel output.
               //xml = Regex.Replace(
               //    xml,
               //    @"<BackgroundColor>\s*(White|#FFFFFF|RGB\(\s*255\s*,\s*255\s*,\s*255\s*\))\s*</BackgroundColor>",
               //    "<BackgroundColor>Transparent</BackgroundColor>",
               //    RegexOptions.IgnoreCase
               //);
               if (forExcel)
               {
                    xml = Regex.Replace(
                        xml,
                        @"<BackgroundColor>\s*(White|#FFFFFF|RGB\(\s*255\s*,\s*255\s*,\s*255\s*\))\s*</BackgroundColor>",
                        "<BackgroundColor>Transparent</BackgroundColor>",
                        RegexOptions.IgnoreCase
                    );
               }

               rv.Reset();
               rv.ProcessingMode = ProcessingMode.Local;
               using (var sr = new StringReader(xml))
                    rv.LocalReport.LoadReportDefinition(sr);

               rv.LocalReport.EnableHyperlinks = true;

               // ---- Parse RDLC to discover DataSets and their fields ----
               var x = XDocument.Parse(xml);
               var rdlNs = x.Root.Name.Namespace; // XNamespace

               var rdlcDs = x
                   .Descendants(rdlNs + "DataSet")
                   .Select(ds => new
                   {
                        Name = (string)ds.Attribute("Name"),
                        Fields = ds
                           .Descendants(rdlNs + "Field")
                           .Select(f => (string)f.Attribute("Name"))
                           .Where(n => !string.IsNullOrWhiteSpace(n))
                           .Select(n => n.Trim())
                           .ToHashSet(StringComparer.OrdinalIgnoreCase)
                   })
                   .Where(d => !string.IsNullOrWhiteSpace(d.Name))
                   .ToList();

               rv.LocalReport.DataSources.Clear();

               // ---- For EACH RDLC dataset, bind *something* with the SAME NAME ----
               foreach (var dsDef in rdlcDs)
               {
                    DataTable chosenTable = null;
                    int bestScore = -1;

                    // ✅ Fast path: if SP already returned a table with same name, prefer it
                    foreach (DataTable t in spResult.Tables)
                    {
                         if (!string.IsNullOrWhiteSpace(t.TableName) &&
                             string.Equals(t.TableName, dsDef.Name, StringComparison.OrdinalIgnoreCase))
                         {
                              chosenTable = t;
                              bestScore = int.MaxValue; // lock it in
                              break;
                         }
                    }

                    // Otherwise: best column overlap
                    if (chosenTable == null)
                    {
                         foreach (DataTable t in spResult.Tables)
                         {
                              int score = 0;
                              foreach (DataColumn c in t.Columns)
                              {
                                   if (dsDef.Fields.Contains(c.ColumnName))
                                        score++;
                              }

                              if (score > bestScore)
                              {
                                   bestScore = score;
                                   chosenTable = t;
                              }
                         }
                    }

                    // If we still didn't find anything, create a blank table so renderer is happy.
                    if (chosenTable == null)
                         chosenTable = new DataTable();

                    // ✅ IMPORTANT PERF FIX:
                    // Do NOT DataTable.Copy() here (huge memory/time for big reports).
                    // RDLC dataset name is matched by ReportDataSource.Name, not DataTable.TableName.
                    rv.LocalReport.DataSources.Add(new ReportDataSource(dsDef.Name, chosenTable));
               }

               // ❌ REMOVE/COMMENT THIS for big reports (it can bind extra tables and increase memory/time)
               // foreach (DataTable t in spResult.Tables)
               // {
               //     bool alreadyBound = rv.LocalReport.DataSources
               //         .Any(d => string.Equals(d.Name, t.TableName, StringComparison.OrdinalIgnoreCase));
               //
               //     if (!alreadyBound)
               //     {
               //         string dsName = string.IsNullOrWhiteSpace(t.TableName)
               //             ? "AutoData_" + Guid.NewGuid().ToString("N")
               //             : t.TableName;
               //
               //         rv.LocalReport.DataSources.Add(new ReportDataSource(dsName, t));
               //     }
               // }

               // ---- Fill ReportParameters for EVERY parameter in the RDLC ----
               var rdlParams = rv.LocalReport.GetParameters();
               if (rdlParams != null && rdlParams.Count > 0)
               {
                    var toSet = new List<ReportParameter>();

                    foreach (var pInfo in rdlParams)
                    {
                         string paramName = pInfo.Name;
                         string chosenValue = null;

                         // 1) Try to read from first row of any result table with same column
                         foreach (DataTable t in spResult.Tables)
                         {
                              if (t.Columns.Contains(paramName) && t.Rows.Count > 0)
                              {
                                   object raw = t.Rows[0][paramName];
                                   chosenValue = FormatForParam(raw, pInfo.DataType);
                                   if (!string.IsNullOrEmpty(chosenValue))
                                        break;
                              }
                         }

                         // 2) fallback QueryString
                         if (string.IsNullOrEmpty(chosenValue))
                         {
                              string qsVal = Request.QueryString[paramName];
                              if (!string.IsNullOrWhiteSpace(qsVal))
                                   chosenValue = qsVal.Trim();
                         }

                         // 3) fallback Session
                         if (string.IsNullOrEmpty(chosenValue) && Session[paramName] != null)
                              chosenValue = Convert.ToString(Session[paramName], CultureInfo.InvariantCulture);

                         //if (chosenValue == null)
                         //     chosenValue = "";
                         if (string.IsNullOrWhiteSpace(chosenValue))
                         {
                              switch (pInfo.DataType)
                              {
                                   case ParameterDataType.Integer: chosenValue = "0"; break;
                                   case ParameterDataType.Float: chosenValue = "0"; break;
                                   case ParameterDataType.Boolean: chosenValue = "False"; break;
                                   case ParameterDataType.DateTime: chosenValue = DateTime.Now.ToString("s", CultureInfo.InvariantCulture); break;
                                   default: chosenValue = ""; break;
                              }
                         }


                         toSet.Add(new ReportParameter(paramName, chosenValue));
                    }

                    rv.LocalReport.SetParameters(toSet);
               }

               rv.LocalReport.Refresh();
               TraceLog("EXIT BindToReportAuto", stage: "EXIT");
          }

          /// <summary>
          /// Formats an object into a ReportParameter string based on expected type.
          /// </summary>
          /// 

          private static string FormatForParam(object raw, ParameterDataType type)
          {
               if (raw == null || raw == DBNull.Value) return null;

               switch (type)
               {
                    case ParameterDataType.Integer:
                         {
                              // handles int/long/decimal/string
                              if (raw is int i) return i.ToString(CultureInfo.InvariantCulture);
                              if (raw is long l) return l.ToString(CultureInfo.InvariantCulture);
                              if (raw is decimal dec) return ((int)dec).ToString(CultureInfo.InvariantCulture);

                              var s = Convert.ToString(raw, CultureInfo.InvariantCulture)?.Trim();
                              if (int.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var iv))
                                   return iv.ToString(CultureInfo.InvariantCulture);
                              if (decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var dv))
                                   return ((int)dv).ToString(CultureInfo.InvariantCulture);

                              return null;
                         }

                    case ParameterDataType.Float:
                         {
                              if (raw is double d) return d.ToString(CultureInfo.InvariantCulture);
                              if (raw is float f) return f.ToString(CultureInfo.InvariantCulture);
                              if (raw is decimal dec) return dec.ToString(CultureInfo.InvariantCulture);

                              var s = Convert.ToString(raw, CultureInfo.InvariantCulture)?.Trim();
                              if (double.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var dv))
                                   return dv.ToString(CultureInfo.InvariantCulture);

                              return null;
                         }

                    case ParameterDataType.DateTime:
                         {
                              if (raw is DateTime dt) return dt.ToString("s", CultureInfo.InvariantCulture);
                              var s = Convert.ToString(raw, CultureInfo.InvariantCulture);
                              if (DateTime.TryParse(s, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var parsed))
                                   return parsed.ToString("s", CultureInfo.InvariantCulture);
                              return null;
                         }

                    case ParameterDataType.Boolean:
                         {
                              if (raw is bool b) return b ? "True" : "False";
                              var s = Convert.ToString(raw, CultureInfo.InvariantCulture);
                              if (string.Equals(s, "1") || string.Equals(s, "true", StringComparison.OrdinalIgnoreCase)) return "True";
                              if (string.Equals(s, "0") || string.Equals(s, "false", StringComparison.OrdinalIgnoreCase)) return "False";
                              return null;
                         }

                    default:
                         return Convert.ToString(raw, CultureInfo.InvariantCulture);
               }
          }

          private static string FormatForParamOld(object raw, ParameterDataType type)
          {
               if (raw == null || raw == DBNull.Value) return null;

               switch (type)
               {
                    case ParameterDataType.DateTime:
                         if (raw is DateTime dt) return dt.ToString("g", CultureInfo.CurrentCulture);
                         if (DateTime.TryParse(Convert.ToString(raw, CultureInfo.InvariantCulture),
                                               CultureInfo.InvariantCulture,
                                               DateTimeStyles.AssumeLocal, out var parsed))
                              return parsed.ToString("g", CultureInfo.CurrentCulture);
                         return null;

                    case ParameterDataType.Boolean:
                         if (raw is bool b) return b ? "True" : "False";
                         var s = Convert.ToString(raw, CultureInfo.InvariantCulture);
                         if (string.Equals(s, "1") || string.Equals(s, "true", StringComparison.OrdinalIgnoreCase)) return "True";
                         if (string.Equals(s, "0") || string.Equals(s, "false", StringComparison.OrdinalIgnoreCase)) return "False";
                         return null;

                    default:
                         return Convert.ToString(raw, CultureInfo.InvariantCulture);
               }
          }

          /// <summary>
          /// Renders current LocalReport to HTTP response with robust error logging and cookie token support.
          /// </summary>
          private void RenderToHttp(string format, string contentType, string downloadName, string deviceInfo = null, bool forceDownloadForPdf = false)
          {
               TraceLog($"ENTER RenderToHttp | format={format} | name={downloadName}", stage: "ENTER");

               // ✅ For long PDF runs
               Server.ScriptTimeout = 3600;

               Warning[] warnings;
               string[] streams;
               string mimeType, encoding, extension;

               // helper: log to App_Data/logs/report_errors.txt
               void LogLine(string stage, string message, Exception ex = null)
               {
                    try
                    {
                         string logDir = Server.MapPath("~/App_Data/logs");
                         Directory.CreateDirectory(logDir);

                         string logFile = Path.Combine(logDir, "report_errors.txt");

                         var stamp = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);
                         using (var sw = new StreamWriter(logFile, true))
                         {
                              sw.WriteLine("==== " + stamp + " ====");
                              sw.WriteLine("Stage: " + stage);
                              sw.WriteLine("Format: " + (format ?? ""));
                              sw.WriteLine("DownloadName: " + (downloadName ?? ""));

                              if (!string.IsNullOrWhiteSpace(message))
                                   sw.WriteLine("Message: " + message);

                              if (ex != null)
                              {
                                   sw.WriteLine("Exception: " + ex.GetType().FullName);
                                   sw.WriteLine("Error: " + ex.Message);
                                   sw.WriteLine("Stack: " + ex.StackTrace);
                              }

                              sw.WriteLine();
                         }
                    }
                    catch { }
               }

               // Base filename
               var safeName = string.IsNullOrWhiteSpace(downloadName) ? "Report" : downloadName.Trim();

               // Determine "PDF mode" early
               bool wantPdf =
                   string.Equals(format ?? "", "PDF", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(contentType ?? "", "application/pdf", StringComparison.OrdinalIgnoreCase) ||
                   safeName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

               // ============================================================
               // ✅ FAST PATH: PDF => stream to disk (avoid giant byte[] in RAM)
               // ============================================================

               if (wantPdf)
               {
                    if (!safeName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                         safeName = Path.ChangeExtension(safeName, ".pdf");

                    string tmpDir = Server.MapPath("~/App_Data/tmp");
                    Directory.CreateDirectory(tmpDir);

                    string baseName = "rpt_" + Guid.NewGuid().ToString("N");
                    var streamFiles = new List<string>();

                    try
                    {
                        // LogLine("RenderStart(PDF-Stream)", "Attempting LocalReport.Render(PDF) -> tmp streams");

                         int streamIndex = 0;

                         Stream CreateStream(string name, string ext, System.Text.Encoding enc, string mt, bool willSeek)
                         {
                              streamIndex++; // ✅ unique per call

                              string safeExt = string.IsNullOrWhiteSpace(ext) ? "pdf" : ext.TrimStart('.');
                              string safePart = string.IsNullOrWhiteSpace(name) ? "main" : name;

                              string path = Path.Combine(tmpDir, $"{baseName}_{safePart}_{streamIndex:D3}.{safeExt}");
                              streamFiles.Add(path);

                              // Extra safe for scanners/locks
                              for (int attempt = 1; attempt <= 5; attempt++)
                              {
                                   try
                                   {
                                        return new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.ReadWrite);
                                   }
                                   catch (IOException)
                                   {
                                        if (attempt == 5) throw;
                                        System.Threading.Thread.Sleep(80);
                                   }
                              }

                              // will never hit
                              return new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.ReadWrite);
                         }

                         rv.LocalReport.Render("PDF", deviceInfo ?? string.Empty, CreateStream, out warnings);

                         // pick the actual pdf stream file
                         string pdfPath = streamFiles
                                                 .Where(f => f.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                 .OrderByDescending(f => new FileInfo(f).Length)
                                                 .FirstOrDefault()
                                                 ?? streamFiles.FirstOrDefault();


                         if (string.IsNullOrWhiteSpace(pdfPath) || !File.Exists(pdfPath))
                              throw new InvalidOperationException("PDF stream file not created by renderer.");

                         //LogLine("RenderSuccess(PDF-Stream)", "PDF created: " + pdfPath + " | Size=" + new FileInfo(pdfPath).Length);

                         // Optional cookie back to JS
                         //var token = Request.Form["dlToken"];
                         //if (!string.IsNullOrEmpty(token))
                         //{
                         //     var cookie = new HttpCookie("fileDownloadToken", token) { Path = "/" };
                         //     Response.Cookies.Add(cookie);
                         //}

                         //Response.Clear();

                         //Response.Clear();
                         //Response.TrySkipIisCustomErrors = true;
                         //Response.Buffer = true;
                         //Response.BufferOutput = true;

                         //// ✅ Set cookie AFTER Clear (otherwise it can get wiped)
                         //var token = Request.Form["dlToken"];
                         //if (!string.IsNullOrEmpty(token))
                         //{
                         //     var cookie = new HttpCookie("fileDownloadToken", token)
                         //     {
                         //          Path = "/",
                         //          HttpOnly = false   // ✅ JS must read it
                         //     };
                         //     Response.Cookies.Add(cookie);
                         //}


                         //Response.ClearHeaders();
                         //Response.BufferOutput = false;


                         Response.Clear();
                         Response.ClearContent();
                         Response.ClearHeaders();
                         Response.TrySkipIisCustomErrors = true;
                         Response.Buffer = false;
                         Response.BufferOutput = false;

                         // ✅ Set cookie AFTER all clears and BEFORE writing any bytes
                         var token = Request.Form["dlToken"];
                         if (!string.IsNullOrEmpty(token))
                         {
                              var cookie = new HttpCookie("fileDownloadToken", token)
                              {
                                   Path = "/",
                                   HttpOnly = false,
                                   Secure = Request.IsSecureConnection,
                                   SameSite = SameSiteMode.Lax
                              };
                              Response.Cookies.Add(cookie);
                         }


                         Response.ContentType = "application/pdf";
                         Response.AddHeader("X-Content-Type-Options", "nosniff");

                         string dispositionType = forceDownloadForPdf ? "attachment" : "inline";
                         string headerFilename = safeName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                             ? safeName
                             : safeName + ".pdf";

                         Response.AddHeader("Content-Disposition",
                             $"{dispositionType}; filename=\"{headerFilename}\"");

                         // ✅ Send file by streaming with permissive share + retry
                         const int BUF = 64 * 1024;

                         for (int attempt = 1; attempt <= 40; attempt++)
                         {
                              try
                              {
                                   using (var fs = new FileStream(
                                       pdfPath,
                                       FileMode.Open,
                                       FileAccess.Read,
                                       FileShare.ReadWrite | FileShare.Delete,
                                       BUF,
                                       FileOptions.SequentialScan))
                                   {
                                        fs.CopyTo(Response.OutputStream, BUF);
                                   }
                                   break; // ✅ success
                              }
                              catch (IOException)
                              {
                                   if (attempt == 40) throw;      // last try -> bubble up
                                   System.Threading.Thread.Sleep(125);
                              }
                         }

                         Response.Flush();
                         HttpContext.Current.ApplicationInstance?.CompleteRequest();
                         return;


                         //LogLine("SendSuccess(PDF-Stream)", "TransmitFile OK.");
                         //HttpContext.Current.ApplicationInstance?.CompleteRequest();

                         // ✅ NOTE: DO NOT delete here (TransmitFile may keep it locked).
                         // Cleanup old tmp files separately (I'll give helper if you want).
                         return;
                    }
                    catch (Exception ex)
                    {
                         Exception root = ex;
                         while (root.InnerException != null) root = root.InnerException;

                         LogLine("PDF-Stream-Fail", "Exception in PDF stream path.", root);

                         Response.Clear();
                         Response.TrySkipIisCustomErrors = true;
                         Response.StatusCode = 500;
                         Response.ContentType = "text/plain";
                         Response.Write(root.Message);
                         HttpContext.Current.ApplicationInstance?.CompleteRequest();
                         return;
                    }
               }

               // ============================================================
               // Normal path: non-PDF => keep existing byte[] render approach
               // ============================================================
               byte[] bytes;

               try
               {
                    LogLine("RenderStart", "Attempting LocalReport.Render(...)");

                    bytes = rv.LocalReport.Render(
                        format: string.IsNullOrWhiteSpace(format) ? "PDF" : format,
                        deviceInfo: deviceInfo ?? string.Empty,
                        mimeType: out mimeType,
                        encoding: out encoding,
                        fileNameExtension: out extension,
                        streams: out streams,
                        warnings: out warnings
                    );

                    LogLine("RenderSuccess", "Render complete. Bytes=" + (bytes?.Length ?? 0));
               }
               catch (Exception ex)
               {
                    Exception root = ex;
                    while (root.InnerException != null) root = root.InnerException;

                    LogLine("RenderFail", "Render threw.", root);

                    Response.Clear();
                    Response.TrySkipIisCustomErrors = true;
                    Response.StatusCode = 500;
                    Response.ContentType = "text/plain";
                    Response.Write(root.Message);
                    HttpContext.Current.ApplicationInstance?.CompleteRequest();
                    return;
               }

               try
               {
                    //var token = Request.Form["dlToken"];
                    //if (!string.IsNullOrEmpty(token))
                    //{
                    //     var cookie = new HttpCookie("fileDownloadToken", token) { Path = "/" };
                    //     Response.Cookies.Add(cookie);
                    //}

                    //if (string.IsNullOrEmpty(Path.GetExtension(safeName)) && !string.IsNullOrEmpty(extension))
                    //     safeName += "." + extension.TrimStart('.');

                    var effectiveMime = string.IsNullOrWhiteSpace(contentType) ? mimeType : contentType;

                    //Response.Clear();
                    Response.Clear();
                    Response.ClearContent();
                    Response.ClearHeaders();
                    Response.TrySkipIisCustomErrors = true;
                    Response.Buffer = true;
                    Response.BufferOutput = true;

                    // ✅ cookie AFTER clears
                    var token = Request.Form["dlToken"];
                    if (!string.IsNullOrEmpty(token))
                    {
                         var cookie = new HttpCookie("fileDownloadToken", token)
                         {
                              Path = "/",
                              HttpOnly = false,
                              Secure = Request.IsSecureConnection,
                              SameSite = SameSiteMode.Lax
                         };
                         Response.Cookies.Add(cookie);
                    }

                    Response.TrySkipIisCustomErrors = true;
                    Response.Buffer = true;
                    Response.BufferOutput = true;

                    Response.Cache.SetCacheability(HttpCacheability.NoCache);
                    Response.Cache.SetNoStore();
                    Response.Cache.SetExpires(DateTime.UtcNow.AddMinutes(-1));

                    Response.ContentType = effectiveMime;

                    // non-PDF always download
                    Response.AddHeader(
                        "Content-Disposition",
                        $"attachment; filename=\"{safeName.Replace("\"", string.Empty)}\"; filename*=UTF-8''{Uri.EscapeDataString(safeName.Replace("\"", string.Empty))}"
                    );

                    Response.BinaryWrite(bytes);
                    Response.Flush();

                    LogLine("SendSuccess", "Bytes sent to client OK.");
                    HttpContext.Current.ApplicationInstance?.CompleteRequest();
               }
               catch (Exception ex2)
               {
                    Exception root2 = ex2;
                    while (root2.InnerException != null) root2 = root2.InnerException;

                    LogLine("SendFail", "Failed while writing Response.", root2);

                    Response.Clear();
                    Response.TrySkipIisCustomErrors = true;
                    Response.StatusCode = 500;
                    Response.ContentType = "text/plain";
                    Response.Write(root2.Message);
                    HttpContext.Current.ApplicationInstance?.CompleteRequest();
                    return;
               }

               TraceLog("EXIT RenderToHttp", stage: "EXIT");
          }

