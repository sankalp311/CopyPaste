[HttpPost]
public async Task<IActionResult> Process([FromBody] Ht152ProcessRequestVm req)
{
	req ??= new Ht152ProcessRequestVm();

	var EMCNO = HttpContext.Session.GetString("EventId") ?? "";
	var USNNO = HttpContext.Session.GetString("USNNO") ?? "";
	var currentDate = DateTime.Now;
	Guid uniqueId = Guid.NewGuid();

	if (req.HotelId <= 0)
		return BadRequest("Hotel required");

	var actions = new List<string>();
	if (req.ChkNew) actions.Add("New");
	if (req.ChkChanged) actions.Add("Changed");
	if (req.ChkCanceled) actions.Add("Canceled");

	if (actions.Count == 0)
		return BadRequest("Select at least one report type");

	// Send multiHTNNO only when there is a true merge case
	var normalizedMultiHTNNO = NormalizeMultiHTNNO(req.MultiHTNNO, req.HotelId);

	cls_HotelInfo obj = new cls_HotelInfo
	{
		HTNNO = req.HotelId
	};

	Hotel_Import_RFPID obj_root = new Hotel_Import_RFPID();
	HotelApiDetail obj_details = new HotelApiDetail();

	var hotelDetails = await _eHRepo.GetHotelInfoList(obj);
	string RFPID = hotelDetails?.FirstOrDefault()?.HTCRFP_ID ?? string.Empty;

	var config = new ConfigurationBuilder()
	    .SetBasePath(Directory.GetCurrentDirectory())
	    .AddJsonFile("appsettings.json")
	    .Build();
	var ReportTypeName = req.ReportTypeName;
	var url = Convert.ToString(config["RoomingHotelImportUrl"]);
	var token = Convert.ToString(config["RoomingHotelToken"]);
	var email = Convert.ToString(config["HotelEmail"]);
	var password = Convert.ToString(config["HotelPassword"]);

	//if (!string.IsNullOrWhiteSpace(RFPID))
	//{
	//	obj_root = await _eHRepo.callurl1(url + RFPID, token, email, password);

	//	if (obj_root != null && obj_root.Response != null)
	//	{
	//		obj_details.HTNNO = req.HotelId;
	//		obj_details.EMCNOCode = EMCNO;
	//		obj_details.RFPID = obj_root.Response.RFPID;
	//		obj_details.HRCEmail = obj_root.Response.RoomingListCoordinatorEmail;
	//		obj_details.HotelSalesManagerEmail = obj_root.Response.HotelSalesManagerEmail;
	//		obj_details.Name = obj_root.Response.PropertyRoomListCoordinatorName;
	//		obj_details.Phone = obj_root.Response.PropertyRoomListCoordinatorPhone;

	//		await _eRLRepo.InsertUpdateHT152Hotel(obj_details);
	//	}
	//}

	string ipAddress =
	    HttpContext?.Request?.Headers["X-Forwarded-For"].FirstOrDefault()
	    ?? HttpContext?.Connection?.RemoteIpAddress?.ToString()
	    ?? string.Empty;

	if (!string.IsNullOrWhiteSpace(ipAddress))
	{
		ipAddress = ipAddress.Split(',')[0].Trim();
	}

	var generated = new List<Ht152GeneratedItemVm>();

	int resolvedEmnno = 0;
	string htcacro = "";

	foreach (var action in actions)
	{
		var apiReq = new ApiHt152ReportDataRequest
		{
			Action = action,
			EMCNO = EMCNO,
			EMNNO = resolvedEmnno,
			HTNNO = req.HotelId,
			REPORTID = req.REPORTID,
			USER = USNNO,
			CurrentDate = currentDate,

			FromDate = req.FromDate,
			ToDate = req.ToDate,
			FrmHour = req.FrmHour,
			FrmMin = req.FrmMin,
			FrmAmPm = req.FrmAmPm,
			ToHour = req.ToHour,
			ToMin = req.ToMin,
			ToAmPm = req.ToAmPm,
			UNIQUEId = uniqueId,
			IPAddress = ipAddress,

			// New param
			MultiHTNNO = normalizedMultiHTNNO
		};

		var apiResp = await _repo.GetReportData(apiReq);
		if (apiResp == null)
			continue;

		resolvedEmnno = apiResp.EMNNO;
		htcacro = apiResp.HTCACRO;

		var dt = ToDataTable(apiResp.Rows);

		var (rdlcName, dsName) = action switch
		{
			"New" => ("HT152_New.rdlc", "NewDataSet"),
			"Changed" => ("HT152_Changed.rdlc", "ChangedDataSet"),
			"Canceled" => ("HT152_Canceled.rdlc", "CanceledDataSet"),
			_ => throw new ArgumentOutOfRangeException()
		};

		var rdlcPath = Path.Combine(_env.ContentRootPath, "Forms", "Reports", rdlcName);

		var fromDt = BuildDateTime(req.FromDate, req.FrmHour, req.FrmMin, req.FrmAmPm);
		var toDt = BuildDateTime(req.ToDate, req.ToHour, req.ToMin, req.ToAmPm);

		// If you want PDF render later, uncomment and use this:
		// var pdfBytes = RenderPdf_AspNetCoreReporting(
		//     rdlcPath,
		//     dsName,
		//     dt,
		//     new Dictionary<string, string>
		//     {
		//         ["dateFrom"] = fromDt.ToString("MM/dd/yyyy HH:mm"),
		//         ["dateTo"] = toDt.ToString("MM/dd/yyyy HH:mm")
		//     });

		var stamp = currentDate.ToString("MM-dd-yyyy HH-mm-ss");
		var fileName = $"{EMCNO}_{htcacro}_{action}_{stamp} {req.ToAmPm}.pdf";
		var relUrl = $"/Forms/Reports/ReportsFolder/{fileName}";

		var folder = Path.Combine(_env.WebRootPath, "Forms", "Reports", "ReportsFolder");
		Directory.CreateDirectory(folder);

		var physicalPath = Path.Combine(folder, fileName);

		// await System.IO.File.WriteAllBytesAsync(physicalPath, pdfBytes);

		await _repo.InsertReportList(new ApiInsertReportListRequest
		{
			USNNO = USNNO,
			EMNNO = resolvedEmnno,
			HTNNO = req.HotelId,
			RPTURL = relUrl,
			RPTTYPE = action,
			CURRENTDATE = currentDate,
			UNIQUEId = uniqueId,
			MultiHTNNO = normalizedMultiHTNNO
		});

		generated.Add(new Ht152GeneratedItemVm
		{
			Type = action,
			Url = relUrl,
			FileName = fileName
		});
	}

	var history = await _repo.GetExportReportList(new ApiExportHistoryRequest
	{
		USNNO = USNNO,
		EMNNO = resolvedEmnno,
		HTNNO = req.HotelId
	});

	return Ok(new
	{
		generated,
		history,
		multiHTNNO = normalizedMultiHTNNO
	});
}
