          /// <summary>
          /// Page entry. Validates Report gate and session; decides whether to show filters or run report.
          /// </summary>
          protected void Page_Load(object sender, EventArgs e)
          {
               Server.ScriptTimeout = 3600;   // seconds

               // Make sure token ?t=... is decoded (if present)
               InitSecureQueryFromToken();

               // If a token was supplied but we failed to resolve it,
               // show a clear error and stop.
               var rawToken = (Request.QueryString["t"] ?? "").Trim();
               _secureToken = rawToken;
               if (!string.IsNullOrEmpty(rawToken) && _secureQs == null)
               {
                    // This hits when the token does NOT exist in DB,
                    // is expired, or was manually tampered with.
                    WriteAndEnd("For security reasons, this report link is no longer active or appears incorrect.");
                    return;
               }

             

               if (IsPostBack) return;

               // honor your existing ?Report=YES guard – but read via Q()
               if (!"YES".Equals((Q("Report") ?? "").Trim(), StringComparison.OrdinalIgnoreCase))
                    return;

               string cs = ConfigurationManager.ConnectionStrings["ICMReportConnectionString"].ConnectionString;
               string session = (Q("sessionid") ?? "").Trim();

               string emnnoFromQs = (Q("EMNNO") ?? "").Trim();
               string v = (Q("V") ?? "").Trim();          // e.g. P / E
               string rptStr = (Q("RptId") ?? "").Trim();      // string version
               string rawFilter = (Q("Filter") ?? "").Trim();


               // ✅ SECURITY GUARD: basic input cleaning on key params
               //if (!IsInputClean(session))
               //{
               //     TraceLog("Blocked suspicious request: SUSessionID / Report failed IsInputClean.", null, "SECURITY");

               //     Response.Clear();
               //     Response.Redirect("~/Error.html", false);
               //     HttpContext.Current.ApplicationInstance.CompleteRequest();
               //     return;
               //}

               TraceLog(
                   $"ENTER Page_Load | RptId={rptStr} | V={v} | Filter={rawFilter} | sessionid(len)={(session ?? "").Length}",
                   stage: "ENTER"
               );

               if (!ValidateSessionId(session, cs))
               {
                    WriteAndEnd("Invalid session!");
                    return;
               }

               if (!string.IsNullOrEmpty(emnnoFromQs))
                    Session["LoginEmnno"] = emnnoFromQs;   // used by filter dropdowns

               // decode once (for safety; Filter might be URL-encoded by JS)
               string decodedFilter = System.Web.HttpUtility.UrlDecode(rawFilter) ?? string.Empty;

               // parse int RptId for DB calls
               int rptId;
               int.TryParse(rptStr, out rptId);

               // 1) explicit ON/OFF tokens (0,1,N,Y,1=1)
               bool? explicitOverride = ParseFilterOverride(decodedFilter);

               // 2) does this look like a Crystal/RDLC expression?
               bool filterIsExpression = LooksLikeExpression(decodedFilter);

               // 3) final decision:
               //    - if explicit 0/1/N/Y/1=1 -> use that
               //    - else if it *looks* like an expression -> force filter UI ON
               //    - else fall back to DB flag
               bool showFilter;
               if (explicitOverride.HasValue)
               {
                    showFilter = explicitOverride.Value;
               }
               else if (filterIsExpression)
               {
                    // e.g. {EVENTS.EMDTEND} >= DateTime(param1) ...
                    showFilter = true;
               }
               else
               {
                    showFilter = IsFilterEnabledInDb(cs, rptId, v);
               }
               showFilter = IsFilterEnabledInDb(cs, rptId, v);
               if (showFilter)
               {
                    pnlFilters.Visible = true;
                    BuildFilterForm(cs, rptStr);   // pass string key for REPORT_PARAMETERS
                    TraceLog("Filter UI displayed.", stage: "INFO");
               }
               else
               {
                    // Run immediately (PDF/Excel/Preview decided by V)
                    TraceLog($"Running report immediately | V={v}", stage: "INFO");
                    RunReport(download: true);
               }

                                                                                                                                                   TraceLog("EXIT Page_Load", stage: "EXIT");
          }


          /// <summary>
          /// Interprets explicit filter override tokens. Returns null if not an override.
          /// </summary>
          static bool? ParseFilterOverride(string filter)
          {
               if (string.IsNullOrWhiteSpace(filter)) return null;

               // Explicit OFF
               if (filter.Equals("0", StringComparison.OrdinalIgnoreCase) ||
                   filter.Equals("N", StringComparison.OrdinalIgnoreCase))
                    return false;

               // Explicit ON
               if (filter.Equals("1", StringComparison.OrdinalIgnoreCase) ||
                   filter.Equals("Y", StringComparison.OrdinalIgnoreCase) ||
                   filter.Equals("1=1", StringComparison.OrdinalIgnoreCase))
                    return true;

               // Not an explicit override token
               return null;
          }

          /// <summary>
          /// Heuristic: detects if a string resembles a filter expression.
          /// </summary>
          static bool LooksLikeExpression(string s)
          {
               if (string.IsNullOrWhiteSpace(s)) return false;

               // Heuristics for “real” filter expressions (Crystal/RDLC style)
               return s.IndexOf('{') >= 0 ||
                      s.IndexOf("DateTime(", StringComparison.OrdinalIgnoreCase) >= 0 ||
                      s.IndexOf('=') >= 0;  // e.g., "Field = Value"
          }

          /// <summary>
          /// Checks DB flag to decide if Filter UI should be enabled for a given RptId and viewer.
          /// </summary>
          static bool IsFilterEnabledInDb(string cs, int rptId, string viewer)
          {
               if (rptId <= 0) return false;

               using (var con = new SqlConnection(cs))
               using (var cmd = new SqlCommand(@"
        SELECT TOP(1) EnableFilter
        FROM icm.dbo.ReportFilterControl WITH (READCOMMITTED)
        WHERE RptId = @RptId
          AND Active = 1
         
        ORDER BY CASE WHEN Viewer = @Viewer THEN 0 ELSE 1 END;", con))
               {
                    cmd.Parameters.Add("@RptId", SqlDbType.Int).Value = rptId;
                    cmd.Parameters.Add("@Viewer", SqlDbType.Char, 1).Value =
                        string.IsNullOrWhiteSpace(viewer) ? (object)DBNull.Value : viewer.Substring(0, 1);

                    con.Open();
                    var o = cmd.ExecuteScalar();
                    return o != null && Convert.ToBoolean(o);
               }
          }

