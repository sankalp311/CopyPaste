          #region ===== Page Load ===================================================================

          protected void Page_Load(object sender, EventArgs e)
          {
               Server.ScriptTimeout = 3600;

               InitSecureQueryFromToken();

               string rawToken = (Request.QueryString["t"] ?? Convert.ToString(RouteData.Values["t"]) ?? "").Trim();
               _secureToken = rawToken;

               // token was supplied but could not be resolved
               if (!string.IsNullOrEmpty(rawToken) && _secureQs == null)
               {
                    WriteAndEnd("For security reasons, this Room Block Confirmation link is no longer active or appears incorrect.");
                    return;
               }

               if (IsPostBack) return;

               ProcessRequest();
          }

          #endregion

          #region ===== Main Flow ===================================================================

          private void ProcessRequest()
          {
               string cs = ConfigurationManager.ConnectionStrings["ICMReportConnectionString"].ConnectionString;

               try
               {
                    string type = (Q("Type") ?? "").Trim();
                    string sessionId = FirstNonEmpty(Q("SUSessionID"), Q("sessionid")).Trim();
                    string blockNo = (Q("BlockNo") ?? "").Trim();
                    string emnno = (Q("EMNNO") ?? "").Trim();
                    string emailFlag = (Q("Email") ?? "").Trim();

                    TraceLog("ENTER ProcessRequest | Type=" + type + " | EMNNO=" + emnno + " | BlockNo=" + blockNo + " | Email=" + emailFlag, null, "ENTER");

                    // Validate query values before going ahead
                    if (!"Block".Equals(type, StringComparison.OrdinalIgnoreCase))
                    {
                         WriteAndEnd("Invalid Type. Expected Type=Block.");
                         return;
                    }

                    if (string.IsNullOrWhiteSpace(sessionId))
                    {
                         WriteAndEnd("Missing session.");
                         return;
                    }

                    if (!ValidateSessionId(sessionId, cs))
                    {
                         WriteAndEnd("Invalid session!");
                         return;
                    }

                    int emnnoInt;
                    if (!int.TryParse(emnno, out emnnoInt) || emnnoInt <= 0)
                    {
                         WriteAndEnd("Invalid EMNNO.");
                         return;
                    }

                    int hbnno;
                    if (!int.TryParse(blockNo, out hbnno) || hbnno <= 0)
                    {
                         WriteAndEnd("Invalid BlockNo/HBNNO.");
                         return;
                    }

                    DataSet ds = GetDataFromSp(cs, emnnoInt, hbnno);

                    if (ds == null || ds.Tables.Count == 0)
                    {
                         WriteAndEnd("No data returned from stored procedure.");
                         return;
                    }

                    if (!HasAnyRows(ds))
                    {
                         WriteAndEnd("No data found for the supplied EMNNO and BlockNo.");
                         return;
                    }

                    string pdfFileName = "RoomBlockConfirmation_" + emnnoInt + "_" + hbnno + ".pdf";
                    byte[] pdfBytes = BuildPdfBytes(ds);

                    if (pdfBytes == null || pdfBytes.Length == 0)
                    {
                         WriteAndEnd("Failed to generate PDF.");
                         return;
                    }

                    // If Email=Yes then send the same PDF first
                    if (IsYes(emailFlag))
                    {
                         SendPdfByEmail(
                             pdfBytes,
                             pdfFileName,
                             HARDCODED_TO_EMAIL,
                             "Room Block Confirmation - EMNNO " + emnnoInt + " | BlockNo " + hbnno,
                             "Please find attached the Room Block Confirmation PDF."
                         );

                         TraceLog("Email sent successfully to hardcoded recipient.", null, "EMAIL");
                    }

                    // Current behavior: render PDF inline even if Email=Yes
                    // If you want email-only behavior, replace below line with WriteAndEnd("Email sent successfully.");
                    StreamPdfInline(pdfBytes, pdfFileName);

                    TraceLog("EXIT ProcessRequest", null, "EXIT");
               }
               catch (Exception ex)
               {
                    Exception root = GetRootException(ex);
                    TraceLog("ProcessRequest ERROR", root, "ERROR");
                    WriteAndEnd(root.Message);
               }
          }

          #endregion

          #region ===== Data Fetch ===================================================================

          private DataSet GetDataFromSp(string cs, int emnno, int hbnno)
          {
               TraceLog("ENTER GetDataFromSp | EMNNO=" + emnno + " | HBNNO=" + hbnno, null, "ENTER");

               DataSet ds = new DataSet();

               using (SqlConnection con = new SqlConnection(cs))
               using (SqlCommand cmd = new SqlCommand(SP_NAME, con))
               {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandTimeout = 3600;

                    cmd.Parameters.Add("@EMNNO", SqlDbType.Int).Value = emnno;
                    cmd.Parameters.Add("@HBNNO", SqlDbType.Int).Value = hbnno;

                    using (SqlDataAdapter da = new SqlDataAdapter(cmd))
                    {
                         da.Fill(ds);
                    }
               }

               TraceLog("EXIT GetDataFromSp | Tables=" + ds.Tables.Count, null, "EXIT");
               return ds;
          }

          #endregion

          #region ===== PDF Build ====================================================================

          private byte[] BuildPdfBytes(DataSet spResult)
          {
               if (spResult == null)
                    throw new InvalidOperationException("No dataset returned.");

               if (spResult.Tables.Count == 0)
                    throw new InvalidOperationException("Stored procedure returned no result sets.");

               if (spResult.Tables[0].Rows.Count == 0)
                    throw new InvalidOperationException("No rows returned for report.");

               string rdlcPath = Server.MapPath(NormalizeRdlcPath(RDLC_VIRTUAL_PATH));
               if (!File.Exists(rdlcPath))
                    throw new FileNotFoundException("RDLC not found: " + rdlcPath);

               BindRoomBlockReport(rdlcPath, spResult.Tables[0]);

               string mimeType;
               string encoding;
               string extension;
               string[] streams;
               Warning[] warnings;

               string deviceInfo = @"<DeviceInfo>
  <OutputFormat>PDF</OutputFormat>
  <PageWidth>8.5in</PageWidth>
  <PageHeight>11in</PageHeight>
  <MarginTop>0.25in</MarginTop>
  <MarginLeft>0.25in</MarginLeft>
  <MarginRight>0.25in</MarginRight>
  <MarginBottom>0.25in</MarginBottom>
</DeviceInfo>";

               byte[] bytes = rv.LocalReport.Render(
                   "PDF",
                   deviceInfo,
                   out mimeType,
                   out encoding,
                   out extension,
                   out streams,
                   out warnings
               );

               return bytes;
          }


          private void BindRoomBlockReport(string rdlcPhysicalPath, DataTable dt)
          {
               if (dt == null)
                    throw new InvalidOperationException("DataTable is null.");

               string xml = File.ReadAllText(rdlcPhysicalPath);

               rv.Reset();
               rv.ProcessingMode = ProcessingMode.Local;

               using (StringReader sr = new StringReader(xml))
               {
                    rv.LocalReport.LoadReportDefinition(sr);
                    rv.LocalReport.EnableHyperlinks = true;
               }

               rv.LocalReport.DataSources.Clear();

               // Bind exactly to dataset name from dsConfirmation.xsd / RDLC
               rv.LocalReport.DataSources.Add(
                   new ReportDataSource("DS_TTSbBk112", dt)
               );

               rv.LocalReport.Refresh();
          }


          private void BindToReportAuto(string rdlcPhysicalPath, DataSet spResult)
          {
               TraceLog("ENTER BindToReportAuto | RDLC=" + rdlcPhysicalPath + " | Tables=" + spResult.Tables.Count, null, "ENTER");

               string xml = File.ReadAllText(rdlcPhysicalPath);

               rv.Reset();
               rv.ProcessingMode = ProcessingMode.Local;

               using (StringReader sr = new StringReader(xml))
               {
                    rv.LocalReport.LoadReportDefinition(sr);
               }

               rv.LocalReport.EnableHyperlinks = true;
               rv.LocalReport.DataSources.Clear();

               XDocument x = XDocument.Parse(xml);
               XNamespace ns = x.Root.Name.Namespace;

               var rdlcDs = x.Descendants(ns + "DataSet")
                             .Select(ds => new
                             {
                                  Name = (string)ds.Attribute("Name"),
                                  Fields = ds.Descendants(ns + "Field")
                                            .Select(f => (string)f.Attribute("Name"))
                                            .Where(n => !string.IsNullOrWhiteSpace(n))
                                            .Select(n => n.Trim())
                                            .ToList()
                             })
                             .Where(d => !string.IsNullOrWhiteSpace(d.Name))
                             .ToList();

               foreach (var dsDef in rdlcDs)
               {
                    DataTable chosenTable = null;
                    int bestScore = -1;

                    // 1) exact table-name match
                    foreach (DataTable t in spResult.Tables)
                    {
                         if (!string.IsNullOrWhiteSpace(t.TableName) &&
                             string.Equals(t.TableName, dsDef.Name, StringComparison.OrdinalIgnoreCase))
                         {
                              chosenTable = t;
                              bestScore = int.MaxValue;
                              break;
                         }
                    }

                    // 2) best column-overlap match
                    if (chosenTable == null)
                    {
                         foreach (DataTable t in spResult.Tables)
                         {
                              int score = 0;

                              foreach (DataColumn c in t.Columns)
                              {
                                   if (dsDef.Fields.Any(f => f.Equals(c.ColumnName, StringComparison.OrdinalIgnoreCase)))
                                        score++;
                              }

                              if (score > bestScore)
                              {
                                   bestScore = score;
                                   chosenTable = t;
                              }
                         }
                    }

                    if (chosenTable == null)
                         chosenTable = new DataTable();

                    rv.LocalReport.DataSources.Add(new ReportDataSource(dsDef.Name, chosenTable));
               }

               // Auto-set report parameters if any
               var reportParams = rv.LocalReport.GetParameters();
               if (reportParams != null && reportParams.Count > 0)
               {
                    List<ReportParameter> toSet = new List<ReportParameter>();

                    foreach (ReportParameterInfo pInfo in reportParams)
                    {
                         string chosenValue = null;

                         // Try first row from any table having same column name
                         foreach (DataTable t in spResult.Tables)
                         {
                              if (t.Columns.Contains(pInfo.Name) && t.Rows.Count > 0)
                              {
                                   object raw = t.Rows[0][pInfo.Name];
                                   chosenValue = FormatForParam(raw, pInfo.DataType);

                                   if (!string.IsNullOrWhiteSpace(chosenValue))
                                        break;
                              }
                         }

                         // fallback to querystring
                         if (string.IsNullOrWhiteSpace(chosenValue))
                         {
                              string qv = Q(pInfo.Name);
                              if (!string.IsNullOrWhiteSpace(qv))
                                   chosenValue = qv.Trim();
                         }

                         if (string.IsNullOrWhiteSpace(chosenValue))
                         {
                              switch (pInfo.DataType)
                              {
                                   case ParameterDataType.Integer:
                                        chosenValue = "0";
                                        break;
                                   case ParameterDataType.Float:
                                        chosenValue = "0";
                                        break;
                                   case ParameterDataType.Boolean:
                                        chosenValue = "False";
                                        break;
                                   case ParameterDataType.DateTime:
                                        chosenValue = DateTime.Now.ToString("s", CultureInfo.InvariantCulture);
                                        break;
                                   default:
                                        chosenValue = "";
                                        break;
                              }
                         }

                         toSet.Add(new ReportParameter(pInfo.Name, chosenValue));
                    }

                    rv.LocalReport.SetParameters(toSet);
               }

               rv.LocalReport.Refresh();

               TraceLog("EXIT BindToReportAuto", null, "EXIT");
          }

          private static string FormatForParam(object raw, ParameterDataType type)
          {
               if (raw == null || raw == DBNull.Value) return null;

               switch (type)
               {
                    case ParameterDataType.Integer:
                         {
                              int i;
                              if (int.TryParse(Convert.ToString(raw, CultureInfo.InvariantCulture), out i))
                                   return i.ToString(CultureInfo.InvariantCulture);
                              return null;
                         }

                    case ParameterDataType.Float:
                         {
                              double d;
                              if (double.TryParse(Convert.ToString(raw, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out d))
                                   return d.ToString(CultureInfo.InvariantCulture);
                              return null;
                         }

                    case ParameterDataType.DateTime:
                         {
                              DateTime dt;
                              if (raw is DateTime)
                                   return ((DateTime)raw).ToString("s", CultureInfo.InvariantCulture);

                              if (DateTime.TryParse(Convert.ToString(raw, CultureInfo.InvariantCulture),
                                  CultureInfo.InvariantCulture,
                                  DateTimeStyles.AssumeLocal,
                                  out dt))
                              {
                                   return dt.ToString("s", CultureInfo.InvariantCulture);
                              }

                              return null;
                         }

                    case ParameterDataType.Boolean:
                         {
                              string s = Convert.ToString(raw, CultureInfo.InvariantCulture);
                              if (string.Equals(s, "1") || string.Equals(s, "true", StringComparison.OrdinalIgnoreCase))
                                   return "True";
                              if (string.Equals(s, "0") || string.Equals(s, "false", StringComparison.OrdinalIgnoreCase))
                                   return "False";
                              return null;
                         }

                    default:
                         return Convert.ToString(raw, CultureInfo.InvariantCulture);
               }
          }

