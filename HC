CREATE PROCEDURE sp_GetHotelExportReports_RDLC
    @Runtime DATETIME
AS
BEGIN
    SET NOCOUNT ON;
    
    SELECT 
        HER.RSNNO,
        ISNULL(RHC.ConfirmationText, '') AS Confirmation
    FROM [ICM_Report_Exports_Core_22Dec].[dbo].[HOTEL_EXPORT_REPORTS] AS HER
    LEFT JOIN RoomingHotelConfirmation RHC 
        ON RHC.RSNNO = HER.RSNNO 
        AND RHC.RunTime = @Runtime
    WHERE 
        HER.EXDT_RUNTIME = @Runtime 
        AND HER.EXC_REPORT_TYPE IN ('A', 'C', 'X') -- Using IN clause for multiple values
    ORDER BY HER.RSNNO DESC;
END



