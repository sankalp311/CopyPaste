    LEFT OUTER JOIN REGUSER WITH (NOLOCK) ON REGMST.RGNNO = REGUSER.RGNNO        
    INNER JOIN CATEGORY ON REGMST.CMNNO = CATEGORY.CMNNO        
    INNER JOIN RESERVATIONS RES WITH (NOLOCK) ON REGMST.RGNNO = RES.RGNNO        
    LEFT OUTER JOIN ACTMST WITH (NOLOCK) ON RES.RSNNO = ACTMST.RSNNO        
    LEFT OUTER JOIN HOTELROOMBLOCKS ON RES.HBNNO = HOTELROOMBLOCKS.HBNNO        
    LEFT OUTER JOIN RESNIGHTS ON RES.RSNNO = RESNIGHTS.RSNNO        
    INNER JOIN HOTEL ON RES.HTNNO = HOTEL.HTNNO        
    INNER JOIN ROOMCATEGORIES ON RES.RCNNO = ROOMCATEGORIES.RCNNO        
    INNER JOIN ROOMTYPES ON RES.RTNNO = ROOMTYPES.RTNNO        
    LEFT OUTER JOIN AFFILIATE2 ON REGUSER.RUCREPRESENTING = AFFILIATE2.AF2CNO        
    CROSS APPLY dbo.fn_GetResMates(RES.RSNNO) AS MATES        
    WHERE EVENTS.EMNNO = @EMNNO        
      AND (CATEGORY.CMNNO = @CMNNO OR @CMNNO IS NULL)        
      AND (HOTEL.HTNNO = @HTNNO OR @HTNNO IS NULL)        
      AND RES.RSDTBOOKINGMADE BETWEEN @From AND @To        
   AND RES.RSDTXLD iS  NULL        
    ORDER BY EVENTS.EMNNO, RGCPLNM, RGCPFNM        
END 


