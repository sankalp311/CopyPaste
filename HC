    -------------------------------------------------------------------------    
    -- 0) Base Reservation list for the event (matches Crystal join path)    
    --    Crystal path: EVENTS -> REGMST -> ACTMST -> RESERVATIONS    
    -------------------------------------------------------------------------    
    CREATE TABLE #ResMap    
    (    
        RSNNO INT NOT NULL PRIMARY KEY,    
        RGNNO INT NULL    
    );    
    
    INSERT INTO #ResMap (RSNNO, RGNNO)    
    SELECT    
        r.RSNNO,    
        MIN(rm.RGNNO) AS RGNNO    
    FROM dbo.EVENTS e    
    JOIN dbo.REGMST rm   ON rm.EMNNO = e.EMNNO    
    JOIN dbo.ACTMST a    ON a.RGNNO  = rm.RGNNO    
    JOIN dbo.RESERVATIONS r ON r.RSNNO = a.RSNNO    
    WHERE e.EMNNO = 19590    
      AND a.RSNNO IS NOT NULL 
	  AND rm.RGCSTAT <> 'XLD'  
    GROUP BY r.RSNNO;    
    
    -------------------------------------------------------------------------    
    -- 1) Transaction totals per reservation (replaces Crystal Running Totals)    
    --    RunFees  = sum(FEES)    
    --    RunPayments = sum(PAYMENTS)    
    -------------------------------------------------------------------------    
  ---------------------------------------------------------------------------  
 -- 1) Transaction totals per registration (RGNNO)  
 --    Fix: ACTMST rows may have RSNNO NULL (ex: GF), so aggregate by RGNNO  
 ---------------------------------------------------------------------------  
  
 -- helpful index for joining  
 CREATE INDEX IX_ResMap_RGNNO ON #ResMap(RGNNO);  
  
 CREATE TABLE #TxnAgg  
 (  
  RGNNO         INT NOT NULL PRIMARY KEY,  
  TotalCharges  DECIMAL(18,2) NOT NULL,  
  PymtsAdj      DECIMAL(18,2) NOT NULL,  
  BalanceRaw    DECIMAL(18,2) NOT NULL,  
  MaxACNDSBAMT  DECIMAL(18,2) NOT NULL  
 );  
  
 ;WITH RGNList AS  
 (  
  SELECT DISTINCT RGNNO  
  FROM #ResMap  
  WHERE RGNNO IS NOT NULL  
 )  
 INSERT INTO #TxnAgg (RGNNO, TotalCharges, PymtsAdj, BalanceRaw, MaxACNDSBAMT)  
 SELECT  
  a.RGNNO,  
  
  -- Fees (Crystal): GF => ACNEXTAMT  
  SUM(CASE WHEN a.ACCTXTYPE = 'GF'  
     THEN ISNULL(a.ACNEXTAMT,0) ELSE 0 END) AS TotalCharges,  
  
  -- Payments/Adj (Crystal):  
  -- CA/CH/CR/WI/XI/XO/AD => ACNEXTAMT * -1  
  -- RF => ACNEXTAMT  
  SUM(CASE  
    WHEN a.ACCTXTYPE IN ('CA','CH','CR','WI','XI','XO','AD')  
     THEN ISNULL(a.ACNEXTAMT,0) * (-1)  
    WHEN a.ACCTXTYPE = 'RF'  
     THEN ISNULL(a.ACNEXTAMT,0)  
    ELSE 0  
   END) AS PymtsAdj,  
  
  -- BalanceRaw = Fees + Payments  
  SUM(CASE WHEN a.ACCTXTYPE = 'GF'  
     THEN ISNULL(a.ACNEXTAMT,0) ELSE 0 END)  
  +  
  SUM(CASE  
    WHEN a.ACCTXTYPE IN ('CA','CH','CR','WI','XI','XO','AD')  
     THEN ISNULL(a.ACNEXTAMT,0) * (-1)  
    WHEN a.ACCTXTYPE = 'RF'  
     THEN ISNULL(a.ACNEXTAMT,0)  
    ELSE 0  
   END) AS BalanceRaw,  
  
  ISNULL(MAX(a.ACNDSBAMT),0) AS MaxACNDSBAMT  
 FROM dbo.ACTMST a  
 JOIN RGNList g  
  ON g.RGNNO = a.RGNNO  
 JOIN dbo.REGMST rm  
  ON rm.RGNNO = a.RGNNO  
    AND rm.EMNNO = 19590  
    
 GROUP BY  
  a.RGNNO;  
    
    -------------------------------------------------------------------------    
    -- 2) Night aggregates (used for AvgRate / DisplayRunRate / ZeroRateText)    
    -------------------------------------------------------------------------    
    CREATE TABLE #NightAgg    
    (    
        RSNNO        INT NOT NULL PRIMARY KEY,    
        SumHCNCOST   DECIMAL(18,2) NOT NULL,    
        SumRNCharge  DECIMAL(18,2) NOT NULL,    
        CntRNCharge  INT           NOT NULL    
    );    
    
    INSERT INTO #NightAgg (RSNNO, SumHCNCOST, SumRNCharge, CntRNCharge)    
    SELECT    
        rn.RSNNO,    
        SUM(ISNULL(hrtc.HCNCOST,0))                        AS SumHCNCOST,    
        SUM(ISNULL(rn.RNMPERNIGHTCHARGE,0))                AS SumRNCharge,    
        SUM(CASE WHEN rn.RNMPERNIGHTCHARGE IS NULL THEN 0 ELSE 1 END) AS CntRNCharge    
    FROM dbo.RESNIGHTS rn    
    JOIN #ResMap rm ON rm.RSNNO = rn.RSNNO    
    LEFT JOIN dbo.HOTELROOMTYPECOSTS hrtc ON hrtc.HINNO = rn.HINNO    
    GROUP BY rn.RSNNO;    
    
    -------------------------------------------------------------------------    
    -- SELECT #1 : Main/Header dataset (ONE ROW per RSNNO)    
    -------------------------------------------------------------------------    
    SELECT    
        -- Event    
       
    
        -- RunFees / RunPayments (Crystal running totals replaced by totals)    
        ISNULL(tx.TotalCharges,0) AS RunFee,    
        ISNULL(tx.PymtsAdj,0)     AS RunPayment,    
    
        -- BalanceAmount    
       -- CASE WHEN ISNULL(tx.BalanceRaw,0) > 0 THEN ISNULL(tx.BalanceRaw,0) ELSE 0 END AS BalanceAmount,    
       ISNULL(tx.TotalCharges,0) + ISNULL(tx.PymtsAdj,0) AS BalanceAmount,    
    
        -- BalanceLabel    
        CASE WHEN ISNULL(tx.BalanceRaw,0) > 0 THEN 'Balance Due:' 
			 WHEN ISNULL(tx.BalanceRaw,0) < 0 THEN 'Credit Due:' 
            ELSE 'Paid in Full/Balance:'    
        END AS BalanceLabel,    
    tx.BalanceRaw
       
    FROM #ResMap m    
    JOIN dbo.EVENTS e       ON e.EMNNO = 19590    
    JOIN dbo.REGMST rg      ON rg.RGNNO = m.RGNNO and rg.RGCSTAT <> 'XLD'    
    LEFT JOIN dbo.REGUSER ru ON ru.RGNNO = rg.RGNNO    
    LEFT JOIN dbo.CATEGORY c ON c.CMNNO = rg.CMNNO    
    JOIN dbo.RESERVATIONS r  ON r.RSNNO = m.RSNNO    
 OUTER APPLY    
 (    
  SELECT    
   TRY_CONVERT(int, NULLIF(LEFT(LTRIM(RTRIM(r.RSCCCEXP)), 2), ''))  AS ExpMM,    
   TRY_CONVERT(int, NULLIF(RIGHT(LTRIM(RTRIM(r.RSCCCEXP)), 2), '')) AS ExpYY    
 ) exp    
    LEFT JOIN dbo.HOTEL h   ON h.HTNNO = r.HTNNO    
    LEFT JOIN dbo.ROOMTYPES rt       ON rt.RTNNO = r.RTNNO    
    LEFT JOIN dbo.ROOMCATEGORIES rc  ON rc.RCNNO = r.RCNNO    
    LEFT JOIN #TxnAgg tx     ON tx.RGNNO = r.RGNNO    
    LEFT JOIN #NightAgg na   ON na.RSNNO = r.RSNNO    
    where tx.RGNNO = 2684849
    ORDER BY    
        e.EMNNO,    
        CASE    
            WHEN ISNULL(rg.RGCPLNM,'') = '' THEN 'AAAAAAAA' + ISNULL(rg.RGCPFNM,'') + CAST(rg.RGNNO AS VARCHAR(20))    
            WHEN ISNULL(rg.RGCPFNM,'') = '' THEN ISNULL(rg.RGCPLNM,'') + 'AAAAAAA' + CAST(rg.RGNNO AS VARCHAR(20))    
            ELSE ISNULL(rg.RGCPLNM,'') + ISNULL(rg.RGCPFNM,'') + CAST(rg.RGNNO AS VARCHAR(20))    
        END,    
        (CASE WHEN r.RSDTXLD IS NULL THEN 'b' ELSE 'a' END)    
        + CAST(ISNULL(r.HTNNO,0) AS VARCHAR(20))    
        + CAST(r.RSNNO AS VARCHAR(20)),    
        r.RSNNO;    
    

  
  

