CREATE PROC dbo.sp_ICM_rpt_DynamicInventoryStatus  
(  
      @EOCGROUP  NVARCHAR(100) = N'dynamicinventory'  
    , @EOCACTION NVARCHAR(10)  = N'1'  
    , @Token     VARCHAR(100)  = NULL  
)  
AS  
BEGIN  
    SET NOCOUNT ON;  
  
    -- Use INNER JOIN if you filter EO columns  
    SELECT  
          E.EMCNO,  
          E.EMCNM,  
          EO.EOCGROUP,  
          EO.EOCACTION,  
          E.EMDTBEG,  
          DynamicInventoryStatus =  
            CASE  
                WHEN LTRIM(RTRIM(CONVERT(NVARCHAR(10), EO.EOCACTION))) <> N'1' THEN N'No Access'  
                ELSE N'Access Allowed'  
            END  
    FROM dbo.EVENTS AS E  
    INNER JOIN dbo.EVENT_OPTIONS AS EO  
        ON E.EMNNO = EO.EMNNO  
    WHERE EO.EOCGROUP  = @EOCGROUP  
      AND EO.EOCACTION = @EOCACTION  
    ORDER BY EO.EOCACTION DESC;  
END  
