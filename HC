CREATE PROCEDURE dbo.rpt_TT_BlkDetailInv                    
/******************************************************************************************                  
-- Author      : Sankalp Mishra                 
-- Company     : Jsimple                  
-- Project     : ICM                  
-- File Name   : rpt_TT_BlkDetailInv.sql                  
-- Description : Generates hotel-wise block detail and inventory summary report                   
--               with Crystal-formula-equivalent calculations for RDLC output.                  
--                  
-- Parameters :                  
--   @EMNNO     : Event number (varchar)                  
--   @EMCNO     : Event category number (varchar)                  
--   @From/@To  : (currently unused – kept for parity)                  
--   @SessionID : Optional session tracking ID                  
******************************************************************************************/            
    @EMNNO     varchar(50)   = NULL,                    
    @EMCNO     varchar(50)   = NULL,                    
    @From      datetime      = NULL,                    
    @To        datetime      = NULL,                    
    @SessionID nvarchar(128) = NULL                    
AS                    
BEGIN                    
    SET NOCOUNT ON;                      
     
    ------------------------------------------------------------            
    -- Normalize EMNNO            
    ------------------------------------------------------------            
    DECLARE @EMNNO_INT INT = Cast(@EMNNO as INT);                    
            
    ------------------------------------------------------------            
    -- 0) Event hotels for this event / EMCNO            
    ------------------------------------------------------------            
    IF OBJECT_ID('tempdb..#EventHotels') IS NOT NULL DROP TABLE #EventHotels;            
            
    SELECT  h.HTNNO,            
            h.EMNNO            
    INTO    #EventHotels            
    FROM    dbo.HOTEL  AS h            
    JOIN    dbo.EVENTS AS e ON e.EMNNO = h.EMNNO            
    WHERE   (@EMNNO_INT IS NULL OR e.EMNNO = @EMNNO_INT)            
      --AND   (@EMCNO     IS NULL OR e.EMCNO = @EMCNO);            
            
    ------------------------------------------------------------            
    -- If nothing matches, still return 5 empty resultsets            
    ------------------------------------------------------------            
    IF NOT EXISTS (SELECT 1 FROM #EventHotels)            
    BEGIN            
        -- 1) Header            
        SELECT TOP (0)            
               EMCNM        = CAST(NULL AS varchar(100)),            
               EMCNO        = CAST(NULL AS varchar(50)),            
               EMDTBEG      = CAST(NULL AS varchar(50)),            
               EMDTEND      = CAST(NULL AS varchar(50)),            
               TotalRooms   = CAST(0 AS int),            
               UnusedRooms  = CAST(0 AS int);            
            
        -- 2) HotelGroupingTable            
        SELECT TOP (0)            
               HTCDSC          = CAST(NULL AS varchar(100)),            
               HTCSLENM        = CAST(NULL AS varchar(100)),            
               HTCSLETEL       = CAST(NULL AS varchar(50)),            
               HTCSLEEMAIL     = CAST(NULL AS varchar(100)),            
               HTDTADDDATE     = CAST(NULL AS varchar(10)),            
               HTDTCUTOFF      = CAST(NULL AS datetime),            
               HTNCMPRMPER     = CAST(NULL AS int),            
               HTNCMPRM        = CAST(NULL AS int),            
               HTNNO           = CAST(NULL AS int),            
               HotelDepositAmount = CAST(NULL AS varchar(20)),            
               HotelRoomsRequested = CAST(0 AS int),            
               HotelRoomsPickup    = CAST(0 AS int),            
               HotelRoomsNotPicked = CAST(0 AS int);            
            
     -- 3) HotelWiseData            
        SELECT TOP (0)            
               WebCode      = CAST(NULL AS nvarchar(50)),            
    BlockOverride= CAST(NULL AS date),            
               TeamCutoff   = CAST(NULL AS date),            
               TeamName     = CAST(NULL AS nvarchar(200)),            
               GroupLeader  = CAST(NULL AS nvarchar(200)),            
               Phone        = CAST(NULL AS nvarchar(50)),            
        ApprovedDate = CAST(NULL AS date),            
               [Block]      = CAST(NULL AS nvarchar(50)),            
               RMSBlocked   = CAST(0 AS int),            
           Pickup       = CAST(0 AS int),            
               Cxl          = CAST(0 AS int),            
               NotPickedup  = CAST(0 AS int),            
               RMNIPickup   = CAST(0 AS int),            
               HTNNO        = CAST(NULL AS int);            
            
        -- 4) HotelRates            
        SELECT TOP (0)            
               HTNNO          = CAST(NULL AS int),            
               HotelRoomBlock = CAST(NULL AS nvarchar(4000)),            
               [Block]        = CAST(0 AS int),            
               PeakNightInv   = CAST(NULL AS varchar(50));            
            
        -- 5) Grand totals            
        SELECT            
            TotalRMSBlocked   = CAST(0 AS int),            
            TotalPickup       = CAST(0 AS int),            
            TotalNotPickedup  = CAST(0 AS int),            
            TotalRMNIPickup   = CAST(0 AS int),            
            GrandTotal        = CAST(0 AS int);            
            
        RETURN;            
    END;            
            
    ------------------------------------------------------------            
    -- 1) Block-level inventory: Maximum(...) over nights per block            
    ------------------------------------------------------------            
    IF OBJECT_ID('tempdb..#Blocks') IS NOT NULL DROP TABLE #Blocks;            
            
    ;WITH BlockInv AS            
    (            
        SELECT            
            hb.HBNNO,            
            hb.HTNNO,            
            hb.HBNAPPROVED,            
            hb.HBDTXLD,            
            hb.HBCACRO,            
            hb.HBCNO,            
            hb.HBCORG,            
            hb.HBCFNM,            
            hb.HBCLNM,            
            hb.HBCTEL,            
            hb.HBDTAPPROVED,            
            hb.HBOVERWRITECUTOFFDATE,            
            hb.HBTEAMCUTOFFDATE,            
            rc.RCCACRO,            
            
            ReqPerNight    = ISNULL(inv.RBNAMOUNTRESERVED,0) + ISNULL(inv.RBNADJUSTMENTS,0),            
            PickupPerNight = ISNULL(inv.RBNAMOUNTRESERVED,0) + ISNULL(inv.RBNADJUSTMENTS,0) - ISNULL(inv.RBNREMAININGAVAILABLE,0),            
            RemainPerNight = ISNULL(inv.RBNREMAININGAVAILABLE,0)            
        FROM dbo.HOTELROOMBLOCKS hb            
        JOIN #EventHotels    eh  ON eh.HTNNO = hb.HTNNO            
        LEFT JOIN dbo.ROOMCATEGORIES          rc  ON rc.RCNNO = hb.RCNNO            
        LEFT JOIN dbo.HOTELROOMBLOCKINVENTORY inv ON inv.HBNNO = hb.HBNNO            
    )            
    SELECT            
        bi.HBNNO,            
        bi.HTNNO,            
        bi.HBNAPPROVED,            
        bi.HBDTXLD,            
        bi.HBCACRO,            
        bi.HBCNO,            
        bi.HBCORG,            
        bi.HBCFNM,            
        bi.HBCLNM,            
        bi.HBCTEL,            
        bi.HBDTAPPROVED,            
        bi.HBOVERWRITECUTOFFDATE,            
        bi.HBTEAMCUTOFFDATE,            
        bi.RCCACRO,            
            
        MaxRequested = MAX(bi.ReqPerNight),            
        MaxPickup    = MAX(bi.PickupPerNight),            
        MaxRemain    = MAX(bi.RemainPerNight)            
    INTO #Blocks            
    FROM BlockInv bi            
    GROUP BY            
       bi.HBNNO,            
        bi.HTNNO,            
        bi.HBNAPPROVED,            
        bi.HBDTXLD,            
        bi.HBCACRO,            
        bi.HBCNO,            
        bi.HBCORG,            
        bi.HBCFNM,            
        bi.HBCLNM,            
        bi.HBCTEL,            
        bi.HBDTAPPROVED,           
    bi.HBOVERWRITECUTOFFDATE,            
        bi.HBTEAMCUTOFFDATE,            
        bi.RCCACRO;            
            
    CREATE UNIQUE CLUSTERED INDEX IX_B_HBNNO ON #Blocks(HBNNO);            
            
    ------------------------------------------------------------            
    -- 2) Cancelled reservations per block (CanceledCounter)            
    ------------------------------------------------------------            
    IF OBJECT_ID('tempdb..#BlockCxl') IS NOT NULL DROP TABLE #BlockCxl;            
            
    SELECT            
        r.HBNNO,            
        Cxl = SUM(            
                CASE WHEN ISNULL(CONVERT(varchar(50), r.RSDTXLD), '') = '' THEN 0            
                     ELSE 1            
END)            
    INTO #BlockCxl            
    FROM dbo.RESERVATIONS r            
    JOIN #Blocks b ON b.HBNNO = r.HBNNO            
    GROUP BY r.HBNNO;            
            
    CREATE UNIQUE CLUSTERED INDEX IX_C_HBNNO ON #BlockCxl(HBNNO);            
            
    ------------------------------------------------------------            
    -- 3) Room-nights per block (RMNIPickup) – Crystal #Nites logic            
    -- #Nites:            
    --   if HBNAPPROVED = 0 then 0            
    --   else if RSDTXLD <> '' then 0            
    --   else RSDTDEP - RSDTARR            
    -- Running total in Crystal is effectively SUM(#Nites) per block.            
    ------------------------------------------------------------            
    IF OBJECT_ID('tempdb..#BlkRmNites') IS NOT NULL DROP TABLE #BlkRmNites;            
            
    SELECT            
        r.HBNNO,            
        RmNitesPickup =            
            SUM(                  CASE             
                    WHEN b.HBNAPPROVED = 0 THEN 0            
                    WHEN ISNULL(CONVERT(varchar(50), r.RSDTXLD), '') <> '' THEN 0            
                    ELSE DATEDIFF(DAY, r.RSDTARR, r.RSDTDEP)            
                END            
            )            
    INTO #BlkRmNites            
    FROM dbo.RESERVATIONS r            
    JOIN #Blocks b ON b.HBNNO = r.HBNNO            
    GROUP BY r.HBNNO;            
            
    CREATE UNIQUE CLUSTERED INDEX IX_RN_HBNNO ON #BlkRmNites(HBNNO);            
            
    ------------------------------------------------------------            
    -- 4) Apply Crystal formulas per block (one row per HBNNO)            
    ------------------------------------------------------------            
    IF OBJECT_ID('tempdb..#BlockCalc') IS NOT NULL DROP TABLE #BlockCalc;            
            
    SELECT            
        b.*,            
            
        CxlCount =            
            ISNULL(c.Cxl, 0),            
            
        CancelledBlock =            
            CASE WHEN ISNULL(CONVERT(varchar(50), b.HBDTXLD), '') = '' THEN 'NotXld'            
                 ELSE 'Xld'            
            END,            
            
        -- Requested-From-Orig  (@Requested-From-Orig)            
        RequestedFromOrig =            
            CASE            
                WHEN b.HBNAPPROVED = 0 THEN 0            
                WHEN ISNULL(CONVERT(varchar(50), b.HBDTXLD), '') <> '' THEN 0            
                ELSE b.MaxRequested            
            END,            
            
        -- BlkPickup  (@BlkPickup)            
        BlkPickup =            
            CASE            
                WHEN b.HBNAPPROVED = 0 THEN 0            
                WHEN ISNULL(CONVERT(varchar(50), b.HBDTXLD), '') <> '' THEN 0            
                ELSE b.MaxPickup            
            END,            
            
        -- Remaining at peak night (old NotPickedup logic – keep for reference)            
        RemainAtPeak =            
            CASE            
                WHEN b.HBNAPPROVED = 0 THEN 0            
                WHEN ISNULL(CONVERT(varchar(50), b.HBDTXLD), '') <> '' THEN 0            
                ELSE b.MaxRemain            
            END,            
            
        -- Block NotPickedUp            
        -- BlockNotPickedup = Maximum(@Requested-From-Orig, @SubBlkSort)            
        -- - Maximum(@BlkPickup, @SubBlkSort)            
        BlockNotPickedUp =            
            CASE            
                WHEN b.HBNAPPROVED = 0 THEN 0            
                WHEN ISNULL(CONVERT(varchar(50), b.HBDTXLD), '') <> '' THEN 0            
                ELSE b.MaxRequested - b.MaxPickup            
            END,            
            
        -- Room-nights in pickup (RMNIPickup column)            
        RmNitesPickup =            
            ISNULL(n.RmNitesPickup, 0),        
     CrystalBlkGroupKey =        
        CASE         
            WHEN NULLIF(LTRIM(RTRIM(b.HBCACRO)), '') IS NULL        
                THEN ISNULL(CONVERT(nvarchar(50), b.HBCNO), '')        
                     + RIGHT('0000000000' + CONVERT(varchar(10), b.HBNNO), 10)        
            ELSE LTRIM(RTRIM(b.HBCACRO))        
                     + RIGHT('0000000000' + CONVERT(varchar(10), b.HBNNO), 10)        
        END        
    INTO #BlockCalc            
    FROM #Blocks b            
    LEFT JOIN #BlockCxl     c ON c.HBNNO = b.HBNNO            
    LEFT JOIN #BlkRmNites   n ON n.HBNNO = b.HBNNO;            
            
    CREATE UNIQUE CLUSTERED INDEX IX_BC_HBNNO ON #BlockCalc(HBNNO);            
            
    ------------------------------------------------------------            
    -- 5) HotelWiseData: detail rows for RDLC            
    --    Column mapping to Crystal table:            
    --      RMSBlocked   -> @Requested-From-Orig            
    --      Pickup       -> @BlkPickup            
    --      NotPickedup  -> BlockNotPickedup  (NOT RemainAtPeak)            
    --      RMNIPickup   -> SUM(#Nites)            
    ------------------------------------------------------------            
    IF OBJECT_ID('tempdb..#HotelWiseData') IS NOT NULL DROP TABLE #HotelWiseData;            
            
    SELECT            
        WebCode       = NULLIF(LTRIM(RTRIM(bc.HBCACRO)), ''),            
        BlockOverride = CONVERT(date, bc.HBOVERWRITECUTOFFDATE),            
        TeamCutoff    = CONVERT(date, bc.HBTEAMCUTOFFDATE),            
        TeamName      = NULLIF(LTRIM(RTRIM(bc.HBCORG)), ''),            
        GroupLeader   = LTRIM(RTRIM(ISNULL(bc.HBCFNM,'') + ' ' + ISNULL(bc.HBCLNM,''))),            
        Phone         = bc.HBCTEL,            
        ApprovedDate  = CONVERT(date, bc.HBDTAPPROVED),            
        [Block]       = bc.RCCACRO,            
            
        RMSBlocked    = bc.RequestedFromOrig,            
        Pickup        = bc.BlkPickup,            
        Cxl           = bc.CxlCount,            
        NotPickedup   = bc.BlockNotPickedUp,   -- << Crystal BlockNotPickedup            
        RMNIPickup    = bc.RmNitesPickup,      -- << SUM(#Nites)            
  CrystalBlkGroupKey = bc.CrystalBlkGroupKey,        
        HTNNO         = bc.HTNNO            
    INTO #HotelWiseData            
    FROM #BlockCalc bc        
 WHERE NOT        
(        
    LOWER(COALESCE(LTRIM(RTRIM(bc.HBCACRO)), '')) = 'request'        
    AND bc.HBOVERWRITECUTOFFDATE IS NULL        
    AND ISNULL(bc.RequestedFromOrig, 0) = 0        
    AND ISNULL(bc.BlkPickup, 0) = 0        
    AND ISNULL(bc.CxlCount, 0) = 0        
    AND ISNULL(bc.BlockNotPickedUp, 0) = 0        
    AND ISNULL(bc.RmNitesPickup, 0) = 0        
);        
            
    CREATE NONCLUSTERED INDEX IX_HWD_HTNNO ON #HotelWiseData(HTNNO);            
            
     ------------------------------------------------------------            
    -- 5a) Ensure every hotel appears at least once in #HotelWiseData            
    --     Even if there are no blocks/reservations for that hotel,            
    --     insert a single "blank" row with zeros.            
    ------------------------------------------------------------            
    INSERT INTO #HotelWiseData            
    (            
        WebCode,            
        BlockOverride,            
        TeamCutoff,            
        TeamName,            
        GroupLeader,            
        Phone,            
        ApprovedDate,            
        [Block],            
        RMSBlocked,            
        Pickup,            
        Cxl,            
        NotPickedup,       
        RMNIPickup,            
        HTNNO ,        
  CrystalBlkGroupKey         
    )            
    SELECT            
        WebCode       = NULL,            
        BlockOverride = NULL,            
        TeamCutoff    = NULL,            
        TeamName      = NULL,            
        GroupLeader   = NULL,            
        Phone         = NULL,            
        ApprovedDate  = NULL,            
       [Block]       = NULL,            
        RMSBlocked    = 0,            
        Pickup        = 0,            
        Cxl           = 0,            
        NotPickedup   = 0,            
        RMNIPickup    = 0,            
        HTNNO         = eh.HTNNO,        
  NULL        
    FROM #EventHotels eh            
    LEFT JOIN #HotelWiseData hwd ON hwd.HTNNO = eh.HTNNO            
    WHERE hwd.HTNNO IS NULL;            
            
            
    ------------------------------------------------------------            
    -- 6) Event totals from HotelWiseData (Crystal-style)            
    ------------------------------------------------------------            
    DECLARE @TotalRMSBlocked   INT = 0,            
            @TotalPickup       INT = 0,            
            @TotalNotPickedup  INT = 0,            
            @TotalRMNIPickup   INT = 0,            
            @GrandTotal        INT = 0,            
            @TotalRooms        INT = 0,   -- from HOTELINVENTORY peak logic            
            @UnusedRooms       INT = 0;   -- TotalRooms - TotalPickup            
            
    SELECT            
        @TotalRMSBlocked   = ISNULL(SUM(RMSBlocked),0),            
        @TotalPickup       = ISNULL(SUM(Pickup),0),            
        @TotalNotPickedup  = ISNULL(SUM(NotPickedup),0),            
        @TotalRMNIPickup   = ISNULL(SUM(RMNIPickup),0)            
    FROM #HotelWiseData;            
            
    SET @GrandTotal = @TotalRMSBlocked;            
            
    ------------------------------------------------------------            
    -- 7) Build HotelRatesAgg once (original subreport SQL) and            
    --    use PeakInv sum for TotalRooms / UnusedRooms.            
    ------------------------------------------------------------            
    IF OBJECT_ID('tempdb..#HotelRatesAgg') IS NOT NULL DROP TABLE #HotelRatesAgg;            
            
    ;WITH RateBase AS                
    (                
        SELECT                
            h.HTNNO,                
            rc.RCCACRO,                
            hrc.HRCBLOCKREQUEST,                
            hrt.HCNCOST,                
            hi.HINAMOUNTRESERVED                
        FROM #EventHotels eh                
        JOIN dbo.HOTEL               AS h   ON h.HTNNO = eh.HTNNO                
        JOIN dbo.EVENTS              AS e   ON e.EMNNO = h.EMNNO                
        JOIN dbo.HOTELROOMCATEGORIES AS hrc ON h.HTNNO = hrc.HTNNO                
        JOIN dbo.HOTELINVENTORY      AS hi  ON hrc.HRNNO = hi.HRNNO                
        JOIN dbo.ROOMCATEGORIES      AS rc  ON hrc.RCNNO = rc.RCNNO                
        JOIN dbo.HOTELROOMTYPECOSTS  AS hrt ON hi.HINNO = hrt.HINNO                
        WHERE (@EMNNO_INT IS NULL OR e.EMNNO = @EMNNO_INT)                
          --AND (@EMCNO     IS NULL OR e.EMCNO = @EMCNO)                
    ),                
    Agg AS             
    (            
        SELECT                
            HTNNO,                
            RCCACRO,                
            HRCBLOCKREQUEST,                
            TotalHCNCost = MAX(ISNULL(HCNCOST,0)),                
            PeakInv      = MAX(ISNULL(HINAMOUNTRESERVED,0))                
        FROM RateBase                
        GROUP BY HTNNO, RCCACRO, HRCBLOCKREQUEST                
    )                
    SELECT *            
    INTO #HotelRatesAgg            
    FROM Agg;            
            
    -- TotalRooms = sum of PeakInv across all hotels/categories            
    SELECT @TotalRooms = ISNULL(SUM(PeakInv), 0)            
    FROM #HotelRatesAgg;            
            
    -- UnusedRooms = TotalRooms - total pickup (block-based pickup)            
    SET @UnusedRooms = @TotalRooms - ISNULL(@TotalPickup, 0);            
            
    ------------------------------------------------------------            
    -- 8) Resultset #1 – Header (Event info + TotalRooms/UnusedRooms)            
    ------------------------------------------------------------            
    SELECT TOP (1)            
           e.EMCNM,            
           e.EMCNO,            
           EMDTBEG =            
               DATENAME(WEEKDAY, e.EMDTBEG) + ', ' + CONVERT(varchar(10), e.EMDTBEG, 101) +            
               ' - ' +            
               DATENAME(WEEKDAY, e.EMDTEND) + ', ' + CONVERT(varchar(10), e.EMDTEND, 101),            
           EMDTEND   = CONVERT(varchar(10), e.EMDTEND, 101),            
           TotalRooms  = @TotalRooms,            
           UnusedRooms = @UnusedRooms            
    FROM dbo.EVENTS e            
    WHERE (@EMNNO_INT IS NULL OR e.EMNNO = @EMNNO_INT)            
      --AND (@EMCNO     IS NULL OR e.EMCNO = @EMCNO)            
    ORDER BY e.EMNNO;            
            
    ------------------------------------------------------------        
 -- 9) Resultset #2 – HotelGroupingTable  (FIXED)        
 ------------------------------------------------------------        
        
 ;WITH HotelBase AS        
 (        
  SELECT DISTINCT        
   HTNNO,        
   HTCDSC,        
   HTCSLENM,        
   HTCSLETEL,        
   HTCSLEEMAIL,        
   HTDTADDDATE,        
   HTDTCUTOFF,        
   HTNCMPRMPER,        
   HTNCMPRM,        
   HTCACCTYPE        
  FROM dbo.HOTEL        
 )        
 SELECT        
  h.HTCDSC,        
  h.HTCSLENM,        
  h.HTCSLETEL,        
  h.HTCSLEEMAIL,        
  HTDTADDDATE = CONVERT(varchar(10), h.HTDTADDDATE, 101),        
  h.HTDTCUTOFF,        
  h.HTNCMPRMPER,        
  h.HTNCMPRM,        
  h.HTNNO,        
  -- Robust per-hotel deposit label        
  HotelDepositAmount =        
   MAX(CASE        
     WHEN UPPER(LTRIM(RTRIM(ISNULL(h.HTCACCTYPE, '')))) = 'DA'        
      THEN 'DEPOSIT HOTEL'        
     ELSE ''        
    END),        
        
  HotelRoomsRequested = ISNULL(SUM(hwd.RMSBlocked),0),        
  HotelRoomsPickup    = ISNULL(SUM(hwd.Pickup),0),        
  HotelRoomsNotPicked = ISNULL(SUM(hwd.NotPickedup),0)        
        
 FROM HotelBase h        
 JOIN #EventHotels eh ON eh.HTNNO = h.HTNNO        
 LEFT JOIN #HotelWiseData hwd ON hwd.HTNNO = h.HTNNO        
        
 GROUP BY        
  h.HTCDSC,        
  h.HTCSLENM,        
  h.HTCSLETEL,        
  h.HTCSLEEMAIL,        
  h.HTDTADDDATE,        
  h.HTDTCUTOFF,        
  h.HTNCMPRMPER,        
  h.HTNCMPRM,        
  h.HTNNO        
        
 ORDER BY h.HTCDSC;        
        
            
    ------------------------------------------------------------            
    -- 10) Resultset #3 – HotelWiseData (detail rows)            
    ------------------------------------------------------------            
    SELECT            
        WebCode,            
        BlockOverride,            
        TeamCutoff,            
        TeamName,            
        GroupLeader,            
        Phone,            
        ApprovedDate,            
        [Block],            
        RMSBlocked,            
        Pickup,            
   Cxl,            
        NotPickedup,            
        RMNIPickup,            
        HTNNO            
    FROM #HotelWiseData         
   ORDER BY         
    --HTNNO,        
    CrystalBlkGroupKey ASC;        
   --- TeamName,        
   -- WebCode,        
   -- [Block];        
         
            
    ------------------------------------------------------------            
    -- 11) Resultset #4 – HotelRates (subreport dataset)            
    ------------------------------------------------------------            
  SELECT                
    a.HTNNO,                
        
   HotelRoomBlock =        
    CAST(        
          '<b>' + a.RCCACRO + ': '         
          + CONVERT(varchar(20), CAST(a.TotalHCNCost AS decimal(18,2)))         
          + '</b>'        
          + CASE                
                WHEN a.HRCBLOCKREQUEST IS NOT NULL                
                     AND LTRIM(RTRIM(a.HRCBLOCKREQUEST)) <> ''                
                     AND UPPER(LTRIM(RTRIM(a.HRCBLOCKREQUEST))) <> 'NONE'                
                THEN '<br/><i>' + a.HRCBLOCKREQUEST + '</i>'                  
                ELSE ''                
            END        
         AS nvarchar(4000)        
    ),        
        
    [Block]      = CAST(0 AS int),                    
   PeakNightInv =        
    CAST(        
        'Peak Night Inv: ' + CONVERT(varchar(20), a.PeakInv)        
        + CASE        
            WHEN a.HRCBLOCKREQUEST IS NOT NULL        
                 AND LTRIM(RTRIM(a.HRCBLOCKREQUEST)) <> ''        
                 AND UPPER(LTRIM(RTRIM(a.HRCBLOCKREQUEST))) <> 'NONE'        
            THEN '<br/>&nbsp;'        
            ELSE ''        
          END        
        AS nvarchar(4000)        
    )        
        
FROM #HotelRatesAgg a                
ORDER BY a.HTNNO, a.RCCACRO;         
                   
            
    ------------------------------------------------------------            
    -- 12) Resultset #5 – Grand totals for Event Totals row            
    ------------------------------------------------------------            
    SELECT            
        TotalRMSBlocked   = @TotalRMSBlocked,            
        TotalPickup       = @TotalPickup,            
        TotalNotPickedup  = @TotalNotPickedup,            
        TotalRMNIPickup   = @TotalRMNIPickup,            
        GrandTotal        = @GrandTotal;            
            
    ------------------------------------------------------------            
    -- Cleanup            
    ------------------------------------------------------------            
    DROP TABLE #HotelWiseData;            
    DROP TABLE #BlockCalc;            
    DROP TABLE #BlkRmNites;            
    DROP TABLE #BlockCxl;            
    DROP TABLE #Blocks;            
    DROP TABLE #HotelRatesAgg;            
    DROP TABLE #EventHotels;            
END; 
