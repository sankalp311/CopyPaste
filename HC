CREATE OR ALTER PROCEDURE dbo.sp_YourReport_Optimized
(
    @EMNNO INT
)
AS
BEGIN
    SET NOCOUNT ON;
    SET ANSI_WARNINGS OFF;

    /* -------------------------------
       1) Base: ONE row per reservation (RSNNO)
       Filter early (biggest speed win)
    -------------------------------- */
    IF OBJECT_ID('tempdb..#ResBase') IS NOT NULL DROP TABLE #ResBase;

    SELECT
        rm.RGCPLNM,
        rm.RGCPFNM,
        rm.RGNNO,

        e.EMNNO,
        e.EMCNM,
        e.EMDTBEG,
        e.EMDTEND,

        r.RSNNO,
        r.RSDTARR,
        r.RSDTDEP,
        r.RSDTXLD,

        h.HTNNO,
        h.HTCDSC,
        h.HTCACRO,

        rc.RCCACRO,
        rt.RTCACRO,

        hb.HBCORG,

        r.RSCCCTYPE,
        r.RSCCCNO,
        r.RSCCCEXP,

        /* --- Crystal formula pieces (reservation-level) --- */
        FullName =
            CASE
                WHEN rm.RGCPLNM IS NULL OR LTRIM(RTRIM(rm.RGCPLNM)) = ''
                    THEN 'No Last name' + ', ' + ISNULL(rm.RGCPFNM,'')
                ELSE LTRIM(RTRIM(rm.RGCPLNM)) + ', ' + ISNULL(rm.RGCPFNM,'')
            END,

        HotelPersonReq =
            CASE WHEN r.RSCPERSONCOMMENTS IS NULL THEN '' ELSE r.RSCPERSONCOMMENTS END,

        HotelRequests =
            CASE
                WHEN r.RSCPERSONCOMMENTS IS NULL
                    THEN ISNULL(r.RSCREQUESTSTRING,'')
                WHEN r.RSCPERSONCOMMENTS IS NOT NULL AND r.RSCREQUESTSTRING IS NOT NULL
                    THEN ', ' + r.RSCREQUESTSTRING
                ELSE ''
            END,

        HotelMstrAcctReq =
            CASE
                WHEN r.RSNMASTERACCOUNT IS NULL OR r.RSNMASTERACCOUNT = 0 THEN ''
                WHEN r.RSNMASTERACCOUNT = 1
                     AND (r.RSCPERSONCOMMENTS IS NOT NULL OR r.RSCREQUESTSTRING IS NOT NULL)
                    THEN ', Master Account-Room Only'
                WHEN r.RSNMASTERACCOUNT = 2
                     AND (r.RSCPERSONCOMMENTS IS NOT NULL OR r.RSCREQUESTSTRING IS NOT NULL)
                    THEN ', Master Account-Rm, Tax & Incidentals'
                WHEN r.RSNMASTERACCOUNT = 1
                     AND r.RSCPERSONCOMMENTS IS NULL AND r.RSCREQUESTSTRING IS NULL
                    THEN 'Master Account-Room Only'
                WHEN r.RSNMASTERACCOUNT = 2
                     AND r.RSCPERSONCOMMENTS IS NULL AND r.RSCREQUESTSTRING IS NULL
                    THEN 'Master Account-Rm, Tax & Incidentals'
                ELSE ''
            END,

        HotelOnlyRequests =
            CASE
                WHEN (r.RSCPERSONCOMMENTS IS NOT NULL
                      OR r.RSCREQUESTSTRING IS NOT NULL
                      OR ISNULL(r.RSNMASTERACCOUNT,0) <> 0)
                THEN
                    CASE WHEN r.RSCHOTELCOMMENTS IS NULL THEN '' ELSE ', ' + r.RSCHOTELCOMMENTS END
                ELSE ISNULL(r.RSCHOTELCOMMENTS,'')
            END

    INTO #ResBase
    FROM dbo.RESERVATIONS r
    INNER JOIN dbo.REGMST rm
        ON rm.RGNNO = r.RGNNO
    INNER JOIN dbo.EVENTS e
        ON e.EMNNO = rm.EMNNO
    INNER JOIN dbo.HOTEL h
        ON h.HTNNO = r.HTNNO
    INNER JOIN dbo.ROOMTYPES rt
        ON rt.RTNNO = r.RTNNO
    INNER JOIN dbo.ROOMCATEGORIES rc
        ON rc.RCNNO = r.RCNNO
    LEFT JOIN dbo.HOTELROOMBLOCKS hb
        ON hb.HBNNO = r.HBNNO
    WHERE
        rm.EMNNO = @EMNNO
        -- aap last me NbrNites>0 filter laga rahe the,
        -- so yahi early filter kar do (same result, much faster):
        AND r.RSDTXLD IS NULL
        AND r.RSDTDEP > r.RSDTARR;

    -- Temp table indexing (huge help for next joins)
    CREATE UNIQUE CLUSTERED INDEX IX_ResBase_RSNNO ON #ResBase(RSNNO);
    CREATE INDEX IX_ResBase_Sort ON #ResBase(HTNNO, RGNNO);


    /* -------------------------------
       2) Night aggregation ONLY for these RSNNO
    -------------------------------- */
    IF OBJECT_ID('tempdb..#NightAgg') IS NOT NULL DROP TABLE #NightAgg;

    SELECT
        rn.RSNNO,
        TotalNightCharge = SUM(ISNULL(rn.RNMPERNIGHTCHARGE,0)),
        DistinctNightCnt = COUNT(DISTINCT hi.HIDATE),
        SumHCNCOST       = SUM(ISNULL(hrtc.HCNCOST,0))
    INTO #NightAgg
    FROM dbo.RESNIGHTS rn
    INNER JOIN #ResBase rb
        ON rb.RSNNO = rn.RSNNO
    INNER JOIN dbo.HOTELINVENTORY hi
        ON hi.HINNO = rn.HINNO
    INNER JOIN dbo.HOTELROOMTYPECOSTS hrtc
        ON hrtc.HINNO = rn.HINNO
       AND hrtc.RTNNO = rn.RTNNO
    GROUP BY
        rn.RSNNO;

    CREATE UNIQUE CLUSTERED INDEX IX_NightAgg_RSNNO ON #NightAgg(RSNNO);


    /* -------------------------------
       3) Final projection (decrypt at end)
    -------------------------------- */
    SELECT
        rb.EMNNO,
        HotelSort = ISNULL(rb.HTCACRO,'') + CONVERT(varchar(20), rb.HTNNO),
        NameRegno =
            ISNULL(rb.RGCPLNM,'')
          + ISNULL(rb.RGCPFNM,'')
          + CONVERT(varchar(20), rb.RGNNO)
          + CONVERT(varchar(20), rb.RSNNO),

        rb.RGNNO,
        rb.RSNNO,
        rb.HTNNO,

        rb.EMCNM,
        rb.HTCDSC,
        rb.HTCACRO,
        rb.FullName,

        TeamName     = rb.HBCORG,
        RoomCategory = rb.RCCACRO,
        RoomType     = rb.RTCACRO,

        rb.RSDTARR,
        rb.RSDTDEP,

        NbrNites   = DATEDIFF(DAY, rb.RSDTARR, rb.RSDTDEP),
        NotCanceled = 1,

        AvgRate =
            CASE
                WHEN ISNULL(na.DistinctNightCnt,0) = 0 THEN 0
                ELSE CAST(ISNULL(na.TotalNightCharge,0) AS decimal(18,2))
                     / NULLIF(na.DistinctNightCnt,0)
            END,

        TotalNightCharge = ISNULL(na.TotalNightCharge,0),

        Res_CCInfo =
            ISNULL(rb.RSCCCTYPE,'')
            + ' / '
            + RIGHT(ISNULL(cc.DecNo,''), 4)
            + ' / '
            + ISNULL(cc.DecExp,''),

        rb.HotelPersonReq,
        rb.HotelRequests,
        rb.HotelMstrAcctReq,
        rb.HotelOnlyRequests,

        SpecialRequests =
            ISNULL(rb.HotelPersonReq,'')
          + ISNULL(rb.HotelRequests,'')
          + ISNULL(rb.HotelMstrAcctReq,'')
          + ISNULL(rb.HotelOnlyRequests,''),

        SumHCNCOST = ISNULL(na.SumHCNCOST,0),

        rb.EMDTBEG,
        rb.EMDTEND

    FROM #ResBase rb
    LEFT JOIN #NightAgg na
        ON na.RSNNO = rb.RSNNO

    CROSS APPLY
    (
        SELECT
            DecNo  = master.dbo.udf_blowfishdecrypt(rb.RSCCCNO,  'ILME5fgPicoqFOik+8amMQ=='),
            DecExp = master.dbo.udf_blowfishdecrypt(rb.RSCCCEXP, 'ILME5fgPicoqFOik+8amMQ==')
    ) cc

    ORDER BY
        rb.EMNNO,
        rb.HTCACRO, rb.HTNNO,
        rb.RGCPLNM, rb.RGCPFNM, rb.RGNNO, rb.RSNNO,
        rb.RSDTARR, rb.RSDTDEP

    OPTION (RECOMPILE);  -- avoids parameter sniffing (important when EM sizes vary)
END
GO
