SELECT "EVENTS"."EMNNO", "HOTELROOMBLOCKS"."HBCORG", "HOTELROOMBLOCKS"."HBCFNM", "HOTELROOMBLOCKS"."HBCLNM", "HOTELROOMBLOCKS"."HBCEMAIL", "HOTEL"."HTCDSC", "HOTELROOMBLOCKINVENTORY"."RBNAMOUNTRESERVED", "EVENTS"."EMCNM", "EVENTS"."EMDTBEG", "EVENTS"."EMDTEND", "HOTELROOMBLOCKS"."HBDTAPPROVED", "HOTEL"."HTNNO", "HOTELROOMBLOCKINVENTORY"."RBDATE", "HOTELROOMBLOCKS"."HBNNO", "HOTELROOMBLOCKINVENTORY"."RBNADJUSTMENTS"
FROM   (("ICM"."dbo"."EVENTS" "EVENTS" INNER JOIN "ICM"."dbo"."HOTEL" "HOTEL" ON "EVENTS"."EMNNO"="HOTEL"."EMNNO") INNER JOIN "ICM"."dbo"."HOTELROOMBLOCKS" "HOTELROOMBLOCKS" ON "HOTEL"."HTNNO"="HOTELROOMBLOCKS"."HTNNO") INNER JOIN "ICM"."dbo"."HOTELROOMBLOCKINVENTORY" "HOTELROOMBLOCKINVENTORY" ON "HOTELROOMBLOCKS"."HBNNO"="HOTELROOMBLOCKINVENTORY"."HBNNO"
WHERE  "EVENTS"."EMNNO"=20156
ORDER BY "EVENTS"."EMNNO"

CRystal Formula


BlkReq+Adj
{HOTELROOMBLOCKINVENTORY.RBNAMOUNTRESERVED}+{HOTELROOMBLOCKINVENTORY.RBNADJUSTMENTS}



SortOrder-BlkNameNo
{HOTELROOMBLOCKS.HBCORG}+{HOTELROOMBLOCKS.HBCLNM}+{HOTELROOMBLOCKS.HBCFNM}+totext({HOTEL.HTNNO})


SpecialHides
if uppercase ({HOTELROOMBLOCKS.HBCFNM})='IND' and uppercase ({HOTELROOMBLOCKS.HBCLNM})='RESERVATIONS' then
     0
else if uppercase ({HOTELROOMBLOCKS.HBCFNM})='JOHN' and uppercase ({HOTELROOMBLOCKS.HBCLNM})='BILLINGSLEY' then
    0
else if uppercase ({HOTELROOMBLOCKS.HBCFNM})='TOURNAMENT' and uppercase ({HOTELROOMBLOCKS.HBCLNM})='COMP' then
    0
else 1

