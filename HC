          #region ===== Email ========================================================================

          private void SendPdfByEmail(byte[] pdfBytes, string fileName, string toEmail, string subject, string body)
          {
               if (pdfBytes == null || pdfBytes.Length == 0)
                    throw new InvalidOperationException("Cannot send empty PDF attachment.");

               string smtpHost = GetAppSetting("SendGridHost", "smtp.sendgrid.net");
               int smtpPort = SafeToInt(GetAppSetting("SendGridPort", "587"), 587);
               bool enableSsl = IsYes(GetAppSetting("SendGridEnableSsl", "true"));

               string sendGridApiKey = GetAppSetting("SendGridApiKey", "");
               string fromEmail = GetAppSetting("SendGridFromEmail", "");
               string fromName = GetAppSetting("SendGridFromName", fromEmail);

               if (string.IsNullOrWhiteSpace(fromEmail))
                    throw new InvalidOperationException("SendGridFromEmail is missing.");

               if (string.IsNullOrWhiteSpace(sendGridApiKey))
                    throw new InvalidOperationException("SendGridApiKey is missing.");

               using (MailMessage msg = new MailMessage())
               {
                    msg.From = new MailAddress(fromEmail, fromName);
                    msg.To.Add(toEmail);
                    msg.Subject = string.IsNullOrWhiteSpace(subject) ? "Room Block Confirmation" : subject;
                    msg.Body = body ?? "";
                    msg.IsBodyHtml = true;

                    MemoryStream ms = new MemoryStream(pdfBytes);
                    Attachment att = new Attachment(ms, fileName, "application/pdf");
                    msg.Attachments.Add(att);

                    using (SmtpClient client = new SmtpClient(smtpHost, smtpPort))
                    {
                         client.EnableSsl = enableSsl;
                         client.Credentials = new NetworkCredential("apikey", sendGridApiKey);
                         client.Send(msg);
                    }
               }
          }
