CREATE OR ALTER PROCEDURE dbo.sp_ICM_RPT_TTRg112_DepositConfirmation_RDLC
(
    @EMNNO INT
)
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;
    SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

    -------------------------------------------------------------------------    
    -- 0) Base Reservation list for the event (matches Crystal join path)    
    -------------------------------------------------------------------------    
    CREATE TABLE #ResMap    
    (    
        RSNNO INT NOT NULL PRIMARY KEY,    
        RGNNO INT NULL    
    );    
    
    INSERT INTO #ResMap (RSNNO, RGNNO)    
    SELECT    
        r.RSNNO,    
        MIN(rm.RGNNO) AS RGNNO    
    FROM dbo.EVENTS e    
    JOIN dbo.REGMST rm   ON rm.EMNNO = e.EMNNO    
    JOIN dbo.ACTMST a    ON a.RGNNO  = rm.RGNNO    
    JOIN dbo.RESERVATIONS r ON r.RSNNO = a.RSNNO    
    WHERE e.EMNNO = 20156  and rm.RGNNO=2699128  
      AND a.RSNNO IS NOT NULL    
    AND LTRIM(RTRIM(rm.RGCSTAT)) <> 'XLD'  
    GROUP BY r.RSNNO;    
    
    -------------------------------------------------------------------------    
    -- 1) Transaction totals per reservation    
    -------------------------------------------------------------------------    
    CREATE TABLE #TxnAgg    
    (    
        RGNNO         INT NOT NULL PRIMARY KEY,    
        TotalCharges  DECIMAL(18,2) NOT NULL,    
        PymtsAdj      DECIMAL(18,2) NOT NULL,    
        BalanceRaw    DECIMAL(18,2) NOT NULL,    
        MaxACNDSBAMT  DECIMAL(18,2) NOT NULL    
    );    
    
   
 ;WITH RGNList AS  
 (  
  SELECT DISTINCT RGNNO  
  FROM #ResMap  
  WHERE RGNNO IS NOT NULL  
 )  
 INSERT INTO #TxnAgg (RGNNO, TotalCharges, PymtsAdj, BalanceRaw, MaxACNDSBAMT)  
 SELECT  
  a.RGNNO,  
  
  -- Fees (Crystal): GF => ACNEXTAMT  
  SUM(CASE WHEN a.ACCTXTYPE = 'GF'  
     THEN ISNULL(a.ACNEXTAMT,0) ELSE 0 END) AS TotalCharges,  
  
  -- Payments/Adj (Crystal):  
  -- CA/CH/CR/WI/XI/XO/AD => ACNEXTAMT * -1  
  -- RF => ACNEXTAMT  
  SUM(CASE  
    WHEN a.ACCTXTYPE IN ('CA','CH','CR','WI','XI','XO','AD')  
     THEN ISNULL(a.ACNEXTAMT,0) * (-1)  
    WHEN a.ACCTXTYPE = 'RF'  
     THEN ISNULL(a.ACNEXTAMT,0)  
    ELSE 0  
   END) AS PymtsAdj,  
  
  -- BalanceRaw = Fees + Payments  
  SUM(CASE WHEN a.ACCTXTYPE = 'GF'  
     THEN ISNULL(a.ACNEXTAMT,0) ELSE 0 END)  
  +  
  SUM(CASE  
    WHEN a.ACCTXTYPE IN ('CA','CH','CR','WI','XI','XO','AD')  
     THEN ISNULL(a.ACNEXTAMT,0) * (-1)  
    WHEN a.ACCTXTYPE = 'RF'  
     THEN ISNULL(a.ACNEXTAMT,0)  
    ELSE 0  
   END) AS BalanceRaw,  
  
  ISNULL(MAX(a.ACNDSBAMT),0) AS MaxACNDSBAMT  
 FROM dbo.ACTMST a  
 JOIN RGNList g  
  ON g.RGNNO = a.RGNNO  
 JOIN dbo.REGMST rm  
  ON rm.RGNNO = a.RGNNO  
    AND rm.EMNNO = 20156  
    AND rm.RGCSTAT <> 'XLD'  
 GROUP BY  
  a.RGNNO;    
    
    -------------------------------------------------------------------------    
    -- 2) Night aggregates    
    -------------------------------------------------------------------------    
    CREATE TABLE #NightAgg    
    (    
        RSNNO        INT NOT NULL PRIMARY KEY,    
        SumHCNCOST   DECIMAL(18,2) NOT NULL,    
        SumRNCharge  DECIMAL(18,2) NOT NULL,    
        CntRNCharge  INT           NOT NULL    
    );    
    
    INSERT INTO #NightAgg (RSNNO, SumHCNCOST, SumRNCharge, CntRNCharge)    
    SELECT    
        rn.RSNNO,    
        SUM(ISNULL(hrtc.HCNCOST,0))                        AS SumHCNCOST,    
        SUM(ISNULL(rn.RNMPERNIGHTCHARGE,0))                AS SumRNCharge,    
        SUM(CASE WHEN rn.RNMPERNIGHTCHARGE IS NULL THEN 0 ELSE 1 END) AS CntRNCharge    
    FROM dbo.RESNIGHTS rn    
    JOIN #ResMap rm ON rm.RSNNO = rn.RSNNO    
    LEFT JOIN dbo.HOTELROOMTYPECOSTS hrtc ON hrtc.HINNO = rn.HINNO    
    GROUP BY rn.RSNNO;    
    
    -------------------------------------------------------------------------    
    -- ✅ NEW: Deposit Grid rows (your old SELECT #2) for all RSNNO in event    
    -------------------------------------------------------------------------    
    CREATE TABLE #DepBase    
    (    
        RSNNO       INT NOT NULL,    
        HINNO       INT NOT NULL,    
        HIDATE      DATE NULL,    
        HCNCOST     DECIMAL(18,2) NULL,    
        HCNDEPOSIT  DECIMAL(18,2) NULL,    
        RoomBalance DECIMAL(18,2) NULL    
    );    
    
    INSERT INTO #DepBase (RSNNO, HINNO, HIDATE, HCNCOST, HCNDEPOSIT, RoomBalance)    
    SELECT    
        rn.RSNNO,    
        hi.HINNO,    
        CAST(hi.HIDATE AS DATE) AS HIDATE,    
        MAX(CAST(ISNULL(hrtc.HCNCOST,0) AS DECIMAL(18,2))) AS HCNCOST,    
        MAX(CAST(ISNULL(hrtc.HCNDEPOSIT,0) AS DECIMAL(18,2))) AS HCNDEPOSIT,    
        MIN(CAST(ISNULL(hrtc.HCNCOST,0) - ISNULL(hrtc.HCNDEPOSIT,0) AS DECIMAL(18,2))) AS RoomBalance    
    FROM dbo.RESNIGHTS rn    
    JOIN RESERVATIONS m                ON m.RSNNO = rn.RSNNO    
    JOIN dbo.HOTELINVENTORY hi    ON hi.HINNO = rn.HINNO    
    JOIN dbo.HOTELROOMTYPECOSTS hrtc ON hrtc.HINNO = hi.HINNO  
    GROUP BY rn.RSNNO, hi.HINNO, CAST(hi.HIDATE AS DATE);  
    CREATE CLUSTERED INDEX IX_DepBase ON #DepBase(RSNNO, HIDATE, HINNO);    
    
    
 ---------------------------------------------------------------------    
 -- ✅ NEW: Accounting lines (merged subreport) -> aggregated HTML per RSNNO    
 ---------------------------------------------------------------------    
 CREATE TABLE #AcctLine    
 (    
  RSNNO     INT NOT NULL,    
  SortKey   BIGINT NOT NULL,    
  DescTxt   NVARCHAR(400) NOT NULL,    
  AmtTxt    NVARCHAR(60)  NOT NULL    
 );    
    
 -- Header line like Crystal: "Individual Reservation" + 0.00    
 INSERT INTO #AcctLine (RSNNO, SortKey, DescTxt, AmtTxt)    
 SELECT m.RSNNO, 0, N'Individual Reservation', N'0.00'    
 FROM #ResMap m;    
    
 -- Transaction lines from ACTMST (by RSNNO)    
 INSERT INTO #AcctLine (RSNNO, SortKey, DescTxt, AmtTxt)    
 SELECT    
  a.RSNNO,    
  CAST(    
   CASE    
    WHEN ISNULL(a.CMNNO,0) <> 0 THEN 10000000 + ISNULL(a.ACNNO,0)    
    WHEN ISNULL(a.ABNNO,0) <> 0 THEN 20000000 + ISNULL(a.ABNNO,0)    
    WHEN ISNULL(a.RSNNO,0) <> 0 THEN 30000000 + ISNULL(a.ACNNO,0)    
    WHEN ISNULL(a.ACCTXTYPE,'') <> 'GF' THEN 40000000 + ISNULL(a.ACNNO,0)    
    ELSE 50000000 + ISNULL(a.ACNNO,0)    
   END AS BIGINT    
  ) AS SortKey,    
    
  -- "Credit Card Payment - 9005"    
  --ISNULL(NULLIF(LTRIM(RTRIM(a.ACCDSC)),''),'') +    
  --CASE WHEN a.ACNNO IS NOT NULL THEN N' - ' + CAST(a.ACNNO AS NVARCHAR(20)) ELSE N'' END AS DescTxt,    
    
  ISNULL(NULLIF(LTRIM(RTRIM(a.ACCDSC)),''), N'') AS DescTxt,    
    
  -- Transaction Amount (same as your Crystal formula)    
  LTRIM(STR(    
   CASE    
    WHEN a.ACCTXTYPE LIKE 'G_' THEN ISNULL(a.ACNEXTAMT,0)    
    WHEN a.ACCTXTYPE IN ('CA','CH','CR','WI','XI','XO','AD') THEN ISNULL(a.ACNEXTAMT,0) * (-1)    
    WHEN a.ACCTXTYPE = 'RF' THEN ISNULL(a.ACNEXTAMT,0)    
    ELSE 0    
   END    
  , 18, 2)) AS AmtTxt    
 FROM dbo.ACTMST a    
 JOIN #ResMap m ON m.RSNNO = a.RSNNO    
 WHERE a.RSNNO IS NOT NULL    
   AND a.RGNNO IS NOT NULL    
   -- OPTIONAL (agar Crystal me print flag hai):    
   -- AND ISNULL(a.ACNPRTFLG,1) = 1    
 ;    
    
 -- Aggregate to single row per RSNNO    
 CREATE TABLE #AcctAgg    
 (    
  RSNNO          INT NOT NULL PRIMARY KEY,    
  AcctDescHtml   NVARCHAR(MAX) NULL,    
  AcctAmtHtml    NVARCHAR(MAX) NULL    
 );    
    
 INSERT INTO #AcctAgg(RSNNO, AcctDescHtml, AcctAmtHtml)    
SELECT    
    x.RSNNO,    
    
    -- Description HTML (no underline + spacing)    
    (    
        SELECT    
            N'<div style="text-decoration:none; line-height:18px; padding:2px 0;">'    
            + l.DescTxt +    
            N'</div>'    
        FROM #AcctLine l    
        WHERE l.RSNNO = x.RSNNO    
        ORDER BY l.SortKey    
        FOR XML PATH(''), TYPE    
    ).value('.','nvarchar(max)') AS AcctDescHtml,    
    
    -- Amount HTML (no underline + spacing, align right handled by textbox)    
    (    
        SELECT    
            N'<div style="text-decoration:none; line-height:18px; padding:2px 0;">'    
            + l.AmtTxt +    
            N'</div>'    
        FROM #AcctLine l    
        WHERE l.RSNNO = x.RSNNO    
        ORDER BY l.SortKey    
        FOR XML PATH(''), TYPE    
    ).value('.','nvarchar(max)') AS AcctAmtHtml    
    
FROM (SELECT DISTINCT RSNNO FROM #AcctLine) x;    
    
 CREATE INDEX IX_AcctAgg_RSNNO ON #AcctAgg(RSNNO);    
    
    -------------------------------------------------------------------------    
    -- SELECT #1 : Main/Header dataset (UNCHANGED columns)    
    -- ✅ Only appended 4 new columns at END + joined #DepBase    
    -------------------------------------------------------------------------    
    SELECT    
        -- Event    
     e.EMNNO,    
        e.EMCNM,    
        e.EMCREGHDR,    
        e.EMCREGFTR,    
        e.EMCHTLHDR,    
        e.EMCHTLFTR,    
    
        -- Registration    
        rg.RGNNO,    
        rg.RGCPLNM,    
        rg.RGCPFNM,    
        rg.RGCPORG,    
        rg.RGCPPFX,    
        rg.RGCPSFX,    
        rg.RGCEMAIL,    
        rg.RGCPTEL,    
        rg.RGCNO,    
        rg.RGCPAD1,    
        rg.RGCPAD2,    
        rg.RGCPCITY,    
        rg.RGCPST,    
        rg.RGCPZIP,    
        rg.RGCPREGN,    
        rg.RGCPCTRY,    
        rg.RGCCNFTXT,    
        ru.RUNNO,    
    
        -- Category    
        c.CMCCNFHDR,    
        c.CMCCNFFTR,    
    
        -- Reservation    
        r.RSNNO,    
        r.HTNNO,    
        r.RSDTARR,    
        r.RSDTDEP,    
        r.RSDTXLD,    
        r.RSCREQUESTSTRING,    
        r.RSCPERSONCOMMENTS,    
        r.RSCHOTELCOMMENTS,    
        r.RSNMASTERACCOUNT,    
        r.RSCCCTYPE,    
        r.RSCCCEXP,    
        r.RSCCCNO_MSK,    
    
        -- Hotel    
        h.HTCDSC,    
        h.HTCAD1,    
        h.HTCCITY,    
        h.HTCST,    
        h.HTCZIP,    
        h.HTCCNTRY,    
        h.HTNTAXINC,    
        h.HTCACCTYPE,    
        h.HTNMIN_NIGHTS,    
        h.HTNUSE_HOTEL_DEFAULTS,    
        h.HTCTAXCMT,    
        h.HTCXLD,    
        h.HTCFEATURES,    
        h.HTCHDR,    
        h.HTCFTR,    
    
        -- Room    
        rt.RTCDESC,    
        rc.RCCDESC,    
    
        ---------------------------------------------------------------------    
        -- Crystal Formulas (pre-calculated)    
        ---------------------------------------------------------------------    
        CASE WHEN ISNULL(LTRIM(RTRIM(rg.RGCPSFX)),'') <> ''    
             THEN ', ' + LTRIM(RTRIM(rg.RGCPSFX)) ELSE '' END AS PrtSuffix,    
    
        CASE WHEN ISNULL(LTRIM(RTRIM(rg.RGCPPFX)),'') <> ''    
             THEN LTRIM(RTRIM(rg.RGCPPFX)) + ' ' + ISNULL(rg.RGCPFNM,'') + ' ' + ISNULL(rg.RGCPLNM,'')    
                  + CASE WHEN ISNULL(LTRIM(RTRIM(rg.RGCPSFX)),'') <> ''    
                         THEN ', ' + LTRIM(RTRIM(rg.RGCPSFX)) ELSE '' END    
             ELSE ISNULL(rg.RGCPFNM,'') + ' ' + ISNULL(rg.RGCPLNM,'')    
                  + CASE WHEN ISNULL(LTRIM(RTRIM(rg.RGCPSFX)),'') <> ''    
                         THEN ', ' + LTRIM(RTRIM(rg.RGCPSFX)) ELSE '' END    
        END AS FullName,    
    
        CASE WHEN r.RSDTXLD IS NULL THEN 'b' ELSE 'a' END AS CancelFlag,    
    
        CASE    
            WHEN ISNULL(rg.RGCPLNM,'') = '' THEN 'AAAAAAAA' + ISNULL(rg.RGCPFNM,'') + CAST(rg.RGNNO AS VARCHAR(20))    
            WHEN ISNULL(rg.RGCPFNM,'') = '' THEN ISNULL(rg.RGCPLNM,'') + 'AAAAAAA' + CAST(rg.RGNNO AS VARCHAR(20))    
            ELSE ISNULL(rg.RGCPLNM,'') + ISNULL(rg.RGCPFNM,'') + CAST(rg.RGNNO AS VARCHAR(20))    
        END AS NameRegno,    
    
        (CASE WHEN r.RSDTXLD IS NULL THEN 'b' ELSE 'a' END)    
        + CAST(ISNULL(r.HTNNO,0) AS VARCHAR(20))    
        + CAST(r.RSNNO AS VARCHAR(20)) AS HotelRessort,    
    
        DATEDIFF(DAY, r.RSDTARR, r.RSDTDEP) AS NbrNites,    
    
        CASE WHEN ISNULL(LTRIM(RTRIM(h.HTCCITY)),'') = ''    
             THEN ISNULL(h.HTCST,'') + '  ' + ISNULL(h.HTCZIP,'')    
             ELSE h.HTCCITY + ', ' + ISNULL(h.HTCST,'') + '  ' + ISNULL(h.HTCZIP,'')    
        END AS Hotel_CityStZip,    
    
        CASE WHEN ISNULL(r.RSCREQUESTSTRING,'') = '' THEN '' ELSE r.RSCREQUESTSTRING END AS HotelRequests,    
        CASE WHEN ISNULL(r.RSCPERSONCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCPERSONCOMMENTS END AS HotelPersonReq,    
        CASE WHEN ISNULL(r.RSCHOTELCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCHOTELCOMMENTS END AS HotelOnlyRequests,    
    
        CASE    
            WHEN r.RSNMASTERACCOUNT = 1    
                 AND (    
                     (CASE WHEN ISNULL(r.RSCHOTELCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCHOTELCOMMENTS END)    
                   + (CASE WHEN ISNULL(r.RSCPERSONCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCPERSONCOMMENTS END)    
                   + (CASE WHEN ISNULL(r.RSCREQUESTSTRING,'') = '' THEN '' ELSE r.RSCREQUESTSTRING END)    
                 ) <> ''    
                THEN ',  Master Account'    
            WHEN r.RSNMASTERACCOUNT = 1    
                 AND (    
                     (CASE WHEN ISNULL(r.RSCHOTELCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCHOTELCOMMENTS END)    
                   + (CASE WHEN ISNULL(r.RSCPERSONCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCPERSONCOMMENTS END)    
                   + (CASE WHEN ISNULL(r.RSCREQUESTSTRING,'') = '' THEN '' ELSE r.RSCREQUESTSTRING END)    
                 ) = ''    
                THEN 'Master Account'    
            ELSE ''    
        END AS HotelMstrAcctReq,    
    
        (    
          (CASE WHEN ISNULL(r.RSCREQUESTSTRING,'') = '' THEN '' ELSE r.RSCREQUESTSTRING END)    
        + (CASE WHEN ISNULL(r.RSCPERSONCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCPERSONCOMMENTS END)    
        + (CASE    
              WHEN r.RSNMASTERACCOUNT = 1    
                   AND (    
                       (CASE WHEN ISNULL(r.RSCHOTELCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCHOTELCOMMENTS END)    
                     + (CASE WHEN ISNULL(r.RSCPERSONCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCPERSONCOMMENTS END)    
                     + (CASE WHEN ISNULL(r.RSCREQUESTSTRING,'') = '' THEN '' ELSE r.RSCREQUESTSTRING END)    
                   ) <> ''    
                  THEN ',  Master Account'    
              WHEN r.RSNMASTERACCOUNT = 1    
                   AND (    
                       (CASE WHEN ISNULL(r.RSCHOTELCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCHOTELCOMMENTS END)    
                     + (CASE WHEN ISNULL(r.RSCPERSONCOMMENTS,'') = '' THEN '' ELSE ', ' + r.RSCPERSONCOMMENTS END)    
                     + (CASE WHEN ISNULL(r.RSCREQUESTSTRING,'') = '' THEN '' ELSE r.RSCREQUESTSTRING END)    
                   ) = ''    
                  THEN 'Master Account'    
              ELSE ''    
          END)    
        ) AS Hotel_AllSpecialRequests,    
    
        CASE WHEN h.HTNUSE_HOTEL_DEFAULTS = 1 AND h.HTNMIN_NIGHTS IS NOT NULL    
             THEN LEFT(CAST(h.HTNMIN_NIGHTS AS VARCHAR(10)),1) + ' night minimum stay required'    
             ELSE ''    
        END AS MinNights,    
    
        ISNULL(rt.RTCDESC,'') + ' - ' + ISNULL(rc.RCCDESC,'') AS RmCategory,    
    
        CASE WHEN r.RSCCCTYPE IS NULL OR LTRIM(RTRIM(r.RSCCCTYPE)) = ''    
             THEN ''    
             ELSE 'CC Gtd by - ' + UPPER(LTRIM(RTRIM(r.RSCCCTYPE))) + '/' + ISNULL(r.RSCCCNO_MSK,'')    
        END AS CCGtd,    
    
        CASE    
            WHEN ISNULL(LTRIM(RTRIM(r.RSCCCEXP)),'') = '' THEN 'No CC Expiration Date'    
            WHEN r.RSDTARR IS NULL THEN ''    
            WHEN exp.ExpMM IS NULL OR exp.ExpYY IS NULL    
                 OR exp.ExpMM NOT BETWEEN 1 AND 12    
                 OR exp.ExpYY NOT BETWEEN 0 AND 99    
                THEN 'No CC Expiration Date'    
            WHEN DATEADD(DAY, 30, DATEFROMPARTS(2000 + exp.ExpYY, exp.ExpMM, 2)) < CAST(r.RSDTARR AS DATE)    
                THEN 'Card Expired'    
            ELSE ''    
        END AS CCExpTest,    
    
        ISNULL(tx.TotalCharges,0) AS RunFees,    
        ISNULL(tx.PymtsAdj,0)     AS RunPayments,    
    
        CASE WHEN ISNULL(tx.BalanceRaw,0) > 0 THEN ISNULL(tx.BalanceRaw,0) ELSE 0 END AS BalanceAmount,    
    
        CASE    
            WHEN (CASE WHEN ISNULL(tx.BalanceRaw,0) > 0 THEN ISNULL(tx.BalanceRaw,0) ELSE 0 END) > 0 THEN 'Balance Due:'    
            WHEN (CASE WHEN ISNULL(tx.BalanceRaw,0) > 0 THEN ISNULL(tx.BalanceRaw,0) ELSE 0 END) < 0 THEN 'Amount Due'    
            ELSE 'Paid in Full/Balance:'    
        END AS BalanceLabel,    
    
        CASE    
            WHEN ISNULL(tx.MaxACNDSBAMT,0) > 0    
                 AND (CASE WHEN r.RSCCCTYPE IS NULL OR LTRIM(RTRIM(r.RSCCCTYPE)) = '' THEN '' ELSE 'X' END) = ''    
                THEN ISNULL(tx.MaxACNDSBAMT,0)    
            ELSE 0    
        END AS Deposit,    
    
        CASE    
            WHEN (CASE WHEN r.RSCCCTYPE IS NULL OR LTRIM(RTRIM(r.RSCCCTYPE)) = '' THEN '' ELSE 'X' END) <> ''    
                 AND ISNULL(tx.MaxACNDSBAMT,0) <> 0    
                THEN 1    
            ELSE 0    
        END AS Deposit2,    
    
        CASE    
            WHEN (CASE WHEN r.RSCCCTYPE IS NULL OR LTRIM(RTRIM(r.RSCCCTYPE)) = '' THEN '' ELSE 'X' END) = ''    
          AND (CASE WHEN ISNULL(tx.BalanceRaw,0) > 0 THEN ISNULL(tx.BalanceRaw,0) ELSE 0 END) = 0    
                 AND ISNULL(tx.TotalCharges,0) > 0    
                THEN 'Deposit Required'    
            WHEN (CASE WHEN r.RSCCCTYPE IS NULL OR LTRIM(RTRIM(r.RSCCCTYPE)) = '' THEN '' ELSE 'X' END) = ''    
                 AND (CASE WHEN ISNULL(tx.BalanceRaw,0) > 0 THEN ISNULL(tx.BalanceRaw,0) ELSE 0 END) = 0    
                 AND ISNULL(tx.TotalCharges,0) = 0    
                THEN 'No Deposit Required'    
            ELSE ''    
        END AS NoDepositPd,    
    
        CASE WHEN r.RSDTXLD IS NULL THEN '' ELSE '**** Room Cancelled ****' END AS ResCanceledText,    
    
        CASE    
            WHEN DATEDIFF(DAY, r.RSDTARR, r.RSDTDEP) = 0 THEN 0    
            ELSE ISNULL(na.SumHCNCOST,0) / NULLIF(DATEDIFF(DAY, r.RSDTARR, r.RSDTDEP),0)    
        END AS AvgRate,    
    
        CASE WHEN ISNULL(na.CntRNCharge,0) = 0 THEN 0    
             ELSE ISNULL(na.SumRNCharge,0) / NULLIF(na.CntRNCharge,0)    
        END AS DisplayRunRate,    
    
        CASE WHEN ISNULL(na.SumRNCharge,0) = 0    
             THEN 'Please contact Traveling Teams for Rate Information'    
             ELSE ''    
        END AS ZeroRateText,    
    
        ISNULL(tx.TotalCharges,0) AS TotalCharges,    
        ISNULL(tx.PymtsAdj,0)     AS PymtsAdj,    
        CASE WHEN ISNULL(tx.BalanceRaw,0) > 0 THEN ISNULL(tx.BalanceRaw,0) ELSE 0 END AS PaidInFullBalance,    
    
        ---------------------------------------------------------------------    
        -- ✅ ONLY NEW COLUMNS (appended at end)    
        ---------------------------------------------------------------------    
        d.HIDATE,    
        d.HCNCOST,    
        d.HCNDEPOSIT,    
        d.RoomBalance,    
    
    
  aa.AcctDescHtml  AS AcctDescHtml,    
        aa.AcctAmtHtml   AS AcctAmtHtml,    
    
        ISNULL(tx.TotalCharges,0) AS AcctFees,    
        ISNULL(tx.PymtsAdj,0)     AS AcctPymtsAdj,    
        CASE WHEN ISNULL(tx.BalanceRaw,0) > 0 THEN ISNULL(tx.BalanceRaw,0) ELSE 0 END AS AcctPaidInFullBalance    
    
    FROM #ResMap m    
    JOIN dbo.EVENTS e       ON e.EMNNO = 20156    
    JOIN dbo.REGMST rg      ON rg.RGNNO = m.RGNNO    
    LEFT JOIN dbo.REGUSER ru ON ru.RGNNO = rg.RGNNO    
    LEFT JOIN dbo.CATEGORY c ON c.CMNNO = rg.CMNNO    
    JOIN dbo.RESERVATIONS r  ON r.RSNNO = m.RSNNO    
    OUTER APPLY    
    (    
        SELECT    
            TRY_CONVERT(int, NULLIF(LEFT(LTRIM(RTRIM(r.RSCCCEXP)), 2), ''))  AS ExpMM,    
            TRY_CONVERT(int, NULLIF(RIGHT(LTRIM(RTRIM(r.RSCCCEXP)), 2), '')) AS ExpYY    
    ) exp    
    LEFT JOIN dbo.HOTEL h    ON h.HTNNO = r.HTNNO    
    LEFT JOIN dbo.ROOMTYPES rt       ON rt.RTNNO = r.RTNNO    
    LEFT JOIN dbo.ROOMCATEGORIES rc  ON rc.RCNNO = r.RCNNO    
    LEFT JOIN #TxnAgg tx     ON tx.RGNNO = r.RGNNO    
    LEFT JOIN #NightAgg na   ON na.RSNNO = r.RSNNO    
    
    -- ✅ NEW JOIN (makes multiple rows per RSNNO)    
    LEFT JOIN #DepBase d     ON d.RSNNO = r.RSNNO    
    
 LEFT JOIN #AcctAgg aa ON aa.RSNNO = r.RSNNO    
    
  ORDER BY    
    e.EMNNO,    
    CASE    
        WHEN ISNULL(rg.RGCPLNM,'') = '' THEN 'AAAAAAAA' + ISNULL(rg.RGCPFNM,'') + CAST(rg.RGNNO AS VARCHAR(20))    
        WHEN ISNULL(rg.RGCPFNM,'') = '' THEN ISNULL(rg.RGCPLNM,'') + 'AAAAAAA' + CAST(rg.RGNNO AS VARCHAR(20))    
        ELSE ISNULL(rg.RGCPLNM,'') + ISNULL(rg.RGCPFNM,'') + CAST(rg.RGNNO AS VARCHAR(20))    
    END,    
    (    
        (CASE WHEN r.RSDTXLD IS NULL THEN 'b' ELSE 'a' END)    
        + CAST(ISNULL(r.HTNNO,0) AS VARCHAR(20))    
        + CAST(r.RSNNO AS VARCHAR(20))    
    ) DESC,   --  IMPORTANT (Crystal: @HotelRessort - D)    
    
    r.RSNNO,    
    d.HIDATE,    
    d.HINNO;    
    
 END
GO
