          #region ===== Email ========================================================================

          private void SendPdfByEmail(byte[] pdfBytes, string fileName, string toEmail, string subject, string body)
          {
               if (pdfBytes == null || pdfBytes.Length == 0)
                    throw new InvalidOperationException("Cannot send empty PDF attachment.");

               string smtpHost = GetAppSetting("RdlcSmtpHost", "smtp.gmail.com");
               int smtpPort = SafeToInt(GetAppSetting("RdlcSmtpPort", "587"), 587);
               bool enableSsl = IsYes(GetAppSetting("RdlcSmtpEnableSsl", "Yes"));
               string smtpUser = GetAppSetting("RdlcSmtpUser", "");
               string smtpPass = GetAppSetting("RdlcSmtpPass", "");
               string fromEmail = GetAppSetting("RdlcFromEmail", smtpUser);

               if (string.IsNullOrWhiteSpace(fromEmail))
                    throw new InvalidOperationException("SMTP FromEmail is missing.");

               using (MailMessage msg = new MailMessage())
               {
                    msg.From = new MailAddress(fromEmail);
                    msg.To.Add(toEmail);
                    msg.Subject = subject ?? "Room Block Confirmation";
                    msg.Body = body ?? "";
                    msg.IsBodyHtml = false;

                    MemoryStream ms = new MemoryStream(pdfBytes);
                    Attachment att = new Attachment(ms, fileName, "application/pdf");
                    msg.Attachments.Add(att);

                    using (SmtpClient client = new SmtpClient(smtpHost, smtpPort))
                    {
                         client.EnableSsl = enableSsl;

                         if (!string.IsNullOrWhiteSpace(smtpUser))
                              client.Credentials = new NetworkCredential(smtpUser, smtpPass);

                         client.Send(msg);
                    }
               }
          }

