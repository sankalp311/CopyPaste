CREATE   PROCEDURE dbo.sp_ICM_RPT_HotelRoomRatesAndDeposits_RDLC  
(  
    @EMNNO INT = null  
)  
AS  
BEGIN  
    SET NOCOUNT ON;  
  
    SELECT  
        /* ===== PK IDs (only 3) ===== */  
        H.HTNNO,  
        RC.RCNNO,  
        RT.RTNNO,  
  
        /* ===== Group 1 fields ===== */  
        E.EMNNO,  
        E.EMCNM,  
        E.EMDTBEG,  
        E.EMDTEND,  
  
        /* ===== Hotel display + Group 2 key ===== */  
        H.HTCDSC,  
        HotelSort =  
            CASE  
                WHEN H.HTCACRO = 'Request'  
                    THEN 'zzz' + H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                ELSE  
                    H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
            END,  
  
        /* ===== RoomType display + Group 3 key ===== */  
        RoomType =  
            CASE  
                WHEN RC.RCCACRO IS NULL THEN 'N/A'  
                ELSE RC.RCCACRO  
            END,  
  
        RoomTypeSort =  
            (CASE WHEN RC.RCCACRO IS NULL THEN 'N/A' ELSE RC.RCCACRO END)  
            + CONVERT(VARCHAR(20), ISNULL(RC.RCNNO, 0)),  
  
        /* ===== Detail display ===== */  
        RT.RTCACRO,  
  
        /* ===== Crystal formulas (row level) ===== */  
        TotalRmNights =  
            CASE  
                WHEN R.RSNNO IS NULL THEN 0  
                WHEN R.RSDTXLD IS NULL  
                    THEN DATEDIFF(DAY, CONVERT(DATE, R.RSDTARR), CONVERT(DATE, R.RSDTDEP))  
                ELSE 0  
            END,  
  
        DepositRmNights =  
            CASE  
                WHEN R.RSNNO IS NULL THEN 0  
                WHEN H.HTCACCTYPE = 'DA' AND R.RSDTXLD IS NULL  
                    THEN DATEDIFF(DAY, CONVERT(DATE, R.RSDTARR), CONVERT(DATE, R.RSDTDEP))  
                ELSE 0  
            END,  
  
        /* ===== Show cost/deposit/svc only ONCE per (Event+HotelSort+RoomTypeSort) ===== */  
        FirstNightCost =  
            CASE WHEN  
                HI.HIDATE = MIN(HI.HIDATE) OVER (  
                    PARTITION BY  
                        E.EMNNO,  
                        CASE  
                            WHEN H.HTCACRO = 'Request'  
                                THEN 'zzz' + H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                            ELSE  
                                H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                        END,  
                        (CASE WHEN RC.RCCACRO IS NULL THEN 'N/A' ELSE RC.RCCACRO END)  
                        + CONVERT(VARCHAR(20), ISNULL(RC.RCNNO, 0))  
                )  
            THEN HRTC.HCNCOST END,  
  
        FirstNightDeposit =  
            CASE WHEN  
                HI.HIDATE = MIN(HI.HIDATE) OVER (  
                    PARTITION BY  
                        E.EMNNO,  
                        CASE  
                            WHEN H.HTCACRO = 'Request'  
                                THEN 'zzz' + H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                            ELSE  
                                H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                        END,  
                        (CASE WHEN RC.RCCACRO IS NULL THEN 'N/A' ELSE RC.RCCACRO END)  
                        + CONVERT(VARCHAR(20), ISNULL(RC.RCNNO, 0))  
                )  
            THEN HRTC.HCNDEPOSIT END,  
  
        FirstNightSvcChg =  
            CASE WHEN  
                HI.HIDATE = MIN(HI.HIDATE) OVER (  
                    PARTITION BY  
                        E.EMNNO,  
                        CASE  
                            WHEN H.HTCACRO = 'Request'  
                                THEN 'zzz' + H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                            ELSE  
                                H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                        END,  
                        (CASE WHEN RC.RCCACRO IS NULL THEN 'N/A' ELSE RC.RCCACRO END)  
                        + CONVERT(VARCHAR(20), ISNULL(RC.RCNNO, 0))  
                )  
            THEN HRTC.HCNSVCCHG END,  
  
        /* ===== Group totals (calculated in SP, repeated per row in that group) ===== */  
        GroupTotalRmNights =  
            SUM(  
                CASE  
                    WHEN R.RSNNO IS NULL THEN 0  
                    WHEN R.RSDTXLD IS NULL  
                        THEN DATEDIFF(DAY, CONVERT(DATE, R.RSDTARR), CONVERT(DATE, R.RSDTDEP))  
                    ELSE 0  
                END  
            ) OVER (  
                PARTITION BY  
                    E.EMNNO,  
                    CASE  
                        WHEN H.HTCACRO = 'Request'  
                            THEN 'zzz' + H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                        ELSE  
                            H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                    END,  
                    (CASE WHEN RC.RCCACRO IS NULL THEN 'N/A' ELSE RC.RCCACRO END)  
                    + CONVERT(VARCHAR(20), ISNULL(RC.RCNNO, 0))  
            ),  
  
        GroupDepositRmNights =  
            SUM(  
                CASE  
                    WHEN R.RSNNO IS NULL THEN 0  
                    WHEN H.HTCACCTYPE = 'DA' AND R.RSDTXLD IS NULL  
                        THEN DATEDIFF(DAY, CONVERT(DATE, R.RSDTARR), CONVERT(DATE, R.RSDTDEP))  
                    ELSE 0  
                END  
            ) OVER (  
                PARTITION BY  
                    E.EMNNO,  
                    CASE  
                        WHEN H.HTCACRO = 'Request'  
                            THEN 'zzz' + H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                        ELSE  
                            H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
                    END,  
                    (CASE WHEN RC.RCCACRO IS NULL THEN 'N/A' ELSE RC.RCCACRO END)  
                    + CONVERT(VARCHAR(20), ISNULL(RC.RCNNO, 0))  
            )  
  
    FROM ICM.dbo.EVENTS E  
    LEFT JOIN ICM.dbo.HOTEL H  
        ON E.EMNNO = H.EMNNO  
    LEFT JOIN ICM.dbo.HOTELROOMCATEGORIES HRC  
        ON H.HTNNO = HRC.HTNNO  
    LEFT JOIN ICM.dbo.HOTELINVENTORY HI  
        ON HRC.HRNNO = HI.HRNNO  
    LEFT JOIN ICM.dbo.RESERVATIONS R  
        ON HRC.HTNNO = R.HTNNO  
       AND HRC.RCNNO = R.RCNNO  
    LEFT JOIN ICM.dbo.ROOMCATEGORIES RC  
        ON HRC.RCNNO = RC.RCNNO  
    LEFT JOIN ICM.dbo.HOTELROOMTYPECOSTS HRTC  
        ON HI.HINNO = HRTC.HINNO  
    LEFT JOIN ICM.dbo.ROOMTYPES RT  
        ON HRTC.RTNNO = RT.RTNNO  
    WHERE  
        E.EMNNO = @EMNNO  
    ORDER BY  
        E.EMNNO,  
        CASE  
            WHEN H.HTCACRO = 'Request'  
                THEN 'zzz' + H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
            ELSE  
                H.HTCDSC + CONVERT(VARCHAR(20), H.HTNNO)  
        END,  
        (CASE WHEN RC.RCCACRO IS NULL THEN 'N/A' ELSE RC.RCCACRO END)  
        + CONVERT(VARCHAR(20), ISNULL(RC.RCNNO, 0)),  
        HI.HIDATE,  
        RT.RTCACRO;  
  
END  
