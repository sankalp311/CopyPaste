          /// <summary>
          /// Normalizes RDLC path string to an app-relative .rdlc under ~/Report16 if needed.
          /// </summary>
          private static string NormalizeRdlcPath(string raw)
          {
               var p = raw.Replace('\\', '/').Trim();

               // if only a bare name, put it in Report16
               if (!p.Contains("/")) p = "~/Report16/" + p;

               // force .rdlc extension (replaces .rpt or adds missing ext)
               var ext = System.IO.Path.GetExtension(p);
               if (string.IsNullOrEmpty(ext) || ext.Equals(".rpt", StringComparison.OrdinalIgnoreCase))
                    p = System.IO.Path.ChangeExtension(p, ".rdlc");

               // ensure app-relative
               if (!p.StartsWith("~")) p = "~/" + p.TrimStart('/');

               return p;
          }

          /// <summary>
          /// Exports a DataSet to XLSX via ClosedXML and streams to browser.
          /// </summary>
          private void ExportDataSetToXlsx(DataSet ds, string downloadFile = "Report.xlsx")
          {
               TraceLog($"ENTER ExportDataSetToXlsx | Tables={ds?.Tables.Count} | name={downloadFile}", stage: "ENTER");

               // helper: log to App_Data/logs/report_errors.txt
               void LogLine(string stage, string message, Exception ex = null)
               {
                    try
                    {
                         string logDir = Server.MapPath("~/App_Data/logs");
                         Directory.CreateDirectory(logDir);

                         string logFile = Path.Combine(logDir, "report_errors.txt");

                         var stamp = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);
                         using (var sw = new StreamWriter(logFile, true))
                         {
                              sw.WriteLine("==== " + stamp + " ====");
                              sw.WriteLine("Stage: " + stage);
                              sw.WriteLine("DownloadName: " + downloadFile);
                              if (!string.IsNullOrWhiteSpace(message))
                                   sw.WriteLine("Message: " + message);

                              if (ex != null)
                              {
                                   sw.WriteLine("Exception: " + ex.GetType().FullName);
                                   sw.WriteLine("Error: " + ex.Message);
                                   sw.WriteLine("Stack: " + ex.StackTrace);
                              }

                              sw.WriteLine();
                         }
                    }
                    catch
                    {
                         // swallow logging issues
                    }
               }

               if (ds == null || ds.Tables.Count == 0)
               {
                    LogLine("ExportStart", "No rows to export (empty DataSet).");
                    WriteAndEnd("No rows to export.");
                    return;
               }

               try
               {
                    LogLine("ExportStart", "Building workbook from DataSet with " + ds.Tables.Count + " tables.");

                    using (var wb = new XLWorkbook())
                    {
                         int idx = 1;
                         foreach (DataTable t in ds.Tables)
                         {
                              // Worksheet name: prefer TableName, fallback to Table1/Table2/...
                              string wsName = string.IsNullOrWhiteSpace(t.TableName)
                                  ? $"Table{idx}"
                                  : SanitizeWsName(t.TableName);

                              var ws = wb.Worksheets.Add(wsName);

                              // dump table with headers
                              ws.Cell(1, 1).InsertTable(t, true);

                              // auto-fit for readability
                              ws.Columns().AdjustToContents();

                              idx++;
                         }

                         using (var ms = new MemoryStream())
                         {
                              wb.SaveAs(ms);
                              var bytes = ms.ToArray();

                              // Optional JS handshake cookie
                              var token = Request.Form["dlToken"];
                              if (!string.IsNullOrEmpty(token))
                              {
                                   var cookie = new HttpCookie("fileDownloadToken", token)
                                   {
                                        Path = "/",
                                        HttpOnly = false,
                                        Secure = Request.IsSecureConnection,
                                        SameSite = SameSiteMode.Lax
                                   };
                                   Response.Cookies.Add(cookie);
                              }

                              // Send to browser
                              Response.Clear();
                              Response.TrySkipIisCustomErrors = true;
                              Response.Buffer = true;
                              Response.BufferOutput = true;

                              Response.Cache.SetCacheability(HttpCacheability.NoCache);
                              Response.Cache.SetNoStore();
                              Response.Cache.SetExpires(DateTime.UtcNow.AddMinutes(-1));

                              Response.ContentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                              Response.AddHeader("Content-Disposition", $"attachment; filename=\"{downloadFile}\"");

                              // No Content-Length header (same IIS compression reasoning)
                              Response.BinaryWrite(bytes);
                              Response.Flush();

                              //LogLine("ExportSuccess", "Workbook sent. Bytes=" + bytes.Length);

                              HttpContext.Current.ApplicationInstance.CompleteRequest();
                         }
                    }
               }
               catch (Exception ex)
               {
                    Exception root = ex;
                    while (root.InnerException != null) root = root.InnerException;

                    LogLine("ExportFail", "Exception during workbook build/send.", root);

                    Response.Clear();
                    Response.TrySkipIisCustomErrors = true;
                    Response.StatusCode = 500;
                    Response.ContentType = "text/plain";
                    Response.Write(root.Message);
                    HttpContext.Current.ApplicationInstance.CompleteRequest();
                    return;
               }

               TraceLog("EXIT ExportDataSetToXlsx", stage: "EXIT");
          }

          /// <summary>
          /// Ensures Excel worksheet names are valid (<=31 chars, no special characters).
          /// </summary>
          private string SanitizeWsName(string name)
          {
               var invalid = new[] { ':', '\\', '/', '?', '*', '[', ']' };
               foreach (var c in invalid) name = name.Replace(c.ToString(), "");
               if (name.Length == 0) name = "Sheet";
               return name.Length > 31 ? name.Substring(0, 31) : name;
          }

