document.addEventListener("DOMContentLoaded", function () {

     // safety check
     if (typeof flatpickr === "undefined") {
          console.error("flatpickr not loaded");
          return;
     }

     const fromEl = document.getElementById("txtFromDate");
     const toEl = document.getElementById("txtToDate");

     if (!fromEl || !toEl) {
          console.error("Date inputs not found");
          return;
     }

     // ✅ real calendar picker
     window.fpFrom = flatpickr(fromEl, {
          dateFormat: "m/d/Y",
          allowInput: false,
          clickOpens: true,
          defaultDate: fromEl.value
     });

     window.fpTo = flatpickr(toEl, {
          dateFormat: "m/d/Y",
          allowInput: false,
          clickOpens: true,
          defaultDate: toEl.value
     });
});


// wwwroot/js/ht152.js
(function () {

  const ALERT_AUTO_HIDE_MS = 2500;

  function showOverlay() {
    const el = document.getElementById("Processing");
    if (el) el.style.display = "flex";
  }

  function hideOverlay() {
    const el = document.getElementById("Processing");
    if (el) el.style.display = "none";
  }

  // ✅ Global so your button onclick works
  window.HT152_ShowAlert = function (message, type) {
    const box = document.getElementById("ht152Alert");
    const txt = document.getElementById("ht152AlertText");
    const ico = document.getElementById("ht152AlertIcon");
    if (!box || !txt || !ico) return;

    box.classList.remove("error", "info", "success");
    box.classList.add(type || "info");

    ico.textContent = (type === "success") ? "✅" : (type === "error") ? "⚠️" : "ℹ️";
    txt.textContent = message;

    box.style.display = "flex";
    requestAnimationFrame(() => box.classList.add("show"));

    // ✅ auto-hide in 2.5 sec
    clearTimeout(window.__ht152AlertTimer);
    window.__ht152AlertTimer = setTimeout(() => window.HT152_HideAlert(), ALERT_AUTO_HIDE_MS);
  };

  // ✅ Global so close button onclick works
  window.HT152_HideAlert = function () {
    const box = document.getElementById("ht152Alert");
    if (!box) return;

    clearTimeout(window.__ht152AlertTimer);

    box.classList.remove("show");
    setTimeout(() => { box.style.display = "none"; }, 220);
  };

  // ✅ reusable binder
  window.HT152_BindHistory = function (history) {
    const box = document.getElementById("HT152ReportHistory");
    if (!box) return;

    box.innerHTML = "";

    if (!history || history.length === 0) {
      box.innerHTML = `
        <div class="ht152-item">
          <div class="ht152-type">-</div>
          <div class="ht152-name">No history found for this hotel.</div>
          <div class="ht152-action"></div>
        </div>`;
      return;
    }

    // header row
    const header = document.createElement("div");
    header.className = "ht152-item ht152-header";
    header.innerHTML = `
      <div class="ht152-type">Report Type</div>
      <div class="ht152-name">Report Name</div>
    `;
    box.appendChild(header);

    history.forEach(r => {
      const type = r.rpttype ?? r.RPTTYPE ?? "";
      const url = r.rpturl ?? r.RPTURL ?? "";
      const name = r.rptname ?? r.RPTNAME ?? "";

      const displayRaw = (name && name.trim()) ? name : url;
      const display = String(displayRaw).split(/[\\/]/).pop();

      const div = document.createElement("div");
      div.className = "ht152-item";
      div.innerHTML = `
        <div class="ht152-type">${type}</div>
        <div class="ht152-name">${display}</div>
      `;
      box.appendChild(div);
    });
  };

 

  // ✅ On hotel change
  window.HT152_OnHotelChange = async function () {
    const hotelId = parseInt(document.getElementById("ddlHotelList").value || "0", 10);

      HotelDetailsWithRFP(hotelId);
    if (!hotelId) {
      window.HT152_BindHistory([]);
      return;
    }

    const res = await fetch("/Admin/ReportHT152/GetDefaultFromTo", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ hotelId })
    });

    const data = await res.json();
    if (!data) return;

    const fromDate = data.fromDate || data.FromDate || "";
    const toDate = data.toDate || data.ToDate || "";

    document.getElementById("txtFromDate").value = fromDate;
    document.getElementById("txtToDate").value = toDate;

    if (window.fpFrom && fromDate) window.fpFrom.setDate(fromDate, true, "m/d/Y");
    if (window.fpTo && toDate) window.fpTo.setDate(toDate, true, "m/d/Y");

    document.getElementById("ddlFrmHour").value = data.frmHour || data.FrmHour || "12";
    document.getElementById("ddlFrmMin").value = data.frmMin || data.FrmMin || "00";
    document.getElementById("ddlFrmAmPM").value = data.frmAmPm || data.FrmAmPm || "AM";

    document.getElementById("ddlToHour").value = data.toHour || data.ToHour || "12";
    document.getElementById("ddlToMin").value = data.toMin || data.ToMin || "00";
    document.getElementById("ddlToAmPM").value = data.toAmPm || data.ToAmPm || "AM";

    window.HT152_BindHistory(data.history || data.History || []);
  };

  // ✅ Generate report (no window.open)
  window.HT152_Process = async function () {
    const hotelVal = (document.getElementById("ddlHotelList").value || "").trim();
    const hotelId = parseInt(hotelVal || "0", 10);

    if (!hotelId) {
      window.HT152_ShowAlert("Please select a hotel before generating the report.", "error");
      return;
    }

    const chkNew = document.getElementById("ChkNew").checked;
    const chkChanged = document.getElementById("ChkChanged").checked;
    const chkCanceled = document.getElementById("ChkCanceled").checked;

    if (!chkNew && !chkChanged && !chkCanceled) {
      window.HT152_ShowAlert("Please select at least one Report Type (New / Changed / Canceled).", "error");
      return;
    }

    window.HT152_HideAlert();
    showOverlay();

    const payload = {
      hotelId: hotelId,
      fromDate: document.getElementById("txtFromDate").value,
      toDate: document.getElementById("txtToDate").value,

      frmHour: document.getElementById("ddlFrmHour").value,
      frmMin: document.getElementById("ddlFrmMin").value,
      frmAmPm: document.getElementById("ddlFrmAmPM").value,

      toHour: document.getElementById("ddlToHour").value,
      toMin: document.getElementById("ddlToMin").value,
      toAmPm: document.getElementById("ddlToAmPM").value,

      chkNew: chkNew,
      chkChanged: chkChanged,
      chkCanceled: chkCanceled,

      reportid: 0
    };

    try {
      const res = await fetch("/Admin/ReportHT152/Process", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      window.HT152_BindHistory(data.history || data.History || []);

      // ✅ auto-hide success alert in 2.5 sec
      window.HT152_ShowAlert("Report generated and saved in history.", "success");
    } catch (e) {
      window.HT152_ShowAlert("Something went wrong while generating the report. Please try again.", "error");
    } finally {
      hideOverlay();
    }
  };

  function initFlatpickr() {
    if (typeof flatpickr === "undefined") {
      console.error("flatpickr not loaded");
      return;
    }

    const fromEl = document.getElementById("txtFromDate");
    const toEl = document.getElementById("txtToDate");
    if (!fromEl || !toEl) return;

    window.fpFrom = flatpickr(fromEl, {
      dateFormat: "m/d/Y",
      allowInput: false,
      clickOpens: true,
      defaultDate: fromEl.value
    });

    window.fpTo = flatpickr(toEl, {
      dateFormat: "m/d/Y",
      allowInput: false,
      clickOpens: true,
      defaultDate: toEl.value
    });
  }

  document.addEventListener("DOMContentLoaded", function () {
    initFlatpickr();

    const ddl = document.getElementById("ddlHotelList");
    if (ddl) ddl.addEventListener("change", window.HT152_OnHotelChange);

    window.HT152_OnHotelChange();
  });
})();


async function HotelDetailsWithRFP(hotelId) {

    const HotelRequest = {
        HotelId: hotelId,
    };

    const res = await fetch("/Admin/ReportHT152/HotelDetailsWithRFP", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(HotelRequest)
    });

    const data = await res.json();
    if (!data || data.length === 0) return;

    const panel = document.getElementById("mergePanelWrap");

    // Hide initially
    panel.style.display = "none";

    if (data.length > 1) {

        // 👉 Get main event (first record)
        const mainEvent = data[0].emcno; // or use emnno

        // 👉 Split data
        const sameEventHotels = data.filter(d => d.emcno === mainEvent);
        const crossEventHotels = data.filter(d => d.emcno !== mainEvent);

        panel.removeAttribute("hidden");
        panel.style.display = "block";

        let html = '';

        // ================= PANEL HEADER =================
        html += `
            <div class="merge-panel-head">
                <div class="merge-panel-title">⤢ Related hotel versions detected</div>
                <div class="merge-panel-subtitle">
                    Select the versions you want to include in your merged rooming list.
                </div>
            </div>
        `;

        // ================= SAME EVENT SECTION =================
        html += `<div class="merge-panel-body" id="mergeHotelList">`;

        sameEventHotels.forEach((d, index) => {

            let isPrimary = index === 0 ? 'is-primary is-checked' : '';
            let isDisabled = index === 0 ? 'disabled checked' : '';

            html += `
                <div class="merge-hotel-item ${isPrimary}" data-id="${d.htnno}">
                    <input type="checkbox" ${isDisabled}>
                    <div class="hotel-info">
                        <div class="hotel-name">${d.htcdsc || ''}</div>
                        <div class="hotel-meta">
                            <span class="rfp-badge-inline">RFP: ${d.htcrfpid || ''}</span>
                        </div>
                    </div>
                </div>
            `;
        });

        html += `</div>`; // close body

        // ================= SUMMARY =================
        

        // ================= CROSS EVENT SECTION =================
        if (crossEventHotels.length > 0) {

            html += `<div class="merge-section-divider cross-divider">Different Event</div>`;

            crossEventHotels.forEach(d => {
                html += `
                    <div class="merge-hotel-item is-cross" data-id="${d.htnno}">
                        <input type="checkbox">
                        <div class="hotel-info">
                            <div class="hotel-name">${d.htcdsc || ''}</div>
                            <div class="hotel-meta">
                                <span class="rfp-badge-inline">RFP: ${d.htcrfpid || ''}</span>
                            </div>
                        </div>
                        <span class="event-tag">Event: ${d.emcno || ''}</span>
                    </div>
                `;
            });
        }
        html += `
            <div class="merge-summary show" id="mergeSummary">
                <strong>Selected for merge:</strong>
                <div class="merge-chips" id="mergeSummaryChips">
                    <span class="merge-chip">
                        ${sameEventHotels.length > 0 ? sameEventHotels[0].htcdsc : ''}
                    </span>
                </div>
            </div>
        `;
        // ================= RENDER =================
        panel.innerHTML = html;

        panel.addEventListener("change", function (e) {

            if (e.target.type === "checkbox") {

                // ❌ جلوگیری cross-event selection (optional)
               

                updateSelectedHotels();
            }
        });


       
        function updateSelectedHotels() {

            const chipsContainer = panel.querySelector("#mergeSummaryChips");
            chipsContainer.innerHTML = "";

            const selectedItems = panel.querySelectorAll(".merge-hotel-item input[type='checkbox']:checked");

            selectedItems.forEach(cb => {
                const parent = cb.closest(".merge-hotel-item");
                const hotelName = parent.querySelector(".hotel-name").innerText;
                const hotelId =parent.querySelector(".hotel-name").closest(".merge-hotel-item").dataset.id
                const eventCode = parent.querySelector(".event-tag")?.innerText || "";

                const chip = document.createElement("span");

                // 👉 Check if cross-event
                if (parent.classList.contains("is-cross")) {
                    chip.className = "merge-chip cross-chip";
                    chip.innerText = `${hotelName} (${eventCode.replace("Event: ", "")})`;
                } else {
                    chip.className = "merge-chip";
                    chip.value = hotelId;
                    chip.innerText = hotelName;
                }

                chipsContainer.appendChild(chip);
            });
        }

        // 👉 Initialize default selection
        updateSelectedHotels();
        document.getElementById("btnGenerate").style.display = "block";
        document.getElementById("btnGenerateHotel").style.display = "none";
    }

    
    document.getElementById("btnGenerate").style.display = "block";
   
}


