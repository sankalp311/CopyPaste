          private IEnumerable<(string Value, string Text)> QueryPairsValueText(string cs, string sql, params SqlParameter[] args)
          {
               using (var con = new SqlConnection(cs))
               using (var cmd = new SqlCommand(sql, con))
               {
                    if (args != null && args.Length > 0) cmd.Parameters.AddRange(args);
                    con.Open();
                    using (var r = cmd.ExecuteReader())
                    {
                         while (r.Read())
                         {
                              string value = Convert.ToString(r.GetValue(0));
                              string text = Convert.ToString(r.GetValue(1));
                              yield return (value, text);
                         }
                    }
               }
          }

          private static string ToDatetimeLocal(string s)
          {
               if (DateTime.TryParse(s, out var dt)) return dt.ToString("yyyy-MM-ddTHH:mm");
               return DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
          }

