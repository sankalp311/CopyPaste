CREATE PROCEDURE dbo.TT_EIRExp  
/******************************************************************************************  
-- Author      : Sankalp Mishra  
-- Company     : Jsimple  
-- Project     : ICM (Crystal to RDLC Conversion)  
-- File Name   : rpt_TT_EconomicImpact_Summary.sql  
--  
-- Description :  
--   Hotel-level summary for "Economic Impact Report" (RDLC),  
--   using the same logic as the Crystal report.  
--  
--   Base dataset = Crystal SQL:  
--     RESNIGHTS  
--       INNER JOIN ( EVENTS  
--                    INNER JOIN REGMST  
--                    INNER JOIN RESERVATIONS )   
--       INNER JOIN HOTELINVENTORY  
--       INNER JOIN HOTEL  
--       LEFT  JOIN ROOMTYPES  
--       INNER JOIN ROOMCATEGORIES  
--  
--   Record selection:  
--     EVENTS.EMNNO = @EMNNO  
--     AND RESERVATIONS.RSDTXLD IS NULL       -- isnull({RESERVATIONS.RSDTXLD})  
--  
--   Step 1: Per reservation (@NameRegno) within each hotel:  
--     NbrNitesPerRes   = RSDTDEP - RSDTARR  
--     RevenuePerRes    = Sum(RNMPERNIGHTCHARGE, NameRegno)  
--  
--   Step 2: Per hotel (@HotelSort):  
--     Pickup           = Sum(NbrNitesPerRes)  
--     HotelRevenue     = Sum(RevenuePerRes)  
--     AvgRate-Hotel    = HotelRevenue / Pickup  
--  
--   Event-level:  
--     DisplayResCountEvent = COUNT(DISTINCT RSNNO)   -- #RunResCountEvent  
--  
--   Output: ONE ROW PER HOTEL.  
******************************************************************************************/  
    @EMNNO INT  
AS  
BEGIN  
    SET NOCOUNT ON;  
  
    ----------------------------------------------------------------------------  
    -- 1) RAW CTE = EXACT Crystal recordset (DISTINCT + same joins + filter)  
    ----------------------------------------------------------------------------  
    ;WITH Raw AS  
    (  
        SELECT DISTINCT  
            rm.RGCPLNM,  
            rm.RGCPFNM,  
            rm.RGNNO,  
            e.EMNNO,  
            e.EMCNM,  
            r.RSNNO,  
            r.RSDTARR,  
            r.RSDTDEP,  
            r.RSDTXLD,  
            --rc.RCCACRO,  
            h.HTCDSC,  
            rn.RNMPERNIGHTCHARGE,  
            hi.HIDATE,  
            --rt.RTCACRO,  
            r.RSCCCTYPE,  
            h.HTNNO,  
            rn.HINNO,  
            e.EMDTBEG,  
            e.EMDTEND  
        FROM ICM.dbo.RESNIGHTS       rn  
        INNER JOIN ICM.dbo.RESERVATIONS  r   ON rn.RSNNO = r.RSNNO  
        INNER JOIN ICM.dbo.REGMST        rm  ON rm.RGNNO = r.RGNNO  
        INNER JOIN ICM.dbo.EVENTS        e   ON e.EMNNO = rm.EMNNO  
        INNER JOIN ICM.dbo.HOTELINVENTORY hi ON rn.HINNO = hi.HINNO  
        INNER JOIN ICM.dbo.HOTEL         h   ON r.HTNNO = h.HTNNO  
        --INNER  JOIN ICM.dbo.ROOMTYPES     rt  ON r.RTNNO = rt.RTNNO  
        --INNER JOIN ICM.dbo.ROOMCATEGORIES rc ON r.RCNNO = rc.RCNNO  
        WHERE  
            e.EMNNO = @EMNNO  
             AND r.RSDTXLD IS NOT NULL              -- isnull({RESERVATIONS.RSDTXLD})  
    ),  
  
    ----------------------------------------------------------------------------  
    -- 2) Per-reservation aggregation (Crystal @NameRegno level)  
    ----------------------------------------------------------------------------  
    ResAgg AS  
    (  
        SELECT  
            -- keys  
            r.EMNNO,  
            r.EMCNM,  
            r.HTNNO,  
            r.HTCDSC,  
            r.RSNNO,  
            r.RGNNO,  
  
            -- hotel / event dates (same for all rows in group)  
            EMDTBEG = MAX(r.EMDTBEG),  
            EMDTEND = MAX(r.EMDTEND),  
  
            -- NbrNites = RSDTDEP - RSDTARR  
            NbrNitesPerRes =  
                DATEDIFF(DAY, MIN(r.RSDTARR), MAX(r.RSDTDEP)),  
  
            -- Revenue per reservation = Sum(RNMPERNIGHTCHARGE, NameRegno)  
            RevenuePerRes =  
                SUM(ISNULL(r.RNMPERNIGHTCHARGE, 0.0))  
        FROM Raw r  
        GROUP BY  
            r.EMNNO,  
            r.EMCNM,  
            r.HTNNO,  
            r.HTCDSC,  
            r.RSNNO,  
            r.RGNNO  
    ),  
  
    ----------------------------------------------------------------------------  
    -- 3) Hotel-level aggregation (Crystal @HotelSort group)  
    ----------------------------------------------------------------------------  
    HotelAgg AS  
    (  
        SELECT  
            EMNNO,  
            EMCNM       = MAX(EMCNM),  
            HTNNO,  
            HTCDSC      = MAX(HTCDSC),  
            EMDTBEG     = MAX(EMDTBEG),  
            EMDTEND     = MAX(EMDTEND),  
  
            -- Pickup = Sum of NbrNitesPerRes (RunResNites at Hotel group)  
            Pickup      = SUM(ISNULL(NbrNitesPerRes, 0)),  
  
            -- HotelRevenue = Sum of RevenuePerRes (RunRevenue-Hotel)  
            HotelRevenue = SUM(ISNULL(RevenuePerRes, 0.0))  
        FROM ResAgg  
        GROUP BY  
            EMNNO,  
            HTNNO  
    ),  
  
    ----------------------------------------------------------------------------  
    -- 4) Event-level reservation count (DisplayResCountEvent / RunResCountEvent)  
    ----------------------------------------------------------------------------  
    EventAgg AS  
    (  
        SELECT  
            EMNNO,  
            DisplayResCountEvent = COUNT(DISTINCT RSNNO)  
        FROM ResAgg  
        GROUP BY EMNNO  
    )  
  
    ----------------------------------------------------------------------------  
    -- 5) Final result – ONE ROW PER HOTEL  
    ----------------------------------------------------------------------------  
    SELECT  
        h.EMNNO,  
        h.EMCNM,  
        h.HTNNO,  
        h.HTCDSC,  
        -- Crystal prints dates via formatting; here we send MM/dd/yyyy strings  
        CONVERT(varchar(10), h.EMDTBEG, 101) AS EMDTBEG,  
        CONVERT(varchar(10), h.EMDTEND, 101) AS EMDTEND,  
        h.Pickup,  
  
        -- AvgRate-Hotel = HotelRevenue / Pickup  
        AvgRate_Hotel =  
            CASE  
                WHEN h.Pickup = 0 THEN 0  
                ELSE CAST(h.HotelRevenue AS decimal(18,2))  
                     / NULLIF(h.Pickup, 0)  
            END,  
  
        h.HotelRevenue,  
        ISNULL(e.DisplayResCountEvent, 0) AS DisplayResCountEvent  
    FROM HotelAgg h  
    LEFT JOIN EventAgg e  
        ON e.EMNNO = h.EMNNO  
    ORDER BY  
        h.EMNNO,  
        UPPER(LTRIM(RTRIM(h.HTCDSC))),  
        h.HTNNO;  
END;  
