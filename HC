CREATE PROCEDURE [dbo].[SP_ICM_ACO_DETAILS_HT156RDLC]       
 @STATUS NVARCHAR(30) = ''      
 ,@FROM DATETIME = NULL      
 ,@TO DATETIME = NULL      
 ,@ADDREQUEST NVARCHAR(25) = NULL      
AS      
BEGIN      
 IF (@FROM IS NOT NULL)      
 BEGIN      
  SET @TO = dateadd(dd, 1, @TO)      
 END      
      
 IF (      
   @ADDREQUEST IS NULL      
   OR @ADDREQUEST = ''      
   )      
 BEGIN      
  IF (      
    @FROM IS NULL      
    AND @TO IS NULL      
    )      
  BEGIN      
   WITH InsuranceCTE      
   AS (      
    SELECT CASE       
      WHEN activity_booking.abncanceled = 1      
       THEN 'NO'      
      ELSE 'YES'      
      END AS Insurance      
     ,RGNNO      
     ,ROW_NUMBER() OVER (      
      PARTITION BY RGNNO ORDER BY CASE       
        WHEN activity_booking.abncanceled = 1      
         THEN 0      
        ELSE 1      
        END DESC      
      ) AS rn      
    FROM Activity_Booking      
    RIGHT JOIN Activity ON Activity_Booking.avnno = Activity.avnno      
     AND AVNHOTEL = 1      
    )      
   SELECT EVENTS.EMNNO      
    ,EMCNM      
    ,EMCACRO      
    ,EMCNO      
    ,CONVERT(NVARCHAR(20), EMDTBEG, 101) EMDTBEG      
    ,CONVERT(NVARCHAR(20), EMDTEND, 101) EMDTEND      
    ,HOTEL.HTNNO      
    ,HTCDSC      
    ,HTCACRO      
    ,'' AS Roomcategory      
    ,'' AS RSCHOTELCOMMENTS      
    ,HTCAD1      
    ,HTCCITY      
    ,HTCST      
    ,HTCTEL      
    ,HTCSLETEL      
    ,HTCSLENM      
    ,HTCSLEEMAIL      
    ,HTCSLETLE      
    ,HTCSLEFAX      
    ,RGCPLNM      
    ,RGCPFNM      
    ,RGCNO      
    ,REGMST.RGNNO      
    ,RGCPMI      
    ,RGCPPFX      
    ,RGDTMDY      
    ,RGCPSFX      
    ,RGCNIKNM      
    ,RGCPTLE      
    ,RGCPORG      
    ,RGCPAD1      
    ,RGCPAD2      
    ,RGCPCITY      
    ,RGCPST      
    ,RGCPZIP      
    ,RGCPCTRY      
    ,RGCPREGN      
    ,RGCBEMAIL      
    ,RGCEMAIL      
    ,CONVERT(NVARCHAR(20), RGDTADD, 101) RGDTADD1      
   -- ,CONVERT(NVARCHAR(30), RGD_ACO_CREATE_TIME, 101) RGDTADD      
   ,FORMAT(CAST(RGD_ACO_CREATE_TIME AS DATETIME), 'MM/dd/yyyy hh:mm tt') as  RGDTADD  
    ,RGCHTEL      
    ,RGCHFAX      
    ,RGCPTEL      
    ,RGN_ACO_HTNNO      
    ,CONVERT(NVARCHAR(20), RGD_ACO_ARR, 101) RGD_ACO_ARR      
    ,CONVERT(NVARCHAR(20), RGD_ACO_DEP, 101) RGD_ACO_DEP      
    ,RGN_ACO_ROOMS      
    ,RGC_ACO_CCTYPE      
    ,RGC_ACO_CC      
    ,RGC_ACO_CCEXP      
    ,RGC_ACO_CCNAME      
    ,RGC_ACO_STATUS      
    ,RGC_ACO_AGENT_NOTES      
    ,RGC_ACO_SPCL_REQUESTS      
    ,0 AS RSNNO      
    ,'' AS RSDTXLD      
    ,RGC_ACO_BLOCKCODE      
    ,isnull(InsuranceCTE.Insurance, 'NO') Insurance      
   FROM REGMST      
   INNER JOIN EVENTS ON EVENTS.EMNNO = REGMST.EMNNO      
   LEFT JOIN HOTEL ON REGMST.RGN_ACO_HTNNO = HOTEL.HTNNO      
   LEFT JOIN InsuranceCTE ON InsuranceCTE.RGNNO = REGMST.RGNNO      
    AND InsuranceCTE.rn = 1      
   WHERE   
   --RGC_ACO_CCTYPE IS NOT NULL      
   -- AND RGC_ACO_CC IS NOT NULL      
    --AND RGC_ACO_CCEXP IS NOT NULL      
    --AND RGC_ACO_CCNAME IS NOT NULL      
     RGC_ACO_STATUS LIKE '%' + @STATUS + '%'      
    AND (      
     RGC_ACO_ADD_REQUEST IS NULL      
     OR RGC_ACO_ADD_REQUEST LIKE '%' + @ADDREQUEST + '%'      
     )      
   ORDER BY EMDTBEG      
    ,EMCNO      
    ,HTCDSC      
    ,RGD_ACO_CREATE_TIME      
    ,RGCPLNM      
    ,RGCPFNM      
    ,RGCNO      
  END      
  ELSE      
  BEGIN      
   WITH InsuranceCTE      
   AS (      
    SELECT CASE       
      WHEN activity_booking.abncanceled = 1      
       THEN 'NO'      
      ELSE 'YES'      
      END AS Insurance      
     ,RGNNO      
     ,ROW_NUMBER() OVER (      
      PARTITION BY RGNNO ORDER BY CASE       
        WHEN activity_booking.abncanceled = 1      
         THEN 0      
        ELSE 1      
        END DESC      
      ) AS rn      
    FROM Activity_Booking      
    RIGHT JOIN Activity ON Activity_Booking.avnno = Activity.avnno      
     AND AVNHOTEL = 1      
    )      
   SELECT EVENTS.EMNNO      
    ,EMCNM      
    ,EMCACRO      
    ,EMCNO      
    ,CONVERT(NVARCHAR(20), EMDTBEG, 101) EMDTBEG      
    ,CONVERT(NVARCHAR(20), EMDTEND, 101) EMDTEND      
    ,HOTEL.HTNNO      
    ,HTCDSC      
    ,HTCACRO      
    ,'' AS Roomcategory      
    ,'' AS RSCHOTELCOMMENTS      
    ,HTCAD1      
    ,HTCCITY      
    ,HTCST      
    ,HTCTEL      
    ,HTCSLETEL      
    ,HTCSLENM      
    ,HTCSLEEMAIL      
    ,HTCSLETLE      
    ,HTCSLEFAX      
    ,RGCPLNM      
    ,RGCPFNM     
    ,RGCNO      
    ,REGMST.RGNNO      
    ,RGCPMI      
    ,RGCPPFX      
    ,RGDTMDY      
    ,RGCPSFX      
    ,RGCNIKNM      
    ,RGCPTLE      
    ,RGCPORG      
    ,RGCPAD1      
    ,RGCPAD2      
    ,RGCPCITY      
    ,RGCPST      
    ,RGCPZIP      
    ,RGCPCTRY      
    ,RGCPREGN      
    ,RGCBEMAIL      
    ,RGCEMAIL      
    ,CONVERT(NVARCHAR(20), RGDTADD, 101) RGDTADD1      
    --,CONVERT(NVARCHAR(30), RGD_ACO_CREATE_TIME, 101) RGDTADD      
 ,FORMAT(CAST(RGD_ACO_CREATE_TIME AS DATETIME), 'MM/dd/yyyy hh:mm tt') as RGDTADD  
    ,RGCHTEL      
    ,RGCHFAX      
    ,RGCPTEL      
    ,RGN_ACO_HTNNO      
    ,CONVERT(NVARCHAR(20), RGD_ACO_ARR, 101) RGD_ACO_ARR      
    ,CONVERT(NVARCHAR(20), RGD_ACO_DEP, 101) RGD_ACO_DEP      
    ,RGN_ACO_ROOMS      
    ,RGC_ACO_CCTYPE      
    ,RGC_ACO_CC      
    ,RGC_ACO_CCEXP      
    ,RGC_ACO_CCNAME      
    ,RGC_ACO_STATUS      
    ,RGC_ACO_AGENT_NOTES      
    ,RGC_ACO_SPCL_REQUESTS      
    ,0 AS RSNNO      
    ,'' AS RSDTXLD      
    ,RGC_ACO_BLOCKCODE      
    ,isnull(InsuranceCTE.Insurance, 'NO') Insurance      
   FROM REGMST      
   INNER JOIN EVENTS ON EVENTS.EMNNO = REGMST.EMNNO      
   LEFT JOIN HOTEL ON REGMST.RGN_ACO_HTNNO = HOTEL.HTNNO      
   LEFT JOIN InsuranceCTE ON InsuranceCTE.RGNNO = REGMST.RGNNO      
    AND InsuranceCTE.rn = 1      
   WHERE   
   --RGC_ACO_CCTYPE IS NOT NULL      
    --AND RGC_ACO_CC IS NOT NULL      
    --AND RGC_ACO_CCEXP IS NOT NULL      
    --AND RGC_ACO_CCNAME IS NOT NULL      
     RGD_ACO_CREATE_TIME BETWEEN @FROM      
     AND @TO      
    AND RGC_ACO_STATUS LIKE '%' + @STATUS + '%'      
    AND (      
     RGC_ACO_ADD_REQUEST IS NULL      
     OR RGC_ACO_ADD_REQUEST LIKE '%' + @ADDREQUEST + '%'      
     )      
   ORDER BY EMDTBEG      
    ,EMCNO      
    ,HTCDSC      
    ,RGD_ACO_CREATE_TIME      
    ,RGCPLNM      
    ,RGCPFNM      
    ,RGCNO      
  END      
 END      
 ELSE      
 BEGIN      
  IF (      
    @FROM IS NULL      
    AND @TO IS NULL      
    )      
  BEGIN      
   WITH InsuranceCTE      
   AS (      
    SELECT CASE       
      WHEN activity_booking.abncanceled = 1      
       THEN 'NO'      
      ELSE 'YES'      
      END AS Insurance      
     ,RGNNO      
     ,ROW_NUMBER() OVER (      
      PARTITION BY RGNNO ORDER BY CASE       
        WHEN activity_booking.abncanceled = 1      
         THEN 0      
        ELSE 1      
        END DESC      
      ) AS rn      
    FROM Activity_Booking      
    RIGHT JOIN Activity ON Activity_Booking.avnno = Activity.avnno      
     AND AVNHOTEL = 1      
    )      
   SELECT EVENTS.EMNNO      
    ,EMCNM      
    ,EMCACRO      
    ,EMCNO      
    ,CONVERT(NVARCHAR(20), EMDTBEG, 101) EMDTBEG      
    ,CONVERT(NVARCHAR(20), EMDTEND, 101) EMDTEND      
    ,HOTEL.HTNNO      
    ,HTCDSC      
    ,HTCACRO      
    ,'' AS Roomcategory      
    ,'' AS RSCHOTELCOMMENTS      
    ,HTCAD1      
    ,HTCCITY      
    ,HTCST      
    ,HTCTEL      
    ,HTCSLETEL      
    ,HTCSLENM      
    ,HTCSLEEMAIL      
    ,HTCSLETLE      
    ,HTCSLEFAX      
    ,RGCPLNM      
    ,RGCPFNM      
    ,RGCNO      
    ,REGMST.RGNNO      
    ,RGCPMI      
    ,RGCPPFX      
    ,RGDTMDY      
    ,RGCPSFX      
    ,RGCNIKNM      
    ,RGCPTLE      
    ,RGCPORG      
    ,RGCPAD1      
    ,RGCPAD2      
    ,RGCPCITY      
    ,RGCPST      
    ,RGCPZIP      
    ,RGCPCTRY      
    ,RGCPREGN      
    ,RGCBEMAIL      
    ,RGCEMAIL      
    ,CONVERT(NVARCHAR(20), RGDTADD, 101) RGDTADD1      
   -- ,CONVERT(NVARCHAR(30), RGD_ACO_CREATE_TIME, 101) RGDTADD      
 ,FORMAT(CAST(RGD_ACO_CREATE_TIME AS DATETIME), 'MM/dd/yyyy hh:mm tt') as RGDTADD  
    ,RGCHTEL      
    ,RGCHFAX      
    ,RGCPTEL      
    ,RGN_ACO_HTNNO      
    ,CONVERT(NVARCHAR(20), RGD_ACO_ARR, 101) RGD_ACO_ARR      
    ,CONVERT(NVARCHAR(20), RGD_ACO_DEP, 101) RGD_ACO_DEP      
    ,RGN_ACO_ROOMS      
    ,RGC_ACO_CCTYPE      
    ,RGC_ACO_CC      
    ,RGC_ACO_CCEXP      
    ,RGC_ACO_CCNAME      
    ,RGC_ACO_STATUS      
    ,RGC_ACO_AGENT_NOTES      
    ,RGC_ACO_SPCL_REQUESTS      
    ,0 AS RSNNO      
    ,'' AS RSDTXLD      
    ,RGC_ACO_BLOCKCODE      
    ,isnull(InsuranceCTE.Insurance, 'NO') Insurance      
   FROM REGMST      
   INNER JOIN EVENTS ON EVENTS.EMNNO = REGMST.EMNNO      
   LEFT JOIN HOTEL ON REGMST.RGN_ACO_HTNNO = HOTEL.HTNNO      
   LEFT JOIN      
    InsuranceCTE ON InsuranceCTE.RGNNO = REGMST.RGNNO      
    AND InsuranceCTE.rn = 1      
   WHERE   
   --RGC_ACO_CCTYPE IS NOT NULL      
    --AND RGC_ACO_CC IS NOT NULL      
    --AND RGC_ACO_CCEXP IS NOT NULL          
 --AND RGC_ACO_CCNAME IS NOT NULL      
     RGC_ACO_STATUS LIKE '%' + @STATUS + '%'      
    AND RGC_ACO_ADD_REQUEST LIKE '%' + @ADDREQUEST + '%'      
   ORDER BY EMDTBEG      
    ,EMCNO      
    ,HTCDSC      
    ,RGD_ACO_CREATE_TIME      
    ,RGCPLNM      
    ,RGCPFNM      
    ,RGCNO      
  END      
  ELSE      
  BEGIN      
   SELECT EVENTS.EMNNO      
    ,EMCNM      
    ,EMCACRO      
    ,EMCNO      
    ,CONVERT(NVARCHAR(20), EMDTBEG, 101) EMDTBEG      
    ,CONVERT(NVARCHAR(20), EMDTEND, 101) EMDTEND      
    ,HOTEL.HTNNO      
    ,HTCDSC      
    ,HTCACRO      
    ,'' AS Roomcategory      
    ,'' AS RSCHOTELCOMMENTS      
    ,HTCAD1      
    ,HTCCITY      
    ,HTCST      
    ,HTCTEL      
    ,HTCSLETEL      
    ,HTCSLENM      
    ,HTCSLEEMAIL      
    ,HTCSLETLE      
    ,HTCSLEFAX      
    ,RGCPLNM      
    ,RGCPFNM      
    ,RGCNO      
    ,REGMST.RGNNO      
    ,RGCPMI      
    ,RGCPPFX      
    ,RGDTMDY      
    ,RGCPSFX      
    ,RGCNIKNM      
    ,RGCPTLE      
    ,RGCPORG      
    ,RGCPAD1      
    ,RGCPAD2      
    ,RGCPCITY      
    ,RGCPST      
    ,RGCPZIP      
    ,RGCPCTRY      
    ,RGCPREGN      
    ,RGCBEMAIL      
    ,RGCEMAIL      
    ,CONVERT(NVARCHAR(20), RGDTADD, 101) RGDTADD1      
    ,CONVERT(NVARCHAR(30), RGD_ACO_CREATE_TIME, 101) RGDTADD 
    ,RGCHTEL      
    ,RGCHFAX      
    ,RGCPTEL      
    ,RGN_ACO_HTNNO      
    ,CONVERT(NVARCHAR(20), RGD_ACO_ARR, 101) RGD_ACO_ARR      
    ,CONVERT(NVARCHAR(20), RGD_ACO_DEP, 101) RGD_ACO_DEP      
    ,RGN_ACO_ROOMS      
    ,RGC_ACO_CCTYPE      
    ,RGC_ACO_CC      
    ,RGC_ACO_CCEXP      
    ,RGC_ACO_CCNAME      
    ,RGC_ACO_STATUS      
    ,RGC_ACO_AGENT_NOTES      
    ,RGC_ACO_SPCL_REQUESTS      
    ,RESERVATIONS.RSNNO      
    ,RESERVATIONS.RSDTXLD      
    ,RGC_ACO_BLOCKCODE      
    ,isnull(Act.Insurance, 'NO') Insurance      
   FROM REGMST      
   INNER JOIN EVENTS ON EVENTS.EMNNO = REGMST.EMNNO      
   LEFT JOIN HOTEL ON REGMST.RGN_ACO_HTNNO = HOTEL.HTNNO      
   LEFT JOIN RESERVATIONS ON REGMST.RGNNO = RESERVATIONS.RGNNO      
   LEFT JOIN (      
    SELECT (      
      CASE       
       WHEN activity_booking.abncanceled = 1      
        THEN 'NO'      
       ELSE 'YES'      
       END      
      ) Insurance      
     ,RGNNO      
    FROM Activity_Booking      
    INNER JOIN Activity ON Activity_Booking.avnno = Activity.avnno      
     AND AVNHOTEL = 1      
    ) Act ON act.RGNNO = REGMST.RGNNO      
   WHERE   
  -- RGC_ACO_CCTYPE IS NOT NULL      
   -- AND RGC_ACO_CC IS NOT NULL      
    --AND RGC_ACO_CCEXP IS NOT NULL      
    --AND RGC_ACO_CCNAME IS NOT NULL      
     RGD_ACO_CREATE_TIME BETWEEN @FROM      
     AND @TO      
    AND RGC_ACO_STATUS LIKE '%' + @STATUS + '%'      
    AND RGC_ACO_ADD_REQUEST LIKE '%' + @ADDREQUEST + '%'      
   ORDER BY EMDTBEG      
    ,EMCNO      
    ,HTCDSC      
    ,RGD_ACO_CREATE_TIME      
    ,RGCPLNM      
    ,RGCPFNM      
    ,RGCNO      
  END      
 END      
END  
