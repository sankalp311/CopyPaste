    private void SendDataSetAsExcel(DataSet ds, string fileName)
          {
               //using (var wb = new ClosedXML.Excel.XLWorkbook(ClosedXML.Excel.XLEventTracking.Disabled))
               using (var wb = new XLWorkbook())
               {
                    if (ds == null || ds.Tables.Count == 0)
                    {
                         var ws = wb.Worksheets.Add("Sheet1");
                         ws.Cell(1, 1).Value = "No data found";
                    }
                    else
                    {
                         int sheetIndex = 1;

                         foreach (DataTable dt in ds.Tables)
                         {
                              if (dt == null) continue;

                              string sheetName = !string.IsNullOrWhiteSpace(dt.TableName)
                                  ? SafeExcelSheetName(dt.TableName)
                                  : "Sheet" + sheetIndex;

                              if (wb.Worksheets.Any(x => x.Name.Equals(sheetName, StringComparison.OrdinalIgnoreCase)))
                                   sheetName = "Sheet" + sheetIndex;

                              var ws = wb.Worksheets.Add(sheetName);

                              // headers
                              for (int col = 0; col < dt.Columns.Count; col++)
                              {
                                   ws.Cell(1, col + 1).Value = dt.Columns[col].ColumnName;
                                   ws.Cell(1, col + 1).Style.Font.Bold = true;
                              }

                              // data
                              for (int row = 0; row < dt.Rows.Count; row++)
                              {
                                   for (int col = 0; col < dt.Columns.Count; col++)
                                   {
                                        object value = dt.Rows[row][col];
                                        var cell = ws.Cell(row + 2, col + 1);

                                        if (value == DBNull.Value || value == null)
                                        {
                                             cell.Value = string.Empty;
                                             continue;
                                        }

                                        Type t = Nullable.GetUnderlyingType(dt.Columns[col].DataType) ?? dt.Columns[col].DataType;

                                        if (t == typeof(DateTime))
                                        {
                                             cell.Value = Convert.ToDateTime(value);
                                             cell.Style.DateFormat.Format = "dd-MMM-yyyy HH:mm:ss";
                                        }
                                        else if (t == typeof(bool))
                                        {
                                             cell.Value = Convert.ToBoolean(value);
                                        }
                                        else if (t == typeof(byte) ||
                                                 t == typeof(short) ||
                                                 t == typeof(int) ||
                                                 t == typeof(long))
                                        {
                                             cell.Value = Convert.ToInt64(value);
                                             cell.Style.NumberFormat.Format = "0";
                                        }
                                        else if (t == typeof(decimal) ||
                                                 t == typeof(double) ||
                                                 t == typeof(float))
                                        {
                                             cell.Value = Convert.ToDecimal(value);
                                             cell.Style.NumberFormat.Format = "0.00########";
                                        }
                                        else
                                        {
                                             cell.Value = Convert.ToString(value);
                                        }
                                   }
                              }

                              ws.SheetView.FreezeRows(1);

                              if (dt.Columns.Count > 0)
                                   ws.Columns(1, dt.Columns.Count).AdjustToContents(1, Math.Min(dt.Rows.Count + 1, 200));

                              sheetIndex++;
                         }
                    }

                    using (MemoryStream ms = new MemoryStream())
                    {
                         wb.SaveAs(ms);
                         byte[] bytes = ms.ToArray();

                         Response.Clear();
                         Response.Buffer = true;
                         Response.Charset = "";
                         Response.ContentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                         Response.AddHeader("content-disposition", "attachment;filename=\"" + fileName + "\"");
                         Response.BinaryWrite(bytes);
                         Response.Flush();
                         HttpContext.Current.ApplicationInstance.CompleteRequest();
                    }
               }
          }
