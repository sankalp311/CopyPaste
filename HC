SET NOCOUNT ON;      
    SET XACT_ABORT ON;      
      
    -- Fast reporting read      
    SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;      
      
    -- Crystal CurrentDate is DATE (no time)      
    DECLARE @AsOfDate DATE = CAST(GETDATE() AS DATE);      
      
    SELECT      
        E.EMCNO,      
        E.EMDTBEG,      
        H.HTCDSC,      
        HRB.HBTEAMCUTOFFDATE,      
        H.HTDTCUTOFF,      
        HRB.HBCNO,      
        HRB.HBCLNM,      
        HRB.HBCFNM,      
        HRB.HBDTAPPROVED,      
        HRB.HBCORG      
    FROM dbo.EVENTS AS E WITH (NOLOCK)      
    INNER JOIN dbo.HOTEL AS H WITH (NOLOCK)      
        ON E.EMNNO = H.EMNNO      
    INNER JOIN dbo.HOTELROOMBLOCKS AS HRB WITH (NOLOCK)      
        ON H.HTNNO = HRB.HTNNO      
    WHERE      
        -- {EVENTS.EMDTBEG} > CurrentDate      
           E.EMDTBEG > @AsOfDate      
      
        -- {HOTELROOMBLOCKS.HBNAPPROVED} = 1      
        AND HRB.HBNAPPROVED = 1      
      
        -- ({HBCLNM} <> 'Reservations' and <> 'Comp')      
        AND HRB.HBCLNM <> 'Reservations'      
        AND HRB.HBCLNM <> 'Comp'      
      
        -- {HBTEAMCUTOFFDATE} > {HTDTCUTOFF}      
        AND HRB.HBTEAMCUTOFFDATE IS NOT NULL      
        AND H.HTDTCUTOFF IS NOT NULL      
        AND HRB.HBTEAMCUTOFFDATE > H.HTDTCUTOFF   
