          #region ===== Helpers ======================================================================

          private static bool ValidateSessionId(string sessionId, string cs)
          {
               if (string.IsNullOrWhiteSpace(sessionId)) return false;

               using (SqlConnection con = new SqlConnection(cs))
               using (SqlCommand cmd = new SqlCommand("ICM.dbo.sp_ICM_Validate_SessionID", con))
               {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.Parameters.Add("@SessionID", SqlDbType.NVarChar, 128).Value = sessionId.Trim();

                    con.Open();
                    object result = cmd.ExecuteScalar();

                    if (result == null || result == DBNull.Value)
                         return false;

                    if (result is bool)
                         return (bool)result;

                    int i;
                    if (int.TryParse(Convert.ToString(result, CultureInfo.InvariantCulture), out i))
                         return i == 1;

                    return false;
               }
          }

          private static bool HasAnyRows(DataSet ds)
          {
               if (ds == null || ds.Tables.Count == 0) return false;

               foreach (DataTable t in ds.Tables)
               {
                    if (t != null && t.Rows.Count > 0)
                         return true;
               }

               return false;
          }

          private static string NormalizeRdlcPath(string raw)
          {
               string p = (raw ?? "").Replace('\\', '/').Trim();

               if (!p.StartsWith("~"))
                    p = "~/" + p.TrimStart('/');

               if (string.IsNullOrWhiteSpace(Path.GetExtension(p)))
                    p = Path.ChangeExtension(p, ".rdlc");

               return p;
          }

          private static string FirstNonEmpty(params string[] values)
          {
               if (values == null) return "";

               foreach (string v in values)
               {
                    if (!string.IsNullOrWhiteSpace(v))
                         return v;
               }

               return "";
          }

          private static bool IsYes(string value)
          {
               return
                   string.Equals((value ?? "").Trim(), "Y", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals((value ?? "").Trim(), "YES", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals((value ?? "").Trim(), "TRUE", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals((value ?? "").Trim(), "1", StringComparison.OrdinalIgnoreCase);
          }

          private static int SafeToInt(string s, int defaultValue)
          {
               int x;
               return int.TryParse((s ?? "").Trim(), out x) ? x : defaultValue;
          }

          private static string GetAppSetting(string key, string defaultValue)
          {
               string v = ConfigurationManager.AppSettings[key];
               return string.IsNullOrWhiteSpace(v) ? defaultValue : v.Trim();
          }

          private static Exception GetRootException(Exception ex)
          {
               Exception root = ex;
               while (root != null && root.InnerException != null)
                    root = root.InnerException;
               return root ?? ex;
          }

          private static void TraceLog(string message, Exception ex = null, string stage = null)
          {
               try
               {
                    HttpContext ctx = HttpContext.Current;
                    string baseDir = (ctx != null)
                        ? ctx.Server.MapPath("~/App_Data/logs")
                        : Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "App_Data", "logs");

                    Directory.CreateDirectory(baseDir);
                    string path = Path.Combine(baseDir, "roomblockconfirmation_trace.txt");

                    using (StreamWriter sw = new StreamWriter(path, true))
                    {
                         string stamp = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);
                         sw.WriteLine("[" + stamp + "] " + (stage ?? "INFO") + " :: " + message);

                         if (ex != null)
                         {
                              sw.WriteLine(ex.GetType().FullName);
                              sw.WriteLine(ex.Message);
                              sw.WriteLine(ex.StackTrace);
                         }
                    }
               }
               catch
               {
               }
          }

          private DataTable GetTableOrEmpty(DataSet ds, int index)
          {
               if (ds != null && ds.Tables.Count > index && ds.Tables[index] != null)
                    return ds.Tables[index];

               return new DataTable();
          }

          private static string GetFirstValue(DataSet ds, params string[] columnNames)
          {
               if (ds == null || ds.Tables.Count == 0 || columnNames == null || columnNames.Length == 0)
                    return "";

               foreach (DataTable table in ds.Tables)
               {
                    if (table == null || table.Rows.Count == 0)
                         continue;

                    foreach (string colName in columnNames)
                    {
                         if (string.IsNullOrWhiteSpace(colName))
                              continue;

                         foreach (DataColumn col in table.Columns)
                         {
                              if (string.Equals(col.ColumnName, colName, StringComparison.OrdinalIgnoreCase))
                              {
                                   object val = table.Rows[0][col.ColumnName];
                                   if (val != null && val != DBNull.Value)
                                   {
                                        string s = Convert.ToString(val).Trim();
                                        if (!string.IsNullOrWhiteSpace(s))
                                             return s;
                                   }
                              }
                         }
                    }
               }

               return "";
          }

          private static string NormalizeEmailBody(string raw)
          {
               if (string.IsNullOrWhiteSpace(raw))
                    return "";

               string value = raw.Trim();

               // if already html, keep as-is
               if (Regex.IsMatch(value, "<.*?>", RegexOptions.Singleline))
                    return value;

               // plain text -> html safe with line breaks
               return HttpUtility.HtmlEncode(value)
                   .Replace("\r\n", "<br />")
                   .Replace("\n", "<br />");
          }

          private static string SafeFilePart(string input)
          {
               if (string.IsNullOrWhiteSpace(input))
                    return "";

               string s = input.Trim();
               foreach (char c in Path.GetInvalidFileNameChars())
                    s = s.Replace(c.ToString(), "");

               return s;
          }

          private void CloseWindowAfterEmail(string message)
          {
               Response.TrySkipIisCustomErrors = true;
               Response.ContentType = "text/html";
               Response.Write("<script>window.close();</script>");
               Response.Flush();
               HttpContext.Current.ApplicationInstance.CompleteRequest();
          }

          #endregion
     }
