          /// <summary>
          /// Executes a stored procedure with parameters discovered via DeriveParameters (prefers strong typing).
          /// Captures ALL result sets using SqlDataAdapter.Fill.
          /// </summary>
          private DataSet ExecStoredProcWithParams(string cs, string spName, IDictionary<string, object> bag)
          {
               TraceLog($"ENTER ExecStoredProcWithParams | SP={spName} | bagKeys={string.Join(",", bag?.Keys ?? Array.Empty<string>())}", stage: "ENTER");

               var ds = new DataSet();

               using (var con = new SqlConnection(cs))
               using (var cmd = new SqlCommand(spName, con) { CommandType = CommandType.StoredProcedure })
               {
                    // Try to discover the SP params
                    bool derived = false;
                    try
                    {
                         con.Open();
                         SqlCommandBuilder.DeriveParameters(cmd);
                         derived = true;
                    }
                    catch
                    {
                         // ignore
                    }
                    finally
                    {
                         if (con.State == ConnectionState.Open) con.Close();
                    }

                    if (derived)
                    {
                         foreach (SqlParameter p in cmd.Parameters)
                         {
                              if (p.Direction == ParameterDirection.ReturnValue) continue;
                              var key = p.ParameterName; // e.g. @EMNNO
                              if (bag.TryGetValue(key, out var value))
                                   p.Value = value ?? DBNull.Value;
                              else
                                   p.Value = DBNull.Value; // let SP defaults apply
                         }
                    }
                    else
                    {
                         foreach (var kv in bag)
                         {
                              var p = cmd.Parameters.Add(kv.Key, SqlDbType.NVarChar, -1);
                              p.Value = kv.Value ?? DBNull.Value;
                         }
                    }

                    // capture ALL result sets
                    using (var da = new SqlDataAdapter(cmd))
                    {
                          da.Fill(ds);

                         //con.Open();
                         //using (var reader = cmd.ExecuteReader(CommandBehavior.SequentialAccess))
                         //{
                         //     int i = 0;
                         //     do
                         //     {
                         //          var t = new DataTable("Table" + i);
                         //          t.BeginLoadData();
                         //          t.Load(reader);
                         //          t.EndLoadData();
                         //          ds.Tables.Add(t);
                         //          i++;
                         //     }
                         //     while (reader.NextResult());
                         //}

                    }
               }

               TraceLog($"EXIT ExecStoredProcWithParams | Tables={ds.Tables.Count}", stage: "EXIT");
               return ds;
          }

