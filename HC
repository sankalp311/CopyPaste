				// wwwroot/js/admin/ht152.js
(function () {
     const ALERT_AUTO_HIDE_MS = 2500;

     function showOverlay() {
          const el = document.getElementById("Processing");
          if (el) el.style.display = "flex";
     }

     function hideOverlay() {
          const el = document.getElementById("Processing");
          if (el) el.style.display = "none";
     }

     function resetMergePanel() {
          const panel = document.getElementById("mergePanelWrap");
          if (!panel) return;

          panel.innerHTML = "";
          panel.style.display = "none";
          panel.setAttribute("hidden", "hidden");
          panel.onclick = null;
          panel.onchange = null;
     }

     function initFlatpickr() {
          if (typeof flatpickr === "undefined") {
               console.error("flatpickr not loaded");
               return;
          }

          const fromEl = document.getElementById("txtFromDate");
          const toEl = document.getElementById("txtToDate");

          if (!fromEl || !toEl) {
               console.error("Date inputs not found");
               return;
          }

          window.fpFrom = flatpickr(fromEl, {
               dateFormat: "m/d/Y",
               allowInput: false,
               clickOpens: true,
               defaultDate: fromEl.value || null
          });

          window.fpTo = flatpickr(toEl, {
               dateFormat: "m/d/Y",
               allowInput: false,
               clickOpens: true,
               defaultDate: toEl.value || null
          });
     }

     window.HT152_ShowAlert = function (message, type) {
          const box = document.getElementById("ht152Alert");
          const txt = document.getElementById("ht152AlertText");
          const ico = document.getElementById("ht152AlertIcon");

          if (!box || !txt || !ico) return;

          box.classList.remove("error", "info", "success");
          box.classList.add(type || "info");

          ico.textContent =
               type === "success" ? "✅" :
                    type === "error" ? "⚠️" :
                         "ℹ️";

          txt.textContent = message;

          box.style.display = "flex";
          requestAnimationFrame(() => box.classList.add("show"));

          clearTimeout(window.__ht152AlertTimer);
          window.__ht152AlertTimer = setTimeout(() => {
               window.HT152_HideAlert();
          }, ALERT_AUTO_HIDE_MS);
     };

     window.HT152_HideAlert = function () {
          const box = document.getElementById("ht152Alert");
          if (!box) return;

          clearTimeout(window.__ht152AlertTimer);
          box.classList.remove("show");

          setTimeout(() => {
               box.style.display = "none";
          }, 220);
     };

     window.HT152_BindHistory = function (history) {
          const box = document.getElementById("HT152ReportHistory");
          if (!box) return;

          box.innerHTML = "";

          if (!history || history.length === 0) {
               box.innerHTML = `
                <div class="ht152-item">
                    <div class="ht152-type">-</div>
                    <div class="ht152-name">No history found for this hotel.</div>
                    <div class="ht152-action"></div>
                </div>`;
               return;
          }

          const header = document.createElement("div");
          header.className = "ht152-item ht152-header";
          header.innerHTML = `
            <div class="ht152-type">Report Type</div>
            <div class="ht152-name">Report Name</div>
        `;
          box.appendChild(header);

          history.forEach(r => {
               const type = r.rpttype ?? r.RPTTYPE ?? "";
               const url = r.rpturl ?? r.RPTURL ?? "";
               const name = r.rptname ?? r.RPTNAME ?? "";

               const displayRaw = (name && name.trim()) ? name : url;
               const display = String(displayRaw).split(/[\\/]/).pop();

               const div = document.createElement("div");
               div.className = "ht152-item";
               div.innerHTML = `
                <div class="ht152-type">${type}</div>
                <div class="ht152-name">${display}</div>
            `;
               box.appendChild(div);
          });
     };

     window.HT152_UpdateSelectedHotels = function (panel) {
          panel = panel || document.getElementById("mergePanelWrap");
          if (!panel) return;

          const chipsContainer = panel.querySelector("#mergeSummaryChips");
          if (!chipsContainer) return;

          chipsContainer.innerHTML = "";

          const selectedItems = panel.querySelectorAll(".merge-hotel-item input[type='checkbox']:checked");

          selectedItems.forEach(cb => {
               const parent = cb.closest(".merge-hotel-item");
               if (!parent) return;

               const hotelName = parent.querySelector(".hotel-name")?.innerText?.trim() || "";
               const eventCode = parent.querySelector(".event-tag")?.innerText?.replace("Event: ", "").trim() || "";

               const chip = document.createElement("span");
               chip.className = parent.classList.contains("is-cross")
                    ? "merge-chip cross-chip"
                    : "merge-chip";

               chip.innerText = parent.classList.contains("is-cross") && eventCode
                    ? `${hotelName} (${eventCode})`
                    : hotelName;

               chipsContainer.appendChild(chip);
          });
     };

     window.HT152_GetSelectedHotels = function () {
          const hotels = document.querySelectorAll("#mergePanelWrap .merge-hotel-item");

          return Array.from(hotels)
               .map(item => {
                    const checkbox = item.querySelector('input[type="checkbox"]');
                    const isSelected = checkbox && checkbox.checked;

                    if (!isSelected) return null;

                    return {
                         hotelId: item.dataset.id || "",
                         name: item.querySelector(".hotel-name")?.innerText?.trim() || "",
                         event: item.querySelector(".event-tag")?.innerText?.replace("Event: ", "").trim() || "",
                         isCross: item.classList.contains("is-cross")
                    };
               })
               .filter(Boolean);
     };

     window.HT152_GetSelectedHotelIds = function () {
          return window.HT152_GetSelectedHotels()
               .map(h => h.hotelId)
               .filter(Boolean)
               .join(",");
     };


     window.HT152_GetReportTypeName = function () {
          const mergeItems = document.querySelectorAll("#mergePanelWrap .merge-hotel-item");

          // no related hotel versions found
          if (!mergeItems || mergeItems.length === 0) {
               return "Single";
          }

          const selectedHotels = window.HT152_GetSelectedHotels();

          // fallback
          if (!selectedHotels || selectedHotels.length === 0) {
               return "Single";
          }

          // if any hotel from different event is selected
          if (selectedHotels.some(h => h.isCross)) {
               return "Cross";
          }

          // if more than one selected and all are same-event hotels
          if (selectedHotels.length > 1) {
               return "Merged";
          }

          // only primary hotel selected
          return "Single";
     };


     window.HT152_OnHotelChange = async function () {
          debugger;
          const ddlHotel = document.getElementById("ddlHotelList");
          const hotelId = parseInt((ddlHotel?.value || "0").trim(), 10);

          if (!hotelId) {
               resetMergePanel();
               window.HT152_BindHistory([]);
               return;
          }

          await window.HotelDetailsWithRFP(hotelId);

          try {
               const res = await fetch("/Admin/ReportHT152/GetDefaultFromTo", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ hotelId: hotelId })
               });

               if (!res.ok) {
                    throw new Error("Failed to load default from/to values.");
               }

               const data = await res.json();
               if (!data) return;

               const fromDate = data.fromDate || data.FromDate || "";
               const toDate = data.toDate || data.ToDate || "";

               document.getElementById("txtFromDate").value = fromDate;
               document.getElementById("txtToDate").value = toDate;

               if (window.fpFrom && fromDate) {
                    window.fpFrom.setDate(fromDate, true, "m/d/Y");
               }

               if (window.fpTo && toDate) {
                    window.fpTo.setDate(toDate, true, "m/d/Y");
               }

               document.getElementById("ddlFrmHour").value = data.frmHour || data.FrmHour || "12";
               document.getElementById("ddlFrmMin").value = data.frmMin || data.FrmMin || "00";
               document.getElementById("ddlFrmAmPM").value = data.frmAmPm || data.FrmAmPm || "AM";

               document.getElementById("ddlToHour").value = data.toHour || data.ToHour || "12";
               document.getElementById("ddlToMin").value = data.toMin || data.ToMin || "00";
               document.getElementById("ddlToAmPM").value = data.toAmPm || data.ToAmPm || "AM";

               window.HT152_BindHistory(data.history || data.History || []);
          } catch (err) {
               console.error("HT152_OnHotelChange error:", err);
               window.HT152_BindHistory([]);
          }
     };

     window.HT152_Process = async function (multiHTNNO = "", reportTypeName = "Single") {
          const hotelVal = (document.getElementById("ddlHotelList").value || "").trim();
          const hotelId = parseInt(hotelVal || "0", 10);

          if (!hotelId) {
               window.HT152_ShowAlert("Please select a hotel before generating the report.", "error");
               return;
          }

          const chkNew = document.getElementById("ChkNew").checked;
          const chkChanged = document.getElementById("ChkChanged").checked;
          const chkCanceled = document.getElementById("ChkCanceled").checked;

          if (!chkNew && !chkChanged && !chkCanceled) {
               window.HT152_ShowAlert("Please select at least one Report Type (New / Changed / Canceled).", "error");
               return;
          }

          window.HT152_HideAlert();
          showOverlay();

          const payload = {
               hotelId: hotelId,
               fromDate: document.getElementById("txtFromDate").value,
               toDate: document.getElementById("txtToDate").value,

               frmHour: document.getElementById("ddlFrmHour").value,
               frmMin: document.getElementById("ddlFrmMin").value,
               frmAmPm: document.getElementById("ddlFrmAmPM").value,

               toHour: document.getElementById("ddlToHour").value,
               toMin: document.getElementById("ddlToMin").value,
               toAmPm: document.getElementById("ddlToAmPM").value,

               chkNew: chkNew,
               chkChanged: chkChanged,
               chkCanceled: chkCanceled,

               reportid: 0,
               multiHTNNO: multiHTNNO || "",
               ReportTypeName: reportTypeName || "Single"
          };

          try {
               debugger;
               const res = await fetch("/Admin/ReportHT152/Process", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
               });
               debugger;
               if (!res.ok) {
                    throw new Error("Process API failed.");
               }

               const data = await res.json();
               window.HT152_BindHistory(data.history || data.History || []);
               window.HT152_ShowAlert("Report generated and saved in history.", "success");
          } catch (e) {
               console.error("HT152_Process error:", e);
               window.HT152_ShowAlert("Something went wrong while generating the report. Please try again.", "error");
          } finally {
               hideOverlay();
          }
     };

     window.HT152_HandleGenerateClick = function () {
          const mergeItems = document.querySelectorAll("#mergePanelWrap .merge-hotel-item");

          // no related RFP hotels -> old direct flow
          if (!mergeItems || mergeItems.length === 0) {
               window.HT152_Process("", "Single");
               return;
          }

          const selectedHotels = window.HT152_GetSelectedHotels();

          // fallback to normal flow
          if (!selectedHotels || selectedHotels.length === 0) {
               window.HT152_Process("", "Single");
               return;
          }

          let isCrossEvent = selectedHotels.some(h => h.isCross);
          let html = "";

          if (selectedHotels.length === 1) {
               const hotel = selectedHotels[0];

               document.getElementById("confirmModalTitle").innerText = "Run Report for One Hotel Only?";

               html = `
                <p>We detected other hotel versions with matching RFP IDs, but you have not selected any of them.</p>
                <p>You are about to generate a report for:</p>
                <div class="model-p">
                    <ol>
                        <li>
                            <strong class="model-s" data-id="${hotel.hotelId}">${hotel.name} only.</strong>
                        </li>
                    </ol>
                </div>
                <p>Are you sure you only want to run the report for this one hotel?</p>
            `;

               document.getElementById("confirmCrossNote").style.display = "none";
          } else {
               document.getElementById("confirmModalTitle").innerText =
                    isCrossEvent ? "Confirm Cross-Event Merged Report" : "Confirm Merged Report";

               html = `<p>You have selected <strong class="model-s">${selectedHotels.length} hotels</strong> for a merged rooming list:</p><div class="model-p"><ol>`;

               selectedHotels.forEach(h => {
                    html += `
                    <li>
                        <strong class="model-s" data-id="${h.hotelId}">${h.name}</strong>
                        ${h.event ? `<strong class="model-e"> (${h.event})</strong>` : ""}
                    </li>
                `;
               });

               html += `</ol></div>`;

               document.getElementById("confirmCrossNote").style.display =
                    isCrossEvent ? "block" : "none";
          }

          document.getElementById("confirmModalBody").innerHTML = html;
          document.getElementById("confirmModal").style.display = "block";
     };

     window.HotelDetailsWithRFP = async function (hotelId) {
          resetMergePanel();

          if (!hotelId) return;

          try {
               const hotelRequest = {
                    HotelId: hotelId
               };

               const res = await fetch("/Admin/ReportHT152/HotelDetailsWithRFP", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(hotelRequest)
               });

               if (!res.ok) {
                    throw new Error("HotelDetailsWithRFP API failed.");
               }

               const data = await res.json();
               if (!Array.isArray(data) || data.length <= 1) {
                    return;
               }

               const panel = document.getElementById("mergePanelWrap");
               if (!panel) return;

               const mainEvent = data[0].emcno;
               const sameEventHotels = data.filter(d => d.emcno === mainEvent);
               const crossEventHotels = data.filter(d => d.emcno !== mainEvent);

               let html = `
                <div class="merge-panel-head">
                    <div class="merge-panel-title">⤢ Related hotel versions detected</div>
                    <div class="merge-panel-subtitle">
                        Select the versions you want to include in your merged rooming list.
                    </div>
                </div>
            `;

               html += `<div class="merge-panel-body" id="mergeHotelList">`;

               sameEventHotels.forEach((d, index) => {
                    const isPrimary = index === 0;
                    html += `
                    <div class="merge-hotel-item ${isPrimary ? "is-primary is-checked" : ""}" data-id="${d.htnno || ""}">
                        <input type="checkbox" ${isPrimary ? "checked disabled" : ""}>
                        <div class="hotel-info">
