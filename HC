ALTER PROCEDURE [dbo].[sp_ICM_RPT_EXPORT_ADDED_DATA_HT112_RDLC_112_RL]                               
                                    
@EMNNO int, @HTNNO int, @RGDTADD_FROM datetime, @RGDTADD_TO datetime,@REPORTID int,@user nvarchar(100),@CurrentDate datetime  ,@MultiHTNNO varchar(max) = NULL                                      
-- =========================================================================================================        
-- Author      : Sanaklp M        
-- Create date : 15-Apr-2026        
-- Modified By : Sanaklp M        
-- Modified On : 15-Apr-2026        
-- Modified By : Sanaklp M        
-- Modified On : 15-Apr-2026        
-- Procedure   : [dbo].[sp_ICM_RPT_EXPORT_ADDED_DATA_HT112_RDLC]        
-- Database    : EXTERNAL ICM_REPORT_EXPORTS        
--        
-- Description :        
--     Exports added reservation / rooming data hotel-wise and inserts related export history,        
--     audit, and rooming log records.        
--        
-- Enhancement :        
--     Added support for @MultiHTNNO as comma-separated HTNNO values.        
--     When @MultiHTNNO is provided, procedure loops through each HTNNO and fetches related        
--     EMNNO from HOTEL table, then executes existing logic for each hotel.        
--     When @MultiHTNNO is NULL or empty, procedure works exactly as before using @EMNNO and @HTNNO.        
--        
-- IMPORTANT :        
--     USE ONLY WITH EXTERNAL ICM_REPORT_EXPORTS DATABASE        
-- =========================================================================================================        
                                 
As                                    
begin try                                      
                                    
Set NoCount On                                    
SET ANSI_WARNINGS OFF    
  
select 1  
                                    
declare @EncryptKey varchar(255)                                    
declare @UseEncryption varchar(255)                                    
DECLARE @HTNNOList TABLE (HTNNO INT)              
        
--exec master..xp_regread 'HKEY_LOCAL_MACHINE', 'SOFTWARE\EventManager\Encryption', 'EncryptKey', @EncryptKey output                                    
--exec master..xp_regread 'HKEY_LOCAL_MACHINE', 'SOFTWARE\EventManager\Encryption', 'UseEncryption', @UseEncryption output                                    
                                    
if isnull(@UseEncryption,'') = '0'                                    
 Begin                                    
  select @UseEncryption = 0                                    
 end                                    
else                                    
 Begin                                    
  select @UseEncryption = cast(@UseEncryption as integer)                                    
 end                                    
                                    
if isnull(@EncryptKey, '') = ''                                    
 Begin                                    
  select @EncryptKey = ''                                    
 end                                    
                                     
declare @ScopeIdentity int                                                 
declare @REF_ID nvarchar(50)                                  
declare @USCLNAME nvarchar(100),@USCFNAME nvarchar(100)                                 
set @USCLNAME=(select USCLNM USCLNAME from userinfo where usnno=@user)                    
set @USCFNAME=(select USCFNM USCFNAME from userinfo where usnno=@user)                                                  
set @REF_ID=(select HTCRFP_ID from hotel where htnno=@HTNNO)        
        
        
		RETURN;
        
IF ISNULL(LTRIM(RTRIM(@MultiHTNNO)), '') = ''            
BEGIN            
    INSERT INTO @HTNNOList (HTNNO)            
    VALUES (@HTNNO)            
END            
ELSE            
BEGIN            
    INSERT INTO @HTNNOList (HTNNO)            
    SELECT DISTINCT TRY_CAST(LTRIM(RTRIM(Item)) AS INT)            
    FROM SplitString(@MultiHTNNO, ',')   
    WHERE TRY_CAST(LTRIM(RTRIM(Item)) AS INT) IS NOT NULL          
         
END          
      select * from @HTNNOList  
        
WHILE EXISTS (SELECT 1 FROM @HTNNOList)            
select 1 

END try                                                          
  BEGIN CATCH                                                                                           
 INSERT INTO dbo.dbErrorLogs (UserName, ErrorNumber, ErrorState, ErrorSeverity, ErrorLine,                                                                                      
 ErrorProcedure, ErrorMessage, ErrorOccuredOn)                                            
 VALUES (SUSER_SNAME(), ERROR_NUMBER(), ERROR_STATE(), ERROR_SEVERITY(), ERROR_LINE(),                                                                    
 ERROR_PROCEDURE(), ERROR_MESSAGE(), GETDATE())                                                                                                
 select 0  as Result                                                                                                 
  END CATCH
