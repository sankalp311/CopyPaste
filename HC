ALTER PROCEDURE dbo.sp_ICM_RPT_BlkInventory_ByEvent_RDLC
(
    @EMNNO INT,
    @ExcludeSpecial BIT = 1
)
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;
    SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

    ----------------------------------------------------------------------
    -- 1) Base blocks (1 row per HBNNO) + APPLY Crystal selection:
    --    {EVENTS.EMNNO}=[EMNNO] AND {HOTELROOMBLOCKS.HBNAPPROVED}=1
    ----------------------------------------------------------------------
    CREATE TABLE #B
    (
        HBNNO        INT          NOT NULL PRIMARY KEY,
        EMNNO        INT          NOT NULL,
        EMCNM        VARCHAR(200) NULL,
        EMDTBEG      DATETIME     NULL,
        EMDTEND      DATETIME     NULL,

        HTNNO        INT          NOT NULL,
        HTCDSC       VARCHAR(300) NULL,

        HBDTAPPROVED DATETIME     NULL,
        HBCORG       VARCHAR(200) NULL,
        HBCFNM       VARCHAR(200) NULL,
        HBCLNM       VARCHAR(200) NULL,
        HBCEMAIL     VARCHAR(300) NULL,

        SortOrderBlkNameNo VARCHAR(800) NULL   -- Crystal: Org+LName+FName+ToText(HTNNO)
    );

    INSERT INTO #B (HBNNO, EMNNO, EMCNM, EMDTBEG, EMDTEND, HTNNO, HTCDSC, HBDTAPPROVED, HBCORG, HBCFNM, HBCLNM, HBCEMAIL, SortOrderBlkNameNo)
    SELECT DISTINCT
          HRB.HBNNO
        , E.EMNNO
        , E.EMCNM
        , E.EMDTBEG
        , E.EMDTEND
        , H.HTNNO
        , H.HTCDSC
        , HRB.HBDTAPPROVED
        , HRB.HBCORG
        , HRB.HBCFNM
        , HRB.HBCLNM
        , HRB.HBCEMAIL
        , (ISNULL(HRB.HBCORG,'') + ISNULL(HRB.HBCLNM,'') + ISNULL(HRB.HBCFNM,'') + CONVERT(VARCHAR(20), H.HTNNO)) AS SortOrderBlkNameNo
    FROM dbo.EVENTS E
    INNER JOIN dbo.HOTEL H
        ON H.EMNNO = E.EMNNO
    INNER JOIN dbo.HOTELROOMBLOCKS HRB
        ON HRB.HTNNO = H.HTNNO
    WHERE
        E.EMNNO = @EMNNO
        AND ISNULL(HRB.HBNAPPROVED, 0) = 1
        AND
        (
            @ExcludeSpecial = 0
            OR NOT (
                   (UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCFNM,'')))) = 'IND'
                AND UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCLNM,'')))) = 'RESERVATIONS')
                OR (UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCFNM,'')))) = 'JOHN'
                AND UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCLNM,'')))) = 'BILLINGSLEY')
                OR (UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCFNM,'')))) = 'TOURNAMENT'
                AND UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCLNM,'')))) = 'COMP')
            )
        );

    ----------------------------------------------------------------------
    -- 2) Crystal "Peak Night" style:
    --    DailyTotal = SUM(Reserved+Adj) per RBDATE for the Group #2 key,
    --    RunPeakNight = MAX(DailyTotal) within that Group #2.
    ----------------------------------------------------------------------
    ;WITH Daily AS
    (
        SELECT
              B.SortOrderBlkNameNo
            , B.HBCORG, B.HBCFNM, B.HBCLNM, B.HTNNO
            , I.RBDATE
            , SUM(CAST(ISNULL(I.RBNAMOUNTRESERVED,0) AS DECIMAL(18,2))
              + CAST(ISNULL(I.RBNADJUSTMENTS,0)   AS DECIMAL(18,2))) AS DailyTotal
        FROM #B B
        INNER JOIN dbo.HOTELROOMBLOCKINVENTORY I
            ON I.HBNNO = B.HBNNO
        GROUP BY
              B.SortOrderBlkNameNo
            , B.HBCORG, B.HBCFNM, B.HBCLNM, B.HTNNO
            , I.RBDATE
    ),
    Peak AS
    (
        SELECT
              SortOrderBlkNameNo
            , HBCORG, HBCFNM, HBCLNM, HTNNO
            , MAX(DailyTotal) AS RunPeakNight
        FROM Daily
        GROUP BY
              SortOrderBlkNameNo
            , HBCORG, HBCFNM, HBCLNM, HTNNO
    )
    ----------------------------------------------------------------------
    -- 3) Final output (exact columns)
    ----------------------------------------------------------------------
    SELECT
          MAX(B.EMCNM) AS EMCNM
        , (CONVERT(VARCHAR(10), CAST(MAX(B.EMDTBEG) AS DATE), 101) + ' - ' +
           CONVERT(VARCHAR(10), CAST(MAX(B.EMDTEND) AS DATE), 101)) AS EventDateRange
        , MIN(B.HBDTAPPROVED) AS HBDTAPPROVED
        , P.HBCORG
        , (LTRIM(RTRIM(ISNULL(P.HBCFNM,''))) +
           CASE WHEN ISNULL(LTRIM(RTRIM(P.HBCFNM)),'') <> '' AND ISNULL(LTRIM(RTRIM(P.HBCLNM)),'') <> '' THEN ' ' ELSE '' END +
           LTRIM(RTRIM(ISNULL(P.HBCLNM,'')))) AS BlockTeamName
        , MAX(B.HBCEMAIL) AS HBCEMAIL
        , MAX(B.HTCDSC)   AS HTCDSC
        , ISNULL(CAST(P.RunPeakNight AS INT, 0) AS RunPeakNight
    FROM Peak P
    INNER JOIN #B B
        ON B.SortOrderBlkNameNo = P.SortOrderBlkNameNo
       AND B.HBCORG = P.HBCORG
       AND B.HBCLNM = P.HBCLNM
       AND B.HBCFNM = P.HBCFNM
       AND B.HTNNO  = P.HTNNO
    GROUP BY
          P.SortOrderBlkNameNo
        , P.HBCORG, P.HBCFNM, P.HBCLNM, P.HTNNO
        , P.RunPeakNight
    ORDER BY
        P.SortOrderBlkNameNo;                      -- exact Crystal Group #2 key order
END
