          private static DateTime? ParseNullableDateTimeLocal(string s)
          {
               if (DateTime.TryParse((s ?? "").Trim(),
                                     CultureInfo.InvariantCulture,
                                     DateTimeStyles.AssumeLocal, out var dt))
                    return dt;
               return null;
          }

