     private void RenderToHttp(string format, string contentType, string downloadName, string deviceInfo = null, bool forceDownloadForPdf = false)
          {
               TraceLog($"ENTER RenderToHttp | format={format} | name={downloadName}", stage: "ENTER");

               // ✅ For long PDF runs
               Server.ScriptTimeout = 3600;

               Warning[] warnings;
               string[] streams;
               string mimeType, encoding, extension;

               // helper: log to App_Data/logs/report_errors.txt
               void LogLine(string stage, string message, Exception ex = null)
               {
                    try
                    {
                         string logDir = Server.MapPath("~/App_Data/logs");
                         Directory.CreateDirectory(logDir);

                         string logFile = Path.Combine(logDir, "report_errors.txt");

                         var stamp = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);
                         using (var sw = new StreamWriter(logFile, true))
                         {
                              sw.WriteLine("==== " + stamp + " ====");
                              sw.WriteLine("Stage: " + stage);
                              sw.WriteLine("Format: " + (format ?? ""));
                              sw.WriteLine("DownloadName: " + (downloadName ?? ""));

                              if (!string.IsNullOrWhiteSpace(message))
                                   sw.WriteLine("Message: " + message);

                              if (ex != null)
                              {
                                   sw.WriteLine("Exception: " + ex.GetType().FullName);
                                   sw.WriteLine("Error: " + ex.Message);
                                   sw.WriteLine("Stack: " + ex.StackTrace);
                              }

                              sw.WriteLine();
                         }
                    }
                    catch { }
               }

               // Base filename
               var safeName = string.IsNullOrWhiteSpace(downloadName) ? "Report" : downloadName.Trim();

               // Determine "PDF mode" early
               bool wantPdf =
                   string.Equals(format ?? "", "PDF", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(contentType ?? "", "application/pdf", StringComparison.OrdinalIgnoreCase) ||
                   safeName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

               // ============================================================
               // ✅ FAST PATH: PDF => stream to disk (avoid giant byte[] in RAM)
               // ============================================================

               if (wantPdf)
               {
                    if (!safeName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                         safeName = Path.ChangeExtension(safeName, ".pdf");

                    string tmpDir = Server.MapPath("~/App_Data/tmp");
                    Directory.CreateDirectory(tmpDir);

                    string baseName = "rpt_" + Guid.NewGuid().ToString("N");
                    var streamFiles = new List<string>();

                    try
                    {
                        // LogLine("RenderStart(PDF-Stream)", "Attempting LocalReport.Render(PDF) -> tmp streams");

                         int streamIndex = 0;

                         Stream CreateStream(string name, string ext, System.Text.Encoding enc, string mt, bool willSeek)
                         {
                              streamIndex++; // ✅ unique per call

                              string safeExt = string.IsNullOrWhiteSpace(ext) ? "pdf" : ext.TrimStart('.');
                              string safePart = string.IsNullOrWhiteSpace(name) ? "main" : name;

                              string path = Path.Combine(tmpDir, $"{baseName}_{safePart}_{streamIndex:D3}.{safeExt}");
                              streamFiles.Add(path);

                              // Extra safe for scanners/locks
                              for (int attempt = 1; attempt <= 5; attempt++)
                              {
                                   try
                                   {
                                        return new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.ReadWrite);
                                   }
                                   catch (IOException)
                                   {
                                        if (attempt == 5) throw;
                                        System.Threading.Thread.Sleep(80);
                                   }
                              }

                              // will never hit
                              return new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.ReadWrite);
                         }

                         rv.LocalReport.Render("PDF", deviceInfo ?? string.Empty, CreateStream, out warnings);

                         // pick the actual pdf stream file
                         string pdfPath = streamFiles
                                                 .Where(f => f.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                 .OrderByDescending(f => new FileInfo(f).Length)
                                                 .FirstOrDefault()
                                                 ?? streamFiles.FirstOrDefault();


                         if (string.IsNullOrWhiteSpace(pdfPath) || !File.Exists(pdfPath))
                              throw new InvalidOperationException("PDF stream file not created by renderer.");

                         //LogLine("RenderSuccess(PDF-Stream)", "PDF created: " + pdfPath + " | Size=" + new FileInfo(pdfPath).Length);

                         // Optional cookie back to JS
                         var token = Request.Form["dlToken"];
                         if (!string.IsNullOrEmpty(token))
                         {
                              var cookie = new HttpCookie("fileDownloadToken", token) { Path = "/" };
                              Response.Cookies.Add(cookie);
                         }

                         Response.Clear();
                         Response.ClearHeaders();
                         Response.BufferOutput = false;

                         Response.ContentType = "application/pdf";
                         Response.AddHeader("X-Content-Type-Options", "nosniff");

                         string dispositionType = forceDownloadForPdf ? "attachment" : "inline";
                         string headerFilename = safeName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                             ? safeName
                             : safeName + ".pdf";

                         Response.AddHeader("Content-Disposition",
                             $"{dispositionType}; filename=\"{headerFilename}\"");

                         // ✅ Send file by streaming with permissive share + retry
                         const int BUF = 64 * 1024;

                         for (int attempt = 1; attempt <= 40; attempt++)
                         {
                              try
                              {
                                   using (var fs = new FileStream(
                                       pdfPath,
                                       FileMode.Open,
                                       FileAccess.Read,
                                       FileShare.ReadWrite | FileShare.Delete,
                                       BUF,
                                       FileOptions.SequentialScan))
                                   {
                                        fs.CopyTo(Response.OutputStream, BUF);
                                   }
                                   break; // ✅ success
                              }
                              catch (IOException)
                              {
                                   if (attempt == 40) throw;      // last try -> bubble up
                                   System.Threading.Thread.Sleep(125);
                              }
                         }

                         Response.Flush();
                         HttpContext.Current.ApplicationInstance?.CompleteRequest();
                         return;


                         //LogLine("SendSuccess(PDF-Stream)", "TransmitFile OK.");
                         //HttpContext.Current.ApplicationInstance?.CompleteRequest();

                         // ✅ NOTE: DO NOT delete here (TransmitFile may keep it locked).
                         // Cleanup old tmp files separately (I'll give helper if you want).
                         return;
                    }
                    catch (Exception ex)
                    {
                         Exception root = ex;
                         while (root.InnerException != null) root = root.InnerException;

                         LogLine("PDF-Stream-Fail", "Exception in PDF stream path.", root);

                         Response.Clear();
                         Response.TrySkipIisCustomErrors = true;
                         Response.StatusCode = 500;
                         Response.ContentType = "text/plain";
                         Response.Write(root.Message);
                         HttpContext.Current.ApplicationInstance?.CompleteRequest();
                         return;
                    }
               }

               // ============================================================
               // Normal path: non-PDF => keep existing byte[] render approach
               // ============================================================
               byte[] bytes;

               try
               {
                    LogLine("RenderStart", "Attempting LocalReport.Render(...)");

                    bytes = rv.LocalReport.Render(
                        format: string.IsNullOrWhiteSpace(format) ? "PDF" : format,
                        deviceInfo: deviceInfo ?? string.Empty,
                        mimeType: out mimeType,
                        encoding: out encoding,
                        fileNameExtension: out extension,
                        streams: out streams,
                        warnings: out warnings
                    );

                    LogLine("RenderSuccess", "Render complete. Bytes=" + (bytes?.Length ?? 0));
               }
               catch (Exception ex)
               {
                    Exception root = ex;
                    while (root.InnerException != null) root = root.InnerException;

                    LogLine("RenderFail", "Render threw.", root);

                    Response.Clear();
                    Response.TrySkipIisCustomErrors = true;
                    Response.StatusCode = 500;
                    Response.ContentType = "text/plain";
                    Response.Write(root.Message);
                    HttpContext.Current.ApplicationInstance?.CompleteRequest();
                    return;
               }

               try
               {
                    var token = Request.Form["dlToken"];
                    if (!string.IsNullOrEmpty(token))
                    {
                         var cookie = new HttpCookie("fileDownloadToken", token) { Path = "/" };
                         Response.Cookies.Add(cookie);
                    }

                    if (string.IsNullOrEmpty(Path.GetExtension(safeName)) && !string.IsNullOrEmpty(extension))
                         safeName += "." + extension.TrimStart('.');

                    var effectiveMime = string.IsNullOrWhiteSpace(contentType) ? mimeType : contentType;

                    Response.Clear();
                    Response.TrySkipIisCustomErrors = true;
                    Response.Buffer = true;
                    Response.BufferOutput = true;

                    Response.Cache.SetCacheability(HttpCacheability.NoCache);
                    Response.Cache.SetNoStore();
                    Response.Cache.SetExpires(DateTime.UtcNow.AddMinutes(-1));

                    Response.ContentType = effectiveMime;

                    // non-PDF always download
                    Response.AddHeader(
                        "Content-Disposition",
                        $"attachment; filename=\"{safeName.Replace("\"", string.Empty)}\"; filename*=UTF-8''{Uri.EscapeDataString(safeName.Replace("\"", string.Empty))}"
                    );

                    Response.BinaryWrite(bytes);
                    Response.Flush();

                    LogLine("SendSuccess", "Bytes sent to client OK.");
                    HttpContext.Current.ApplicationInstance?.CompleteRequest();
               }
               catch (Exception ex2)
               {
                    Exception root2 = ex2;
                    while (root2.InnerException != null) root2 = root2.InnerException;

                    LogLine("SendFail", "Failed while writing Response.", root2);

                    Response.Clear();
                    Response.TrySkipIisCustomErrors = true;
                    Response.StatusCode = 500;
                    Response.ContentType = "text/plain";
                    Response.Write(root2.Message);
                    HttpContext.Current.ApplicationInstance?.CompleteRequest();
                    return;
               }

               TraceLog("EXIT RenderToHttp", stage: "EXIT");
          }


