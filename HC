<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Report.aspx.cs" Inherits="ReportRDLC.Report16.ReportRdlc" %>
<%@ Register Assembly="Microsoft.ReportViewer.WebForms" Namespace="Microsoft.Reporting.WebForms" TagPrefix="rsweb" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>RDLC Report</title>
<%--  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css" />
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/js/bootstrap.min.js"></script>--%>
	<script src="Content/js/gapis.js"></script>
	<link href="Content/maxcdn1.css" rel="stylesheet" />
	<script src="Content/js/maxcd1.js"></script>
  <style>
			.overlay{position:fixed;left:0;top:0;width:100%;height:100%;background:#808080;opacity:.8;z-index:9999;display:none}
			
			.container{
				width:1300px !important;
			}
  </style>
  <script>function Loader(s) { if (s) $("#busy").show(); else $("#busy").hide(); }</script>
</head>
<body>
<form id="form1" runat="server" class="container classborder" style="margin-top:12px">
<div id="busy" class="overlay">
  <asp:Image ID="imgBusy" runat="server"
             ImageUrl="~/Report16/Images/ProgressImage.gif"
             AlternateText="Processing..."
             Style="display:block;margin:20% auto 0;" />
</div>

  <!-- FILTERS (shown only when ?Filter=... is present) -->
  <asp:Panel ID="pnlFilters" runat="server" Visible="false" CssClass="panel panel-default">
    <div class="panel-heading" style="font-size:25px;color:#336699;"><b><u>Optional Report Choices</u></b></div>
    <div class="panel-body form-horizontal">
      <asp:Literal ID="ltrParams" runat="server" />
      <div class="form-group">
        <div class="col-sm-12 btncontinue">

       <asp:Button ID="btnContinue" runat="server" Text="Continue" CssClass="btn btn-primary"
    OnClick="btnContinue_Click"
    OnClientClick="return startDownload();" />




        </div>
      </div>
    </div>
  </asp:Panel>

  <!-- Optional in-page preview when V is not P/E -->
  <asp:Panel ID="pnlViewer" runat="server" Visible="false">
    <rsweb:ReportViewer ID="rv" runat="server"
      AsyncRendering="false" SizeToReportContent="true"
      Width="100%" Height="900px" />
  </asp:Panel>

   <iframe id="downloadFrame" name="downloadFrame" style="display:none"></iframe>
<input type="hidden" id="dlToken" name="dlToken" />
</form>
<script>
	var dlPoll = null;
	window.__pdfSubmitArmed = false;
	function clearLoader() {
		Loader(false);
		if (dlPoll) { clearInterval(dlPoll); dlPoll = null; }
	}

	function startDownload() {
		var v = (new URLSearchParams(location.search)).get('V') || '';
		var V = v.toUpperCase();

		var isExcel = (V === 'E');
		var isPdf = (V === 'P');

		// Normal preview (no file)
		if (!isExcel && !isPdf) {
			Loader(true);
			return true;
		}

		var form = document.getElementById('<%= form1.ClientID %>');

		// ✅ PDF INLINE on SAME TAB (no loader, no iframe)
		//if (isPdf) {
		//	clearLoader();                 // hide overlay if it was visible
		//	try { form.removeAttribute('target'); } catch (e) { }  // ensure NOT stuck on downloadFrame
		//	return true;                   // normal postback -> PDF opens in same tab
		//}


		if (isPdf) {
			// ensure NOT stuck on iframe target from Excel flow
			try { form.removeAttribute('target'); } catch (e) { }

			// 2nd click: allow normal postback so server renders PDF
			if (window.__pdfSubmitArmed) {
				window.__pdfSubmitArmed = false;
				return true;
			}

			// 1st click: show loader, then re-click after UI paints
			Loader(true);
			window.__pdfSubmitArmed = true;

			setTimeout(function () {
				document.getElementById('<%= btnContinue.ClientID %>').click();
    }, 50);

			return false; // cancel immediate submit
		}


		// ✅ EXCEL download -> keep your existing cookie polling flow (no change)
		var token = Date.now().toString();
		document.getElementById('dlToken').value = token;

		document.cookie = 'fileDownloadToken=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';

		form.setAttribute('target', 'downloadFrame');

		Loader(true);

		dlPoll = setInterval(function () {
			if (document.cookie.indexOf('fileDownloadToken=' + token) !== -1) {
				clearLoader();
				form.removeAttribute('target');
				document.cookie = 'fileDownloadToken=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
			}
		}, 400);

		setTimeout(function () {
			clearLoader();
			form.removeAttribute('target');
		}, 120000);

		return true;
	}

</script>



</body>
    

</html>

