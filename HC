Crystal sp  
  
CREATE PROCEDURE [dbo].[sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams_RDLC]   
  
@EMNNO int  
  
  
As  
Set NoCount On   
SET ANSI_WARNINGS OFF   
  
SELECT   
        EVENTS.EMNNO,   
        EVENTS.EMCACRO,  
        EVENTS.EMCPRO,  
        HOTELROOMBLOCKS.HBNNO,   
        HOTELROOMBLOCKS.HBCACRO,   
        ROOMCATEGORIES.RCCDESC,   
        HOTELROOMBLOCKS.HBCNO,   
        HOTELROOMBLOCKS.HBCORG,   
        HOTELROOMBLOCKS.HBCFNM,   
        HOTELROOMBLOCKS.HBCLNM,   
        HOTELROOMBLOCKS.HBCTEL,   
        HOTELROOMBLOCKS.HBDTSTART,  
        HOTELROOMBLOCKS.HBDTXLD,     
        ROOMCATEGORIES.RCCACRO,   
        HOTEL.HTNNO,   
        EVENTS.EMDTBEG,   
        EVENTS.EMDTEND,   
        EVENTS.EMCNM,   
        HOTEL.HTCDSC,   
        HOTELROOMBLOCKS.HBNAPPROVED,   
        HOTELROOMBLOCKS.HTNNO,   
  HOTELROOMBLOCKS.HBDTAPPROVED,  
        HOTEL.EMNNO,   
        RESERVATIONS.RSNNO,  
        RESERVATIONS.RSDTARR,  
        RESERVATIONS.RSDTDEP,  
        RESERVATIONS.RSDTXLD,  
        REGMST.RGNNO,  
        REGMST.RGCNO,  
        REGMST.RGCPLNM,  
        REGMST.RGCPFNM,  
        REGMST.RGCPCITY,  
        REGMST.RGCPST,  
        REGMST.RGCEMAIL,  
        isnull(BLOCK_INVENTORY.Block_Amount_Reserved,0) Block_Total_Amount_Reserved,   
        isnull(BLOCK_INVENTORY.Block_Remaining_Available,0) Block_Total_Remaining_Available,   
        isnull(BLOCK_INVENTORY.Block_Adjustments,0) Block_Total_Adjustments,   
        isnull(BLOCK_INVENTORY.Max_Reserved,0) Block_Max_Reserved,   
        isnull(BLOCK_INVENTORY.Max_Requested,0) Block_Max_Requested,   
        isnull(sum(BLOCK_PICKUPS.Block_Pickups),0) Block_Total_Pickups,   
        isnull(max(BLOCK_PICKUPS.Block_Pickups),0) Block_Max_Pickups,   
      --  isnull(max(BLOCK_PICKUPS.Block_Pickups),0) Block_Max_Pickups_2,   
  isnull(max(BLOCK_INVENTORY.BLOCK_RESERVED_ADJUSTED),0) BLOCK_RESERVED_ADJUSTED  
FROM     
        HOTEL   
        LEFT OUTER JOIN HOTELROOMBLOCKS ON HOTEL.HTNNO=HOTELROOMBLOCKS.HTNNO   
        LEFT OUTER JOIN RESERVATIONS ON HOTELROOMBLOCKS.HBNNO=RESERVATIONS.HBNNO  
        LEFT OUTER JOIN REGMST on REGMST.RGNNO=RESERVATIONS.RGNNO  
        LEFT OUTER JOIN EVENTS ON HOTEL.EMNNO=EVENTS.EMNNO   
        LEFT OUTER JOIN ROOMCATEGORIES ON HOTELROOMBLOCKS.RCNNO=ROOMCATEGORIES.RCNNO   
        LEFT OUTER JOIN (   
                SELECT   
                        EVENTS.EMNNO,   
                        HOTELROOMBLOCKS.HBNNO,   
                        max(RBNAMOUNTREQUESTED) Max_Requested,    
                        max(RBNAMOUNTRESERVED) Max_Reserved,   
                        sum(HOTELROOMBLOCKINVENTORY.RBNAMOUNTRESERVED) Block_Amount_Reserved,   
                        sum(HOTELROOMBLOCKINVENTORY.RBNREMAININGAVAILABLE) Block_Remaining_Available,   
                        sum(HOTELROOMBLOCKINVENTORY.RBNADJUSTMENTS) Block_Adjustments,   
      max(HOTELROOMBLOCKINVENTORY.RBNAMOUNTRESERVED + HOTELROOMBLOCKINVENTORY.RBNADJUSTMENTS) BLOCK_RESERVED_ADJUSTED  
     -- max(HOTELROOMBLOCKINVENTORY.RBNAMOUNTRESERVED + HOTELROOMBLOCKINVENTORY.RBNADJUSTMENTS)-HOTELROOMBLOCKINVENTORY.RBNREMAININGAVAILABLE Block_Max_Pickups_2  
                FROM   
                        (((   
                        EVENTS INNER   
                        JOIN HOTEL ON EVENTS.EMNNO=HOTEL.EMNNO) INNER   
                        JOIN HOTELROOMBLOCKS  ON   
                        HOTEL.HTNNO=HOTELROOMBLOCKS.HTNNO) INNER JOIN   
                        HOTELROOMBLOCKINVENTORY ON   
                        HOTELROOMBLOCKS.HBNNO=HOTELROOMBLOCKINVENTORY.HBNNO)   
                WHERE   
                        EVENTS.EMNNO=@EMNNO and HOTELROOMBLOCKS.HBDTXLD is null and HOTELROOMBLOCKS.HBNAPPROVED=1  
                     --   And HOTELROOMBLOCKS.HBCLNM+HOTELROOMBLOCKS.HBCFNM<>'ReservationsCancelled'  
      And HOTELROOMBLOCKS.HBCLNM+HOTELROOMBLOCKS.HBCFNM<>'CompTournament'  
      And HOTELROOMBLOCKS.HBCLNM+HOTELROOMBLOCKS.HBCFNM<>'BillingsleyJohn'   
        
      --And  EVENTS.EMDTBEG>=@RGDTADD_FROM AND  EVENTS.EMDTBEG <=@RGDTADD_TO  
                GROUP BY   
                        EVENTS.EMNNO,  
                        EVENTS.EMCACRO,  
                        EVENTS.EMCPRO,  
                        HOTELROOMBLOCKS.HBNNO  
                   --     HOTELROOMBLOCKINVENTORY.RBNREMAININGAVAILABLE  
        
        ) BLOCK_INVENTORY ON EVENTS.EMNNO = BLOCK_INVENTORY.EMNNO   
        and HOTELROOMBLOCKS.HBNNO = BLOCK_INVENTORY.HBNNO   
        LEFT OUTER JOIN (   
                SELECT   
                        EVENTS.EMNNO,   
                        RESERVATIONS.HBNNO,   
                        RESNIGHTS.HINNO,   
                        count(RESNIGHTS.RSNNO) Block_Pickups   
                FROM   
                        (((EVENTS INNER   
                        JOIN REGMST ON EVENTS.EMNNO=REGMST.EMNNO) INNER   
                        JOIN RESERVATIONS ON   
                        REGMST.RGNNO=RESERVATIONS.RGNNO   
                                AND RESERVATIONS.RSDTXLD is NULL   
                                AND NOT RESERVATIONS.HBNNO is NULL) INNER JOIN   
                        RESNIGHTS ON   
                        RESERVATIONS.RSNNO=RESNIGHTS.RSNNO)   
                WHERE   
                        EVENTS.EMNNO=@EMNNO   
                        --And RESERVATIONS.RSDTXLD is null  
                GROUP BY   
                        EVENTS.EMNNO,  
                        EVENTS.EMCACRO,  
                        EVENTS.EMCPRO,  
                        RESERVATIONS.HBNNO,   
                        RESNIGHTS.HINNO   
        ) BLOCK_PICKUPS ON EVENTS.EMNNO = BLOCK_PICKUPS.EMNNO   
                and HOTELROOMBLOCKS.HBNNO = BLOCK_PICKUPS.HBNNO   
WHERE   
        EVENTS.EMNNO = @EMNNO and HOTELROOMBLOCKS.HBDTXLD is null and HOTELROOMBLOCKS.HBNAPPROVED=1  
          
          
    --    And isnull(HOTELROOMBLOCKS.HBCLNM,'')+isnull(HOTELROOMBLOCKS.HBCFNM,'')<>'ReservationsCancelled'  
  And isnull(HOTELROOMBLOCKS.HBCLNM,'')+isnull(HOTELROOMBLOCKS.HBCFNM,'')<>'CompTournament'  
  And isnull(HOTELROOMBLOCKS.HBCLNM,'')+isnull(HOTELROOMBLOCKS.HBCFNM,'')<>'BillingsleyJohn'   
  --And RESERVATIONS.RSDTXLD is null  
  --And  EVENTS.EMDTBEG>=@RGDTADD_FROM AND  EVENTS.EMDTBEG <=@RGDTADD_TO  
          
GROUP BY   
        EVENTS.EMNNO,   
        EVENTS.EMCACRO,  
        EVENTS.EMCPRO,  
        HOTELROOMBLOCKS.HBNNO,   
        HOTELROOMBLOCKS.HBCACRO,   
        ROOMCATEGORIES.RCCDESC,   
        HOTELROOMBLOCKS.HBCNO,   
        HOTELROOMBLOCKS.HBCORG,   
        HOTELROOMBLOCKS.HBCFNM,   
        HOTELROOMBLOCKS.HBCLNM,   
        HOTELROOMBLOCKS.HBCTEL,   
        HOTELROOMBLOCKS.HBDTSTART,   
        ROOMCATEGORIES.RCCACRO,   
        HOTEL.HTNNO,   
        EVENTS.EMDTBEG,   
        EVENTS.EMDTEND,   
        EVENTS.EMCNM,   
        HOTEL.HTCDSC,   
        HOTELROOMBLOCKS.HBNAPPROVED,   
        HOTELROOMBLOCKS.HBDTXLD,  
        HOTELROOMBLOCKS.HTNNO,  
  HOTELROOMBLOCKS.HBDTAPPROVED,   
        HOTEL.EMNNO,   
          
        isnull(BLOCK_INVENTORY.Block_Amount_Reserved,0),   
        isnull(BLOCK_INVENTORY.Block_Remaining_Available,0),   
        isnull(BLOCK_INVENTORY.Block_Adjustments,0),   
        isnull(BLOCK_INVENTORY.Max_Reserved,0),   
        isnull(BLOCK_INVENTORY.Max_Requested,0),  
  
  RESERVATIONS.RSNNO,  
  RESERVATIONS.RSDTARR,  
        RESERVATIONS.RSDTDEP,  
        RESERVATIONS.RSDTXLD,  
        REGMST.RGNNO,  
        REGMST.RGCNO,  
        REGMST.RGCPLNM,  
        REGMST.RGCPFNM,  
        REGMST.RGCPCITY,  
        REGMST.RGCPST,  
        REGMST.RGCEMAIL  
  
  
  Crystal Sub report SQL
   SELECT "EVENTS"."EMNNO", "HOTEL"."HTNNO", "HOTEL"."HTCACRO", "HOTEL"."HTCDSC", "EVENTS"."EMDTBEG", "EVENTS"."EMDTEND", "ROOMCATEGORIES"."RCCACRO", "ROOMCATEGORIES"."RCNNO", "HOTELROOMTYPECOSTS"."HCNCOST", "HOTELINVENTORY"."HINAMOUNTRESERVED", "HOTELROOMCATEGORIES"."HRNNO"
 FROM   (((("ICM"."dbo"."EVENTS" "EVENTS" INNER JOIN "ICM"."dbo"."HOTEL" "HOTEL" ON "EVENTS"."EMNNO"="HOTEL"."EMNNO") INNER JOIN "ICM"."dbo"."HOTELROOMCATEGORIES" "HOTELROOMCATEGORIES" ON "HOTEL"."HTNNO"="HOTELROOMCATEGORIES"."HTNNO") INNER JOIN "ICM"."dbo"."HOTELINVENTORY" "HOTELINVENTORY" ON "HOTELROOMCATEGORIES"."HRNNO"="HOTELINVENTORY"."HRNNO") INNER JOIN "ICM"."dbo"."ROOMCATEGORIES" "ROOMCATEGORIES" ON "HOTELROOMCATEGORIES"."RCNNO"="ROOMCATEGORIES"."RCNNO") INNER JOIN "ICM"."dbo"."HOTELROOMTYPECOSTS" "HOTELROOMTYPECOSTS" ON "HOTELINVENTORY"."HINNO"="HOTELROOMTYPECOSTS"."HINNO"
 WHERE  "HOTEL"."HTNNO"=23880
 ORDER BY "EVENTS"."EMNNO"
 
 
 
 Crystal report formuals
 
 #Nights
 if not isnull ({sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.RSDTXLD}) then
    0
else {sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.RSDTDEP}-{sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.RSDTARR}
  
  
  
  EventSort
  {sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.EMCACRO}+TOTEXT({sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.EMNNO})
  
  
  HotelSort
  {sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.HTCDSC}+Totext ({sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.HTNNO})
  
  
  Max_Reserved_adjusted
  if {sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.HBNAPPROVED}=0 then
    0
else {sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.BLOCK_RESERVED_ADJUSTED}


MaxPickup
if {sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.HBNAPPROVED}=0 then 
    0
else {sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.Block_Max_Pickups}


NameSort
{sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.RGCPLNM}+
{sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.RGCPFNM}+
totext({sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.RSNNO})

  
  ResetHotelBlockReservedAdjust
  WhilePrintingRecords;
NumberVar HotelBlkMaxResAdj := 0


ResetRunBlockReservedAdjust
WhilePrintingRecords;
NumberVar BlkMaxResAdj := 0
  
  RoomNights
  ({sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.Block_Total_Amount_Reserved}+{sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.Block_Total_Adjustments})-{sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.Block_Total_Remaining_Available}
  
  
  SubBlk_Sort
  if isnull ({sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.HBCACRO}) then
    {sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.HBCNO}+totext({sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.HBNNO})
else {sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.HBCACRO}+totext({sp_ICM_RPT_Inventory_Events_Block_Rollup_NoParams;1.HBNNO}

