@{
     Layout = null;   // remove this if you want to use your site layout
}

<!DOCTYPE html>
<html lang="en">
<head>
     <meta charset="UTF-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>Confirmation Options</title>

     <style>
          * {
               box-sizing: border-box;
          }

          body {
               margin: 0;
               font-family: "Segoe UI", Arial, sans-serif;
               min-height: 100vh;
               background: linear-gradient(135deg, #eef2f7, #dfe7f3);
               display: flex;
               align-items: center;
               justify-content: center;
               padding: 30px 15px;
               color: #1f2937;
          }

          .confirmation-page {
               width: 100%;
               max-width: 760px;
          }

          .confirmation-card {
               background: #ffffff;
               border-radius: 16px;
               box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12);
               border: 1px solid rgba(0, 0, 0, 0.06);
               padding: 34px 38px 30px;
               position: relative;
          }

          .close-btn {
               position: absolute;
               top: 16px;
               right: 18px;
               width: 38px;
               height: 38px;
               border: none;
               border-radius: 50%;
               background: #f3f4f6;
               color: #374151;
               font-size: 24px;
               cursor: pointer;
               transition: all 0.2s ease;
          }

               .close-btn:hover {
                    background: #e5e7eb;
                    transform: scale(1.05);
               }

          .title {
               text-align: center;
               font-size: 30px;
               font-weight: 700;
               margin: 8px 0 8px;
               color: #111827;
          }

          .subtitle {
               text-align: center;
               font-size: 14px;
               color: #6b7280;
               margin-bottom: 30px;
          }

          .section {
               margin-bottom: 26px;
          }

          .row-inline {
               display: flex;
               align-items: center;
               gap: 14px;
               flex-wrap: wrap;
          }

          .action-btn {
               min-width: 115px;
               height: 44px;
               border: none;
               border-radius: 10px;
               font-size: 14px;
               font-weight: 600;
               cursor: pointer;
               transition: all 0.2s ease;
               box-shadow: 0 4px 10px rgba(0,0,0,0.08);
          }

          .email-btn {
               background: linear-gradient(135deg, #2563eb, #1d4ed8);
               color: #fff;
          }

               .email-btn:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 8px 16px rgba(37, 99, 235, 0.22);
               }

          .print-btn {
               background: #ffffff;
               color: #111827;
               border: 1px solid #d1d5db;
          }

               .print-btn:hover {
                    background: #f9fafb;
                    transform: translateY(-1px);
               }

          .label-main {
               font-size: 16px;
               font-weight: 600;
               color: #111827;
          }

          .field-label {
               display: block;
               margin-bottom: 10px;
               font-size: 16px;
               font-weight: 600;
               color: #111827;
          }

          .textarea-wrap {
               background: #f9fafb;
               border: 1px solid #dbe1ea;
               border-radius: 14px;
               padding: 12px;
          }

          textarea {
               width: 100%;
               min-height: 190px;
               border: none;
               outline: none;
               resize: vertical;
               background: transparent;
               font-size: 15px;
               line-height: 1.7;
               color: #1f2937;
               font-family: "Segoe UI", Arial, sans-serif;
          }

          .bottom-row {
               display: flex;
               align-items: center;
               gap: 14px;
               flex-wrap: wrap;
               margin-top: 22px;
          }

          .note-box {
               margin-top: 28px;
               background: #eff6ff;
               border: 1px solid #bfdbfe;
               border-radius: 12px;
               padding: 14px 16px;
               font-size: 14px;
               color: #1e40af;
          }

          @@media (max-width: 576px) {
               .confirmation-card {
                    padding: 24px 18px 22px;
               }

               .title {
                    font-size: 24px;
                    padding-right: 30px;
               }

               .action-btn {
                    width: 100%;
               }

               .row-inline,
               .bottom-row {
                    align-items: stretch;
               }
          }

          @@media print {
               body {
                    background: #fff;
                    padding: 0;
               }

               .confirmation-card {
                    box-shadow: none;
                    border: none;
               }

               .close-btn,
               .note-box {
                    display: none !important;
               }

               .action-btn {
                    box-shadow: none;
               }
          }
     </style>
</head>
<body>

     <div class="confirmation-page">
          <div class="confirmation-card">
               <button type="button" class="close-btn" onclick="closePage()">×</button>

               <div class="title">Confirmation Options</div>
               <div class="subtitle">Send or print your room block confirmation</div>

               <div class="section">
                    <div class="row-inline">
                         <button type="button" class="action-btn email-btn" onclick="sendEmail()">EMAIL</button>
                         <span class="label-main">Send confirmation via Email</span>
                    </div>
               </div>

               <div class="section">
                    <label for="txtMessage" class="field-label">Message to include in Emailed Confirmation</label>

                    <div class="textarea-wrap">
                         <textarea id="txtMessage">Thank you for your request for a group block at this year's Jsimple's Best Ever Test Event.

Attached is a detailed acknowledgement of your request. Please review for accuracy.</textarea>
                    </div>
               </div>

               <div class="bottom-row">
                    <button type="button" class="action-btn print-btn" onclick="printPage()">PRINT</button>
                    <span class="label-main">Print this confirmation</span>
               </div>

               <div class="note-box">
                    Please review the message before sending the confirmation.
               </div>
          </div>
     </div>
</body>
</html>




