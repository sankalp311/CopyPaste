<script>
    var acoUserAccessLevel = parseInt($("#hid_userAccessLevel").val() || "0");

    function acoTrim(value) {
        return (value || "").toString().trim();
    }

    function isAcoSaved() {
        return acoTrim($("#RGD_ACO_CREATE_TIME").text()) !== "";
    }

    function getAcoAddRequest() {
        return acoTrim($("#RGC_ACO_ADD_REQUEST").val());
    }

    function hideAcoCcErrors() {
        $("#CCErrorMsg").attr("hidden", true);
        $("#CCErrorMsg1").attr("hidden", true);
        $("#CCErrorMsg4").attr("hidden", true);
        $("#CCErrorMsg5").attr("hidden", true);
        $("#CCErrorMsg6").attr("hidden", true);
        $("#RegACO_CCCVVError").attr("hidden", true);
    }

    function setAcoCcRequired(isRequired) {
        $("#RGC_ACO_CCTYPE").prop("required", isRequired);
        $("#RGC_ACO_CCCVV").prop("required", isRequired);
        $("#RGC_ACO_CCEXP").prop("required", isRequired);
        $("#RGC_ACO_CCNAME").prop("required", isRequired);

        if (isRequired) {
            $("#ccMandatoryText").show();
        } else {
            $("#ccMandatoryText").hide();
        }
    }

    function shouldShowCreditCardSection() {
        var addRequest = getAcoAddRequest();
        var saved = isAcoSaved();

        if (addRequest === "" || addRequest === "Shoulder_Nights") {
            return false;
        }

        if (addRequest === "Suite_Upgrade") {
            return true;
        }

        if (addRequest === "Aco") {
            if (!saved) {
                return true;
            }

            return acoUserAccessLevel === 1;
        }

        return false;
    }

    function isAcoCcMandatory() {
        return shouldShowCreditCardSection() && getAcoAddRequest() === "Aco";
    }

    function applyAcoCcRules() {
        var showCcSection = shouldShowCreditCardSection();
        var isMandatory = isAcoCcMandatory();

        if (showCcSection) {
            $("#creditCardSection").show();
        } else {
            $("#creditCardSection").hide();
            hideAcoCcErrors();
        }

        setAcoCcRequired(isMandatory);
    }

    function validateAcoCcSection() {
        hideAcoCcErrors();

        if (!isAcoCcMandatory()) {
            return true;
        }

        var ccType = acoTrim($("#RGC_ACO_CCTYPE").val());
        var ccNo = acoTrim($("#hid_token").val()) || acoTrim($("#RSCCCNOTemp").val());
        var cvv = acoTrim($("#RGC_ACO_CCCVV").val());
        var exp = acoTrim($("#RGC_ACO_CCEXP").val());
        var name = acoTrim($("#RGC_ACO_CCNAME").val());

        var isValid = true;

        if (ccType === "") {
            $("#CCErrorMsg1").removeAttr("hidden");
            isValid = false;
        }

        if (ccNo === "") {
            $("#CCErrorMsg6").removeAttr("hidden");
            isValid = false;
        }

        if (cvv === "") {
            $("#RegACO_CCCVVError").removeAttr("hidden");
            isValid = false;
        }

        if (exp === "") {
            $("#CCErrorMsg4").removeAttr("hidden");
            isValid = false;
        }

        if (name === "") {
            $("#CCErrorMsg5").removeAttr("hidden");
            isValid = false;
        }

        if (!isValid) {
            if (typeof toastr !== "undefined") {
                toastr.error("Please fill mandatory Credit Card Information.");
            } else {
                alert("Please fill mandatory Credit Card Information.");
            }
        }

        return isValid;
    }

    function SaveAcoPage(rgnno) {
        applyAcoCcRules();

        if (!validateAcoCcSection()) {
            return false;
        }

        if (typeof SaveAco === "function") {
            SaveAco(rgnno);
            return true;
        }

        return false;
    }

    $(document).ready(function () {
        applyAcoCcRules();

        $("#RGC_ACO_ADD_REQUEST").on("change", function () {
            applyAcoCcRules();
        });
    });
</script>


