using Microsoft.Reporting.WebForms;
using System;
using System.Configuration;
using System.Data;
using System.Data.SqlClient;
using System.Web;
using System.Web.UI;

namespace ICM.Reports
{
     public partial class HotelConfirmation : Page
     {
          private const string DS_ROOMLIST = "DsRoomList";   // ResultSet 1
          private const string DS_CHANGELOG = "DsChangeLog";  // ResultSet 2
          private const string DS_HEADER = "DsHeader";     // ResultSet 3

          // Your RDLC location
          private const string REPORT_PATH = "~/Report16/HotelConfirmation.rdlc";

          protected void Page_Load(object sender, EventArgs e)
          {
               if (!IsPostBack)
                    DownloadPdf();
          }

          private void DownloadPdf()
          {
               string emnno = QS("EMNNO");
               string htnno = QS("HTNNO");
               string runTimeStr = QS("RunTime");

               DateTime runTime;
               bool hasRunTime = DateTime.TryParse(runTimeStr, out runTime);

               DataSet ds = GetDataFromSp(
                   emnno: emnno,
                   htnno: htnno,
                   runTime: hasRunTime ? (DateTime?)runTime : null
               );

               DataTable t0 = (ds.Tables.Count > 0) ? ds.Tables[0] : new DataTable(); // RoomList
               DataTable t1 = (ds.Tables.Count > 1) ? ds.Tables[1] : new DataTable(); // ChangeLog
               DataTable t2 = (ds.Tables.Count > 2) ? ds.Tables[2] : new DataTable(); // Header

               // OPTIONAL: give names for clarity/debugging
               t0.TableName = DS_ROOMLIST;
               t1.TableName = DS_CHANGELOG;
               t2.TableName = DS_HEADER;

               string rdlcPath = Server.MapPath(REPORT_PATH);
               if (string.IsNullOrWhiteSpace(rdlcPath) || !System.IO.File.Exists(rdlcPath))
                    throw new Exception("RDLC file not found at: " + REPORT_PATH);

               LocalReport report = new LocalReport
               {
                    ReportPath = rdlcPath
               };

               report.DataSources.Clear();

               // ✅ Main dataset
               report.DataSources.Add(new ReportDataSource(DS_ROOMLIST, t0));

               // ✅ Add this extra alias to prevent: "Cannot create a data reader for dataset 'HC'"
               // If your RDLC still references dataset name HC anywhere, it will use this and NOT execute internal query.
               report.DataSources.Add(new ReportDataSource("HC", t0));

               // ✅ Other datasets
               report.DataSources.Add(new ReportDataSource(DS_CHANGELOG, t1));
               report.DataSources.Add(new ReportDataSource(DS_HEADER, t2));

               // Render
               string mimeType, encoding, extension;
               Warning[] warnings;
               string[] streams;

               string deviceInfo = $@"<DeviceInfo>
  <OutputFormat>PDF</OutputFormat>
  <PageWidth>10in</PageWidth>
  <MarginTop>0.25in</MarginTop>
  <MarginLeft>0.25in</MarginLeft>
  <MarginRight>0.25in</MarginRight>
  <MarginBottom>0.25in</MarginBottom>
</DeviceInfo>";

               byte[] pdfBytes = report.Render(
                   "PDF",
                   deviceInfo,
                   out mimeType,
                   out encoding,
                   out extension,
                   out streams,
                   out warnings
               );


               // Download
               Response.Clear();
               Response.Buffer = true;
               Response.ContentType = "application/pdf";
               Response.AddHeader("Content-Disposition", "attachment; filename=HotelConfirmation.pdf");
               Response.Cache.SetCacheability(HttpCacheability.NoCache);
               Response.BinaryWrite(pdfBytes);
               Response.Flush();
               Context.ApplicationInstance.CompleteRequest();
          }

          private DataSet GetDataFromSp(string emnno, string htnno, DateTime? runTime)
          {
               DataSet ds = new DataSet();

               string cs = ConfigurationManager.ConnectionStrings["ICMReportConnectionString"].ConnectionString;

               using (SqlConnection con = new SqlConnection(cs))
               using (SqlCommand cmd = new SqlCommand("dbo.SP_ICM_RoomList_New_Change_Xld_RDLC", con))
               {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.CommandTimeout = 300;

                    if (!string.IsNullOrWhiteSpace(emnno))
                         cmd.Parameters.Add("@EMNNO", SqlDbType.VarChar, 10).Value = emnno.Trim();

                    if (!string.IsNullOrWhiteSpace(htnno))
                         cmd.Parameters.Add("@HTNNO", SqlDbType.VarChar, 10).Value = htnno.Trim();

                    if (runTime.HasValue)
                         cmd.Parameters.Add("@RunTime", SqlDbType.DateTime).Value = runTime.Value;

                    using (SqlDataAdapter da = new SqlDataAdapter(cmd))
                    {
                         da.Fill(ds);
                    }
               }

               return ds;
          }

          private string QS(string key)
          {
               return Request.QueryString[key] ?? Request.QueryString[key.ToLowerInvariant()] ?? "";
          }
     }
}
