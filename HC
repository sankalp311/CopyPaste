          /// <summary>
          /// Renders the current LocalReport as Excel (OpenXML), applies light ClosedXML polish, and streams.
          /// </summary>
       
          private void SendExcel(string downloadName = "Report.xlsx")
          {
               TraceLog($"ENTER SendExcel | name={downloadName}", stage: "ENTER");

               byte[] bytes = null;

               // -------- helpers (dynamic) --------
               string StripLocale(string fmt)
               {
                    if (string.IsNullOrWhiteSpace(fmt)) return fmt;

                    // keep RDLC format but remove locale tags if you want
                    // If you want to KEEP the locale prefix, comment the next line.
                    fmt = Regex.Replace(fmt, @"\[\$\-[^\]]+\]", "", RegexOptions.IgnoreCase);

                    // only positive format section (before ';')
                    int semi = fmt.IndexOf(';');
                    if (semi > 0) fmt = fmt.Substring(0, semi);

                    return fmt.Trim();
               }

               bool LooksLikeDateFormat(string fmt)
               {
                    if (string.IsNullOrWhiteSpace(fmt)) return false;
                    fmt = StripLocale(fmt).ToLowerInvariant();

                    bool hasY = fmt.Contains("y");
                    bool hasM = fmt.Contains("m");
                    bool hasD = fmt.Contains("d");

                    // date-like if (year and month/day) OR (month+day)
                    return (hasY && (hasM || hasD)) || (hasM && hasD);
               }

               bool TryParseDateText(string s, out DateTime dt)
               {
                    dt = default;
                    if (string.IsNullOrWhiteSpace(s)) return false;
                    s = s.Trim();

                    // en-US works for: 01/28/2026 and "16 March, 2026"
                    var culture = new CultureInfo("en-US");

                    // try exact common formats first
                    string[] fmts =
                    {
            "M/d/yyyy","MM/dd/yyyy","M/d/yy","MM/dd/yy",
            "d MMMM, yyyy","dd MMMM, yyyy",
            "d-MMM-yyyy","dd-MMM-yyyy",
            "yyyy-MM-dd","yyyy/MM/dd"
        };

                    if (DateTime.TryParseExact(s, fmts, culture, DateTimeStyles.None, out dt))
                         return true;

                    // fallback parser (handles month names too)
                    return DateTime.TryParse(s, culture, DateTimeStyles.None, out dt);
               }

               // infer a reasonable Excel number format from a sample text date (only used when RDLC didn't export a date format)
               string InferFormatFromText(string s)
               {
                    if (string.IsNullOrWhiteSpace(s)) return "mm/dd/yyyy";
                    s = s.Trim();

                    // month names -> "16 March, 2026" style
                    if (Regex.IsMatch(s, @"[A-Za-z]"))
                    {
                         if (s.Contains(",")) return "d mmmm, yyyy";
                         return "d mmmm yyyy";
                    }

                    if (s.Contains("/")) return "mm/dd/yyyy";
                    if (s.Contains("-")) return "dd-mmm-yyyy";

                    return "mm/dd/yyyy";
               }

               // template: either built-in id (14/15/16/17/22) or custom format string
               (int? id, string fmt) FindDateTemplateForColumn(IXLWorksheet ws, int col, int dataStartRow, int lastRow)
               {
                    const int scanMax = 200;
                    int scanned = 0;

                    for (int r = dataStartRow; r <= lastRow && scanned < scanMax; r++)
                    {
                         var cell = ws.Cell(r, col);
                         if (cell.IsEmpty()) continue;

                         scanned++;

                         // If RDLC exported a format string, use it (best match to RDLC)
                         var f = cell.Style.NumberFormat.Format;
                         if (LooksLikeDateFormat(f))
                              return (null, StripLocale(f)); // keep RDLC style

                         // If RDLC exported a built-in date id, reuse it
                         int id = cell.Style.NumberFormat.NumberFormatId;
                         if (id == 14 || id == 15 || id == 16 || id == 17 || id == 22)
                              return (id, null);

                         // If it's text date, infer format from the text
                         if (cell.DataType == XLDataType.Text && TryParseDateText(cell.GetString(), out _))
                              return (null, InferFormatFromText(cell.GetString()));
                    }

                    return (null, null);
               }

               bool ColumnLooksLikeDate(IXLWorksheet ws, int col, int headerRow, int dataStartRow, int lastRow)
               {
                    // header hint reduces false-positives for numeric columns
                    string header = ws.Cell(headerRow, col).GetString().Trim().ToLowerInvariant();
                    bool headerHint =
                        header.Contains("date") ||
                        header.Contains("start") ||
                        header.Contains("end") ||
                        header.Contains("due") ||
                        header.Contains("cutoff") ||
                        header.Contains("dt");

                    int nonEmpty = 0, dateLike = 0, sampled = 0;
                    const int sampleMax = 60;

                    for (int r = dataStartRow; r <= lastRow && sampled < sampleMax; r++)
                    {
                         var cell = ws.Cell(r, col);
                         if (cell.IsEmpty()) continue;

                         nonEmpty++;
                         sampled++;

                         bool isDateLike =
                             cell.DataType == XLDataType.DateTime ||
                             (cell.DataType == XLDataType.Number && (LooksLikeDateFormat(cell.Style.NumberFormat.Format) ||
                                 (cell.Style.NumberFormat.NumberFormatId == 14 || cell.Style.NumberFormat.NumberFormatId == 15 ||
                                  cell.Style.NumberFormat.NumberFormatId == 16 || cell.Style.NumberFormat.NumberFormatId == 17 ||
                                  cell.Style.NumberFormat.NumberFormatId == 22))) ||
                             (cell.DataType == XLDataType.Text && TryParseDateText(cell.GetString(), out _));

                         if (isDateLike) dateLike++;

                         // also treat numeric in typical Excel date-serial range as "maybe date"
                         if (cell.DataType == XLDataType.Number && headerHint)
                         {
                              double v;
                              if (double.TryParse(cell.GetValue<string>(), out v) && v >= 1 && v <= 80000)
                                   dateLike++;
                         }
                    }

                    if (nonEmpty < 3) return false;

                    // stricter unless header hints it's a date
                    double ratio = (double)dateLike / (double)nonEmpty;
                    return headerHint ? ratio >= 0.60 : ratio >= 0.80;
               }

               void NormalizeDateColumnsPreserveRdlc(IXLWorksheet ws)
               {
                    var used = ws.RangeUsed();
                    if (used == null) return;

                    int headerRow = used.RangeAddress.FirstAddress.RowNumber;
                    int lastRow = used.RangeAddress.LastAddress.RowNumber;
                    int firstCol = used.RangeAddress.FirstAddress.ColumnNumber;
                    int lastCol = used.RangeAddress.LastAddress.ColumnNumber;

                    int dataStartRow = Math.Min(headerRow + 1, lastRow);

                    for (int c = firstCol; c <= lastCol; c++)
                    {
                         string header = (ws.Cell(headerRow, c).GetString() ?? "").Trim().ToLowerInvariant();

                         bool headerSaysDate =
                             header.Contains("date") ||
                             header.EndsWith(" dt") ||
                             header.EndsWith("dt") ||
                             header.Contains("start") ||
                             header.Contains("end") ||
                             header.Contains("approved") && header.Contains("dt");

                         // ✅ If header says date -> FORCE treat as date column (dynamic)
                         if (!headerSaysDate && !ColumnLooksLikeDate(ws, c, headerRow, dataStartRow, lastRow))
                              continue;

                         // 1) Find template (from RDLC/exported cells)
                         var tpl = FindDateTemplateForColumn(ws, c, dataStartRow, lastRow);
                         int? tplId = tpl.id;
                         string tplFmt = tpl.fmt;

                         if (tplId == null && string.IsNullOrWhiteSpace(tplFmt))
                              tplFmt = "mm/dd/yyyy hh:mm:ss AM/PM"; // safe default

                         // 2) Apply format to whole column
                         if (tplId.HasValue)
                         {
                              ws.Column(c).Style.NumberFormat.NumberFormatId = tplId.Value;
                              ws.Column(c).Style.NumberFormat.Format = "";
                         }
                         else
                         {
                              ws.Column(c).Style.NumberFormat.Format = tplFmt;
                         }

                         // 3) Convert text dates to real dates
                         for (int r = dataStartRow; r <= lastRow; r++)
                         {
                              var cell = ws.Cell(r, c);
                              if (cell.IsEmpty()) continue;

                              if (cell.DataType == XLDataType.Text && TryParseDateText(cell.GetString(), out var dt))
                                   cell.Value = dt;
                         }

                         // 4) ✅ Fix 1899/serial 0 dates ALWAYS
                         int fixedCount = FixExcelZeroDatesInDateColumn(ws, c, dataStartRow, lastRow);
                         if (fixedCount > 0)
                              TraceLog($"EXCEL ZeroDateFix | Sheet={ws.Name} | Col={c} | Header='{header}' | Fixed={fixedCount}", stage: "EXCEL");
                    }
               }

               // -------- main --------
               try
               {
                    string cs = ConfigurationManager.ConnectionStrings["ICMReportConnectionString"].ConnectionString;
                    string rptId = (Q("RptId") ?? "").Trim();
                    bool showGridLines = GetExcelGridLinesFlag(cs, rptId);

                    Warning[] warnings; string[] streams; string mimeType, encoding, extension;
                    const string deviceInfoExcel = "<DeviceInfo><SimplePageHeaders>True</SimplePageHeaders></DeviceInfo>";

                    bytes = rv.LocalReport.Render(
                        format: "EXCELOPENXML",
                        deviceInfo: deviceInfoExcel,
                        mimeType: out mimeType,
                        encoding: out encoding,
                        fileNameExtension: out extension,
                        streams: out streams,
                        warnings: out warnings
                    );

                    if (bytes == null || bytes.Length < 4)
                         throw new Exception("RDLC returned empty Excel bytes.");

                    if (!(bytes[0] == (byte)'P' && bytes[1] == (byte)'K'))
                         throw new Exception("RDLC did not return a valid XLSX (PK header missing).");

                    bool skipClosedXml = (bytes.Length >= 40 * 1024 * 1024);


                    if (!skipClosedXml)
                    {
                         using (var inMs = new MemoryStream(bytes))
                         using (var wb = new XLWorkbook(inMs))
                         {
                              foreach (var ws in wb.Worksheets)
                              {
                                   ws.Style.Alignment.WrapText = false;
                                   ws.ShowGridLines = showGridLines;

                                   // ✅ This fixes: serial numbers showing for date columns AND text dates not behaving like dates
                                   // ✅ And it follows whatever date format RDLC exported (or infers from text)
                                   NormalizeDateColumnsPreserveRdlc(ws);

                                   // remove blank first row/first column (A1 padding)
                                   TrimLeadingBlankRowAndColumn(ws);

                              }

                              using (var outMs = new MemoryStream())
                              {
                                   wb.SaveAs(outMs);
                                   bytes = outMs.ToArray();
                              }
                         }
                    }

                    string safeName = string.IsNullOrWhiteSpace(downloadName) ? "Report.xlsx" : downloadName.Trim();
                    if (Path.GetExtension(safeName).Length == 0) safeName += ".xlsx";

                    var resp = HttpContext.Current.Response;

                    resp.Clear();
                    resp.ClearContent();
                    resp.ClearHeaders();
                    resp.Buffer = true;
                    resp.BufferOutput = true;
                    resp.Charset = "";
                    resp.ContentEncoding = Encoding.UTF8;
                    resp.StatusCode = 200;
                    resp.TrySkipIisCustomErrors = true;

                    var token = Request.Form["dlToken"];
                    if (!string.IsNullOrEmpty(token))
                    {
                         var cookie = new HttpCookie("fileDownloadToken", token)
                         {
                              Path = "/",
                              HttpOnly = false,
                              SameSite = SameSiteMode.Lax
                         };
                         resp.Cookies.Add(cookie);
                    }

                    resp.Cache.SetCacheability(HttpCacheability.NoCache);
                    resp.Cache.SetNoStore();
                    resp.Cache.SetExpires(DateTime.UtcNow.AddMinutes(-1));

                    resp.ContentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                    resp.AddHeader("Content-Disposition", $"attachment; filename=\"{safeName}\"");
                    resp.AddHeader("Content-Length", bytes.Length.ToString());

                    resp.BinaryWrite(bytes);
                    resp.Flush();

                    resp.SuppressContent = true;
                    HttpContext.Current.ApplicationInstance.CompleteRequest();

                    TraceLog("EXIT SendExcel", stage: "EXIT");
               }
               catch (Exception ex)
               {
                    TraceLog("SendExcel ERROR: " + ex, stage: "ERROR");

                    var resp = HttpContext.Current.Response;
                    resp.Clear();
                    resp.ClearContent();
                    resp.ClearHeaders();
                    resp.StatusCode = 500;
                    resp.TrySkipIisCustomErrors = true;
                    resp.ContentType = "text/plain";
                    resp.Write("Excel generation failed. Check server logs for details.");
                    resp.Flush();
                    resp.SuppressContent = true;
                    HttpContext.Current.ApplicationInstance.CompleteRequest();
               }
          }



          // -------- helper: remove leading blank row/col (Row 1 / Col 1) --------
          void TrimLeadingBlankRowAndColumn(IXLWorksheet ws)
     {
          // Safety: don't accidentally delete real headers if they exist
          const int maxTrim = 5;

          for (int i = 0; i < maxTrim; i++)
          {
               bool removed = false;

               // Look at "contents" only (ignore styles)
               var used = ws.RangeUsed(XLCellsUsedOptions.Contents);
               if (used == null) return;

               int firstUsedRow = used.RangeAddress.FirstAddress.RowNumber;
               int firstUsedCol = used.RangeAddress.FirstAddress.ColumnNumber;

               // If content starts below row 1 and row 1 has no content -> delete row 1
               if (firstUsedRow > 1 && !ws.Row(1).CellsUsed(XLCellsUsedOptions.Contents).Any())
               {
                    ws.Row(1).Delete();
                    removed = true;
               }

               used = ws.RangeUsed(XLCellsUsedOptions.Contents);
               if (used == null) return;

               firstUsedCol = used.RangeAddress.FirstAddress.ColumnNumber;

               // If content starts after col 1 and col 1 has no content -> delete col 1
               if (firstUsedCol > 1 && !ws.Column(1).CellsUsed(XLCellsUsedOptions.Contents).Any())
               {
                    ws.Column(1).Delete();
                    removed = true;
               }

               if (!removed) break; // nothing more to trim
          }
     }


         /// <summary>
     /// Resolves secure report token "t" (GUID) into the original inner querystring
     /// via stored procedure ICM.dbo.usp_ICM_ReportRequest_Resolve.
     /// Returns e.g. "V=E&Report=YES&RptId=867&EMNNO=20156&sessionid=123&Filter=...".
     /// </summary>
         private string ResolveReportToken(string token, string cs)
          {
               if (string.IsNullOrWhiteSpace(token)) return null;

               try
               {
                    using (var con = new SqlConnection(cs))
                    using (var cmd = new SqlCommand("ICM.dbo.usp_ICM_ReportRequest_Resolve", con))
                    {
                         cmd.CommandType = CommandType.StoredProcedure;
                         cmd.Parameters.Add("@Token", SqlDbType.NVarChar, 50).Value = token.Trim();

                         con.Open();
                         var o = cmd.ExecuteScalar();
                         if (o == null || o == DBNull.Value)
                              return null;

                         string inner = Convert.ToString(o);

                         // safety: trim spaces, remove any accidental leading '?'
                         inner = (inner ?? "").Trim();
                         if (inner.StartsWith("?", StringComparison.Ordinal))
                              inner = inner.Substring(1);

                         return inner;
                    }
               }
               catch (Exception ex)
               {
                    TraceLog($"ResolveReportToken error | t={token}", ex, stage: "TOKEN_ERROR");
                    return null;
               }
          }

          /// <summary>
          /// Load inner querystring from ?t=TOKEN into _secureQs.
          /// Example inner: "V=P&Report=YES&RptId=501&EMNNO=12774&sessionid=123&Filter=...".
          /// If no token, we leave _secureQs null and fall back to normal Request.QueryString.
          /// </summary>
          private void InitSecureQueryFromToken()
          {
               if (_secureQsInitialized) return;
               _secureQsInitialized = true;

              // var token = (Request.QueryString["t"] ?? "").Trim();
               var token = (Request.QueryString["t"] ?? Convert.ToString(RouteData.Values["t"]) ?? "").Trim();

               if (string.IsNullOrEmpty(token))
                    return; // normal flow, no token

               try
               {
                    string cs = ConfigurationManager.ConnectionStrings["ICMReportConnectionString"].ConnectionString;
                    string inner = ResolveReportToken(token, cs);   // calls your usp_ICM_ReportRequest_Resolve

                    if (string.IsNullOrWhiteSpace(inner))
                    {
                         // we *intentionally* leave _secureQs == null
                         TraceLog("InitSecureQueryFromToken: token not found or expired.", null, "SECURE");
                         return;
                    }

                    if (inner.StartsWith("?", StringComparison.Ordinal))
                         inner = inner.Substring(1);

                    _secureQs = HttpUtility.ParseQueryString(inner);
               }
               catch (Exception ex)
               {
                    TraceLog("InitSecureQueryFromToken failed for token=" + token, ex, "SECURE");
                    // on exception we also leave _secureQs == null → Page_Load will show error
               }
          }

          /// <summary>
          /// Central helper for ALL querystring access in this page.
          /// If we came via token, values come from the decrypted inner querystring;
          /// otherwise it just reads Request.QueryString.
          /// </summary>
          private string Q(string key)
          {
               InitSecureQueryFromToken();

               if (!string.IsNullOrEmpty(key) && _secureQs != null)
               {
                    var v = _secureQs[key];
                    if (v != null)
                         return v;
               }

               return Request.QueryString[key];
          }

          public bool IsInputClean(string input)
          {
               if (string.IsNullOrEmpty(input))
                    return true;

               // Common SQL injection patterns
               string[] sqlInjectionPatterns = {
    @"(\b(SELECT|INSERT|UPDATE|DELETE|DROP|UNION|EXEC|ALTER|CREATE|TRUNCATE)\b)",
    @"(\b(OR|AND)\b\s*\d+\s*=\s*\d+)",
    // Allow normal single-quoted strings but still detect suspicious ones (like with SQL keywords or semicolons)
    @"'([^']*(SELECT|INSERT|UPDATE|DELETE|DROP|UNION|EXEC|ALTER|CREATE|TRUNCATE|;|--)[^']*)'",
    @"(--[^\r\n]*)",
    @"(;|\|\||&&)",
    @"(\b(WAITFOR|DELAY)\b)",
    @"(xp_|sp_)"
};

               // Common XSS patterns
               string[] xssPatterns = {
        @"(<script[^>]*>.*?</script>)",
        @"(javascript:)",
        @"(on\w+\s*=)",
        @"(<iframe[^>]*>.*?</iframe>)",
        @"(<object[^>]*>.*?</object>)",
        @"(alert\(|confirm\(|prompt\()",
        @"(<img[^>]*src[^>]*>)",
        @"(expression\(|eval\()"
    };

               // Common OS command injection patterns
               string[] commandInjectionPatterns = {
    // Detect explicit command interpreters (case-insensitive)
    @"(?i)\b(cmd|powershell|pwsh|bash|sh)\b",

    // Detect dangerous operator sequences (but not single harmless symbols inside normal expressions)
    @"(\|\||&&|;;)",

    // Detect typical OS commands (case-insensitive)
    @"(?i)\b(dir|cd|ls|rm|del|copy|move|mkdir|rmdir|cat|type)\b",

    // Detect directory traversal attempts
    @"(\.\./|\.\.\\)"
};

               // Check for SQL injection
               foreach (string pattern in sqlInjectionPatterns)
               {
                    if (Regex.IsMatch(input, pattern, RegexOptions.IgnoreCase))
                         return false;
               }

               // Check for XSS
               foreach (string pattern in xssPatterns)
               {
                    if (Regex.IsMatch(input, pattern, RegexOptions.IgnoreCase))
                         return false;
               }

               // Check for command injection
               foreach (string pattern in commandInjectionPatterns)
               {
                    if (Regex.IsMatch(input, pattern, RegexOptions.IgnoreCase))
                         return false;
               }

               return true;
          }

          /// <summary>
          /// Reads ExcelGridLines flag from REPORT_SP_MAP for this report (RMNNO/RptId).
          /// 0 => hide gridlines, 1 => show gridlines. Defaults to TRUE if missing.
          /// </summary>
          private bool GetExcelGridLinesFlag(string cs, string rptId)
          {
               if (string.IsNullOrWhiteSpace(rptId)) return true; // keep old behavior

               try
               {
                    const string sql = @"
SELECT TOP(1) ISNULL(ExcelGridLines, 1)
FROM ICM.dbo.REPORT_SP_MAP
WHERE RMNNO = @id AND IsActive = 1;";

                    using (var con = new SqlConnection(cs))
                    using (var cmd = new SqlCommand(sql, con))
                    {
                         cmd.Parameters.Add("@id", SqlDbType.VarChar, 50).Value = rptId.Trim();
                         con.Open();

                         var o = cmd.ExecuteScalar();
                         if (o == null || o == DBNull.Value) return true;

                         int v = Convert.ToInt32(o, CultureInfo.InvariantCulture);
                         return (v == 1);
                    }
               }
               catch (Exception ex)
               {
                    TraceLog($"GetExcelGridLinesFlag failed | RptId={rptId}", ex, stage: "EXCEL");
                    return true; // fail-safe: keep previous behavior
               }
          }

          private void RenderHugePdf_NoLock(LocalReport report, string deviceInfoXml, string downloadName = "Report.pdf", bool inline = true)
     {
          if (report == null) throw new ArgumentNullException(nameof(report));

          Server.ScriptTimeout = 3600;

          if (!downloadName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
               downloadName += ".pdf";

          string tmpDir = Server.MapPath("~/App_Data/tmp_reports");
          Directory.CreateDirectory(tmpDir);

          string baseName = "rpt_" + Guid.NewGuid().ToString("N");

          var createdFiles = new List<string>();
          var openStreams = new List<Stream>();

          Warning[] warnings = null;

          try
          {
               // CreateStream called by RDLC
               int streamIndex = 0;

               Stream CreateStream(string name, string extension, Encoding encoding, string mimeType, bool willSeek)
               {
                    streamIndex++;

                    string ext = string.IsNullOrWhiteSpace(extension) ? "pdf" : extension.TrimStart('.');
                    string part = string.IsNullOrWhiteSpace(name) ? "main" : name;

                    string path = Path.Combine(tmpDir, $"{baseName}_{part}_{streamIndex:D3}.{ext}");
                    createdFiles.Add(path);

                    // IMPORTANT: allow others to READ while renderer still has handle
                    var fs = new FileStream(
                        path,
                        FileMode.Create,
                        FileAccess.Write,
                        FileShare.ReadWrite | FileShare.Delete,
                        bufferSize: 256 * 1024,
                        options: FileOptions.SequentialScan
                    );

                    openStreams.Add(fs);
                    return fs;
               }

               report.Refresh();

               // Heavy step: pagination/layout
               report.Render("PDF", deviceInfoXml ?? "", CreateStream, out warnings);
          }
          finally
          {
               // ✅ MUST close all streams to release locks
               foreach (var s in openStreams)
               {
                    try { s.Dispose(); } catch { }
               }

               try { report.DataSources.Clear(); } catch { }
               try { report.ReleaseSandboxAppDomain(); } catch { }
               try { report.Dispose(); } catch { }
          }

          // Pick the real pdf (largest)
          string pdfPath = createdFiles
              .Where(f => f.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
              .OrderByDescending(f => new FileInfo(f).Length)
              .FirstOrDefault();

          if (string.IsNullOrWhiteSpace(pdfPath) || !File.Exists(pdfPath))
               throw new InvalidOperationException("PDF not created by RDLC renderer.");

          // ✅ Send PDF to browser safely (retry open if AV/indexer is holding it)
          Response.Clear();
          Response.ClearHeaders();
          Response.BufferOutput = false;
          Response.TrySkipIisCustomErrors = true;

          Response.ContentType = "application/pdf";
          string disp = inline ? "inline" : "attachment";
          Response.AddHeader("Content-Disposition", $"{disp}; filename=\"{downloadName}\"");
          Response.AddHeader("X-Content-Type-Options", "nosniff");

          const int BUF = 256 * 1024;

          for (int attempt = 1; attempt <= 40; attempt++)
          {
               try
               {
                    using (var fs = new FileStream(
                        pdfPath,
                        FileMode.Open,
                        FileAccess.Read,
                        FileShare.ReadWrite | FileShare.Delete,
                        bufferSize: BUF,
                        options: FileOptions.SequentialScan))
                    {
                         Response.AddHeader("Content-Length", fs.Length.ToString(CultureInfo.InvariantCulture));
                         fs.CopyTo(Response.OutputStream, BUF);
                    }
                    break;
               }
               catch (IOException)
               {
                    if (attempt == 40) throw;
                    Thread.Sleep(125); // wait for lock release (AV/indexer/RDLC)
               }
          }

          Response.Flush();
          HttpContext.Current.ApplicationInstance.CompleteRequest();

          // NOTE: Cleanup old files via scheduled cleanup (don’t delete immediately here).
     }

          private void RenderHugePdf_Safe(LocalReport report, string deviceInfoXml, string downloadName = "Report.pdf", bool inline = true)
          {
               if (report == null) throw new ArgumentNullException(nameof(report));

               Server.ScriptTimeout = 3600;

               if (!downloadName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    downloadName += ".pdf";

               string tmpDir = Server.MapPath("~/App_Data/tmp_reports");
               Directory.CreateDirectory(tmpDir);

               // Optional: cleanup old files (keeps disk safe)
               try
               {
                    foreach (var f in Directory.EnumerateFiles(tmpDir, "rpt_*.*"))
                    {
                         if (File.GetCreationTimeUtc(f) < DateTime.UtcNow.AddHours(-12))
                              File.Delete(f);
                    }
               }
               catch { }

               string baseName = "rpt_" + Guid.NewGuid().ToString("N");

               var createdFiles = new List<string>();
               var openStreams = new List<Stream>();
               Warning[] warnings = null;

               try
               {
                    int streamIndex = 0;

                    Stream CreateStream(string name, string extension, Encoding encoding, string mimeType, bool willSeek)
                    {
                         streamIndex++;

                         string ext = string.IsNullOrWhiteSpace(extension) ? "pdf" : extension.TrimStart('.');
                         string part = string.IsNullOrWhiteSpace(name) ? "main" : Regex.Replace(name, @"[^\w\-]+", "_");

                         string path = Path.Combine(tmpDir, $"{baseName}_{part}_{streamIndex:D3}.{ext}");
                         createdFiles.Add(path);

                         var fs = new FileStream(
                             path,
                             FileMode.Create,
                             FileAccess.Write,
                             FileShare.ReadWrite | FileShare.Delete,
                             bufferSize: 1024 * 1024,
                             options: FileOptions.SequentialScan
                         );

                         openStreams.Add(fs);
                         return fs;
                    }

                    var swRender = Stopwatch.StartNew();
                    TraceLog($"PDF Render START | name={downloadName}", stage: "PDF");

                    report.Render("PDF", deviceInfoXml ?? "", CreateStream, out warnings);

                    swRender.Stop();
                    TraceLog($"PDF Render END | ms={swRender.ElapsedMilliseconds} | warnings={(warnings?.Length ?? 0)}", stage: "PDF");

               }
               finally
               {
                    // ✅ MUST close all streams
                    foreach (var s in openStreams)
                    {
                         try { s.Dispose(); } catch { }
                    }

                    // ✅ Free memory ASAP (important for huge reports)
                    try { report.DataSources.Clear(); } catch { }
                    try { report.ReleaseSandboxAppDomain(); } catch { }
               }

               // Pick the largest pdf
               string pdfPath = createdFiles
                   .Where(f => f.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                   .OrderByDescending(f => new FileInfo(f).Length)
                   .FirstOrDefault();

               if (string.IsNullOrWhiteSpace(pdfPath) || !File.Exists(pdfPath) || new FileInfo(pdfPath).Length == 0)
                    throw new InvalidOperationException("PDF not created by RDLC renderer.");

               Response.Clear();
               Response.ClearHeaders();
               Response.TrySkipIisCustomErrors = true;
               Response.Buffer = false;
               Response.BufferOutput = false;

               Response.ContentType = "application/pdf";
               Response.AddHeader("X-Content-Type-Options", "nosniff");

               string disp = inline ? "inline" : "attachment";
               Response.AddHeader("Content-Disposition", $"{disp}; filename=\"{downloadName}\"");

               // Best for huge file transfer
               Response.TransmitFile(pdfPath);
               Response.Flush();
               HttpContext.Current.ApplicationInstance.CompleteRequest();
          }


          int FixExcelZeroDatesInDateColumn(IXLWorksheet ws, int col, int dataStartRow, int lastRow)
          {
               const double SERIAL_1900_01_01 = 1d; // Excel serial 1 = 01/01/1900
               int fixedCount = 0;

               for (int r = dataStartRow; r <= lastRow; r++)
               {
                    var cell = ws.Cell(r, col);

                    if (cell.IsEmpty(XLCellsUsedOptions.Contents))
                         continue;

                    // If it's a real DateTime but shows 1899
                    if (cell.DataType == XLDataType.DateTime)
                    {
                         DateTime dt;
                         try { dt = cell.GetDateTime(); }
                         catch { continue; }

                         if (dt.Year == 1899 || dt.Date == new DateTime(1899, 12, 30) || dt.Date == new DateTime(1899, 12, 31))
                         {
                              cell.Value = SERIAL_1900_01_01;
                              fixedCount++;
                         }
                         continue;
                    }

                    // Excel stores dates as numbers often
                    if (cell.DataType == XLDataType.Number)
                    {
                         double v;
                         try { v = cell.GetDouble(); }
                         catch { continue; }

                         if (v <= 0d) // serial 0 -> 12/31/1899
                         {
                              cell.Value = SERIAL_1900_01_01;
                              fixedCount++;
                         }
                         continue;
                    }

                    // Text that contains 1899
                    if (cell.DataType == XLDataType.Text)
                    {
                         var s = (cell.GetString() ?? "").Trim();
                         if (s.Contains("1899"))
                         {
                              cell.Value = SERIAL_1900_01_01;
                              fixedCount++;
                         }
                    }
               }

               return fixedCount;
          }




          #endregion
     }

