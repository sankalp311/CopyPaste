document.addEventListener('DOMContentLoaded', function () {

    // ✅ Row click + checkbox sync
    document.querySelectorAll('#mergePanelWrap .merge-hotel-item').forEach(item => {

        const checkbox = item.querySelector('input[type="checkbox"]');

        // 👉 क्लिक on full row
        item.addEventListener('click', function (e) {

            // prevent double toggle if checkbox clicked directly
            if (e.target.type === "checkbox") return;

            checkbox.checked = !checkbox.checked;

            item.classList.toggle('is-checked', checkbox.checked);

            updateSelectedHotels(); // keep your existing UI sync
        });

        // 👉 direct checkbox click
        checkbox.addEventListener('change', function () {
            item.classList.toggle('is-checked', checkbox.checked);
            updateSelectedHotels();
        });

    });

    // ================= EXISTING CODE (UNCHANGED) =================

    document.getElementById('btnGenerate').addEventListener('click', function () {

        const hotels = document.querySelectorAll('#mergePanelWrap .merge-hotel-item');

        let selectedHotels = [];
        let isCrossEvent = false;

        hotels.forEach(item => {

            const checkbox = item.querySelector('input[type="checkbox"]');
            const isSelected = item.classList.contains('is-checked') || (checkbox && checkbox.checked);

            if (isSelected) {

                const name = item.querySelector('.hotel-name').innerText.trim();
                const hotelId = item.dataset.id;

                if (item.classList.contains('is-cross')) {
                    isCrossEvent = true;
                }

                let eventTag = item.querySelector('.event-tag')?.innerText || '';

                selectedHotels.push({
                    hotelId: hotelId,
                    name: name,
                    event: eventTag
                });
            }
        });

        let html = '';

        // ✅ CASE 1: Only ONE hotel selected
        if (selectedHotels.length === 1) {

            const hotel = selectedHotels[0];

            document.getElementById('confirmModalTitle').innerText =
                'Run Report for One Hotel Only?';

            html = `
                <p>We detected other hotel versions with matching RFP IDs, but you have not selected any of them.</p>
                <p>You are about to generate a report for:</p>
                <div class="model-p"><ol>
                    <li><strong class="model-s" data-id="${hotel.hotelId}">${hotel.name} only.</strong></li>
                </ol></div>
                <p>Are you sure you only want to run the report for this one hotel?</p>
            `;

            document.getElementById('confirmCrossNote').style.display = 'none';
        }
        // ✅ CASE 2: Multiple hotels
        else {

            document.getElementById('confirmModalTitle').innerText =
                isCrossEvent ? 'Confirm Cross-Event Merged Report' : 'Confirm Merged Report';

            html = `<p>You have selected <strong class="model-s">${selectedHotels.length} hotels</strong> for a merged rooming list:</p><div class="model-p"><ol>`;

            selectedHotels.forEach(h => {
                html += `<li>
                            <strong class="model-s" data-id="${h.hotelId}">${h.name}</strong>
                            ${h.event ? `<strong class="model-e"> (${h.event})</strong>` : ''}
                        </li>`;
            });

            html += `</ol></div>`;

            document.getElementById('confirmCrossNote').style.display =
                isCrossEvent ? 'block' : 'none';
        }

        document.getElementById('confirmModalBody').innerHTML = html;
        document.getElementById('confirmModal').style.display = 'block';
    });

    // Cancel
    document.getElementById('btnModalCancel').onclick = function () {
        document.getElementById('confirmModal').style.display = 'none';
    };

    // OK
    document.getElementById('btnModalOk').onclick = function () {
        document.getElementById('confirmModal').style.display = 'none';

        // 👉 Continue your report logic
    };

});



