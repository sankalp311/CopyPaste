CREATE PROCEDURE dbo.usp_ICM_ReportRequest_Create  
(  
    @InnerQueryString   NVARCHAR(MAX),  
    @TargetPage         NVARCHAR(200) = NULL,  
    @CreatedByIp        VARCHAR(45)   = NULL,  
    @CreatedByUserAgent NVARCHAR(256) = NULL,  
    @ExpiresInMinutes   INT           = 120  
)  
AS  
BEGIN  
    SET NOCOUNT ON;  
  
    DECLARE @Token   UNIQUEIDENTIFIER = NEWID();  
    DECLARE @UtcNow  DATETIME2(0)     = SYSUTCDATETIME();  
    DECLARE @Expires DATETIME2(0)     = NULL;  
  
    IF @ExpiresInMinutes IS NOT NULL  
        SET @Expires = DATEADD(MINUTE, @ExpiresInMinutes, @UtcNow);  
  
    INSERT INTO dbo.ReportRequest  
    (  
        Token,  
        CreatedOn,  
        ExpiresOn,  
        InnerQueryString,  
        TargetPage,  
        CreatedByIp,  
        CreatedByUserAgent  
    )  
    VALUES  
    (  
        @Token,  
        @UtcNow,  
        @Expires,  
        @InnerQueryString,  
        @TargetPage,  
        @CreatedByIp,  
        @CreatedByUserAgent  
    );  
  
    -- return token in a DataSet (so your DA can read it like other SPs)  
    SELECT Token = CAST(@Token AS VARCHAR(36));  
END  



	
	
