          #region ===== Token / Query Handling =======================================================

          private string ResolveReportToken(string token, string cs)
          {
               if (string.IsNullOrWhiteSpace(token)) return null;

               try
               {
                    using (SqlConnection con = new SqlConnection(cs))
                    using (SqlCommand cmd = new SqlCommand("ICM.dbo.usp_ICM_ReportRequest_Resolve", con))
                    {
                         cmd.CommandType = CommandType.StoredProcedure;
                         cmd.Parameters.Add("@Token", SqlDbType.NVarChar, 50).Value = token.Trim();

                         con.Open();
                         object o = cmd.ExecuteScalar();

                         if (o == null || o == DBNull.Value)
                              return null;

                         string inner = Convert.ToString(o);
                         inner = (inner ?? "").Trim();

                         if (inner.StartsWith("?"))
                              inner = inner.Substring(1);

                         // If SP returns full URL, extract query-string part
                         int qIndex = inner.IndexOf('?');
                         if (qIndex >= 0 && qIndex < inner.Length - 1)
                              inner = inner.Substring(qIndex + 1);

                         return inner;
                    }
               }
               catch (Exception ex)
               {
                    TraceLog("ResolveReportToken error | t=" + token, ex, "TOKEN_ERROR");
                    return null;
               }
          }

          private void InitSecureQueryFromToken()
          {
               if (_secureQsInitialized) return;
               _secureQsInitialized = true;

               string token = (Request.QueryString["t"] ?? Convert.ToString(RouteData.Values["t"]) ?? "").Trim();
               if (string.IsNullOrWhiteSpace(token))
                    return;

               try
               {
                    string cs = ConfigurationManager.ConnectionStrings["ICMReportConnectionString"].ConnectionString;
                    string inner = ResolveReportToken(token, cs);

                    if (string.IsNullOrWhiteSpace(inner))
                    {
                         TraceLog("InitSecureQueryFromToken: token not found or expired.", null, "SECURE");
                         return;
                    }

                    _secureQs = HttpUtility.ParseQueryString(inner);
               }
               catch (Exception ex)
               {
                    TraceLog("InitSecureQueryFromToken failed for token=" + token, ex, "SECURE");
               }
          }

          private string Q(string key)
          {
               InitSecureQueryFromToken();

               if (_secureQs != null && !string.IsNullOrWhiteSpace(key))
               {
                    string v = _secureQs[key];
                    if (v != null) return v;
               }

               return Request.QueryString[key];
          }

