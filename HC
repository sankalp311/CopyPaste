          #region ===== Constants / Fields ==========================================================

          // TODO: update these
          private const string RDLC_VIRTUAL_PATH = "~/Report16/RoomBlockConfirmation.rdlc";
          private const string SP_NAME = "ICM.dbo.sp_ICM_RPT_RoomBlockConfirmation_RDLC";
          private const string RDLC_DATASET_NAME = "DS_TTSbBk112";

          // hardcoded recipient for now as requested
          private const string HARDCODED_TO_EMAIL = "test@example.com";

          // default PDF page settings (change if your report is different)
          private const string DEFAULT_PAGE_WIDTH = "8.5in";
          private const string DEFAULT_PAGE_HEIGHT = "11in";

