INSERT INTO #AcctLine (RSNNO, SortKey, DescTxt, AmtTxt)    
 SELECT    
  a.RSNNO,    
  CAST(    
   CASE    
    WHEN ISNULL(a.CMNNO,0) <> 0 THEN 10000000 + ISNULL(a.ACNNO,0)    
    WHEN ISNULL(a.ABNNO,0) <> 0 THEN 20000000 + ISNULL(a.ABNNO,0)    
    WHEN ISNULL(a.RSNNO,0) <> 0 THEN 30000000 + ISNULL(a.ACNNO,0)    
    WHEN ISNULL(a.ACCTXTYPE,'') <> 'GF' THEN 40000000 + ISNULL(a.ACNNO,0)    
    ELSE 50000000 + ISNULL(a.ACNNO,0)    
   END AS BIGINT    
  ) AS SortKey,    
    
  -- "Credit Card Payment - 9005"    
  --ISNULL(NULLIF(LTRIM(RTRIM(a.ACCDSC)),''),'') +    
  --CASE WHEN a.ACNNO IS NOT NULL THEN N' - ' + CAST(a.ACNNO AS NVARCHAR(20)) ELSE N'' END AS DescTxt,    
    
  ISNULL(NULLIF(LTRIM(RTRIM(a.ACCDSC)),''), N'') AS DescTxt,    
    
  -- Transaction Amount (same as your Crystal formula)    
  LTRIM(STR(    
   CASE    
    WHEN a.ACCTXTYPE LIKE 'G_' THEN ISNULL(a.ACNEXTAMT,0)    
    WHEN a.ACCTXTYPE IN ('CA','CH','CR','WI','XI','XO','AD') THEN ISNULL(a.ACNEXTAMT,0) * (-1)    
    WHEN a.ACCTXTYPE = 'RF' THEN ISNULL(a.ACNEXTAMT,0)    
    ELSE 0    
   END    
  , 18, 2)) AS AmtTxt    
 FROM dbo.ACTMST a    
 JOIN #ResMap m ON m.RGNNO = a.RGNNO    
 WHERE a.RSNNO IS NOT NULL   
    AND (a.ACCDSC NOT LIKE '%Cancelled -%' OR a.ACCDSC IS NULL); 
