  SELECT  distinct      
          E.EMCNO,            
          E.EMCNM,            
          EO.EOCGROUP,            
          EO.EOCACTION,            
          E.EMDTBEG,            
          DynamicInventoryStatus =            
            CASE            
                WHEN LTRIM(RTRIM(CONVERT(NVARCHAR(10), EO.EOCACTION))) <> N'1' THEN N'No Access'            
                ELSE N'Access Allowed'            
            END            
    FROM dbo.EVENTS AS E            
    INNER JOIN dbo.EVENT_OPTIONS AS EO            
        ON E.EMNNO = EO.EMNNO            
    WHERE EO.EOCGROUP  = N'dynamicinventory' -- @EOCGROUP            
      AND EO.EOCACTION = N'0'                -- @EOCACTION            
    ORDER BY EO.EOCACTION DESC;   
