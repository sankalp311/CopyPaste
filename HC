private void BuildFilterForm(string cs, string rptId)
          {
               TraceLog($"ENTER BuildFilterForm | RptId={rptId}", stage: "ENTER");

               // ---- helpers (kept inside) ----
               string H(string s) => System.Web.HttpUtility.HtmlEncode(s ?? "");

               string ToDatetimeLocal(DateTime dt) => dt.ToString("yyyy-MM-dd'T'HH:mm", CultureInfo.InvariantCulture);

               // prefer SourceKey as posted name; else bare param name
               string InputName(string paramName, string sourceKey) =>
                   string.IsNullOrWhiteSpace(sourceKey) ? paramName.TrimStart('@') : sourceKey;

               bool IsParam(string paramName, string wanted) =>
                   paramName.Equals(wanted, StringComparison.OrdinalIgnoreCase) ||
                   paramName.Equals("@" + wanted, StringComparison.OrdinalIgnoreCase);

               // value priority: QueryString (by key or bare) -> Session -> DefaultValue
               string GetPrefill(string paramName, string sourceKey, string defaultValue)
               {
                    string bare = paramName.TrimStart('@');

                    // QS first
                    string qs = null;
                    if (!string.IsNullOrWhiteSpace(sourceKey)) qs = Request.QueryString[sourceKey];
                    if (string.IsNullOrWhiteSpace(qs)) qs = Request.QueryString[bare];
                    if (!string.IsNullOrWhiteSpace(qs)) return qs.Trim();

                    // Session
                    object sess = null;
                    if (!string.IsNullOrWhiteSpace(sourceKey)) sess = Session[sourceKey];
                    if (sess == null) sess = Session[bare];
                    if (sess != null) return Convert.ToString(sess)?.Trim();

                    // Default
                    return defaultValue ?? "";
               }

               IEnumerable<(string Value, string Text)> QueryPairs(string sqlstr, params SqlParameter[] args)
               {
                    using (var con = new SqlConnection(cs))
                    using (var cmd = new SqlCommand(sqlstr, con))
                    {
                         if (args?.Length > 0) cmd.Parameters.AddRange(args);
                         con.Open();
                         using (var r = cmd.ExecuteReader())
                         {
                              while (r.Read())
                                   yield return (Convert.ToString(r.GetValue(0)), Convert.ToString(r.GetValue(1)));
                         }
                    }
               }

               // hide these even if required (still sent server-side)
               var hiddenRequired = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
               { "@SessionID", "@EMCNO" };

               // we need EMNNO for filtering Category/Hotel lists
               string emnnoCtx = (Request.QueryString["EMNNO"] ?? Convert.ToString(Session["LoginEmnno"] ?? "")).Trim();
               if (string.IsNullOrEmpty(emnnoCtx)) emnnoCtx = "0";

               // ---- load parameter rows ----
               var rows = new List<(string ParamName, string DbType, string Source, string SourceKey, string DefaultValue, bool IsRequired, int Ordinal, string Label)>();
               const string sql = @"
        SELECT ParamName, DbType, Source, SourceKey, DefaultValue, IsRequired, Ordinal,Label
        FROM ICM.dbo.REPORT_PARAMETERS
        WHERE RMNNO=@id
        ORDER BY Ordinal";
               using (var con = new SqlConnection(cs))
               using (var cmd = new SqlCommand(sql, con))
               {
                    cmd.Parameters.Add("@id", SqlDbType.VarChar, 50).Value = rptId;
                    con.Open();
                    using (var r = cmd.ExecuteReader())
                    {
                         while (r.Read())
                         {
                              rows.Add((
                                  r.GetString(0),
                                  r.GetString(1),
                                  r.GetString(2),
                                  r.IsDBNull(3) ? null : r.GetString(3),
                                  r.IsDBNull(4) ? null : r.GetString(4),
                                  !r.IsDBNull(5) && r.GetBoolean(5),
                                  r.IsDBNull(6) ? 0 : r.GetInt32(6),
                                  r.IsDBNull(7) ? null : r.GetString(7)
                              ));
                         }
                    }
               }

               // ---- build HTML ----
               pnlFilters.Visible = true;
               var sb = new System.Text.StringBuilder();

               foreach (var p in rows.Where(x => x.IsRequired))
               {
                    if (hiddenRequired.Contains(p.ParamName)) continue;

                    string htmlName = InputName(p.ParamName, p.SourceKey);
                    //string label = p.ParamName.TrimStart('@');
                    string label = !string.IsNullOrWhiteSpace(p.Label) ? p.Label
                                        : !string.IsNullOrWhiteSpace(p.SourceKey)
                                            ? p.SourceKey
                                            : p.ParamName.TrimStart('@');

                    string prefill = GetPrefill(p.ParamName, p.SourceKey, p.DefaultValue);
                    string dbt = (p.DbType ?? "").ToLowerInvariant();

                    // Auto-default for From/To when nothing provided: today range
                    if (IsParam(p.ParamName, "From") && string.IsNullOrWhiteSpace(prefill))
                    {
                         var start = DateTime.Now.Date; // 00:00 local today
                         prefill = ToDatetimeLocal(start);
                    }
                    if (IsParam(p.ParamName, "RGDTADD_FROM") && string.IsNullOrWhiteSpace(prefill))
                    {
                         var start = DateTime.Now.Date; // 00:00 local today
                         prefill = ToDatetimeLocal(start);
                    }
                    if (IsParam(p.ParamName, "To") && string.IsNullOrWhiteSpace(prefill))
                    {
                         var now = DateTime.Now;        // now (change to Date.AddDays(1).AddSeconds(-1) for EOD)
                         prefill = ToDatetimeLocal(now);
                    }
                    if (IsParam(p.ParamName, "RGDTADD_TO") && string.IsNullOrWhiteSpace(prefill))
                    {
                         var start = DateTime.Now.Date; // 00:00 local today
                         prefill = ToDatetimeLocal(start);
                    }

                    // Known dropdowns (Category / Hotel)
                    if (IsParam(p.ParamName, "CMNNO"))
                    {
                         sb.Append("<div class='form-group'>");
                         sb.AppendFormat("<label class='col-sm-3 control-label'>{0}:</label><div class='col-sm-6'>", H("Category"));
                         sb.AppendFormat("<select class='form-control' name='{0}' id='{0}'>", H(htmlName));
                         sb.Append("<option value='0'>-- Select All --</option>");
                         foreach (var row in QueryPairs(
                             "SELECT CMNNO, CMCDSC FROM ICM.dbo.CATEGORY WHERE EMNNO=@emnno ORDER BY CMCDSC",
                             new SqlParameter("@emnno", emnnoCtx)))
                         {
                              bool sel = !string.IsNullOrEmpty(prefill) && prefill == row.Value;
                              sb.AppendFormat("<option value='{0}' {2}>{1}</option>",
                                  H(row.Value), H(row.Text), sel ? "selected" : "");
                         }
                         sb.Append("</select></div></div>");
                         continue;
                    }
                    if (IsParam(p.ParamName, "HTNNO"))
                    {
                         sb.Append("<div class='form-group'>");
                         sb.AppendFormat("<label class='col-sm-3 control-label'>{0}:</label><div class='col-sm-6'>", H("Hotel"));
                         sb.AppendFormat("<select class='form-control' name='{0}' id='{0}'>", H(htmlName));
                         sb.Append("<option value='0'>-- Select Hotel --</option>");
                         foreach (var row in QueryPairs(
                             "SELECT HTNNO, HTCDSC FROM ICM.dbo.Hotel WHERE EMNNO=@emnno ORDER BY HTCDSC",
                             new SqlParameter("@emnno", emnnoCtx)))
                         {
                              bool sel = !string.IsNullOrEmpty(prefill) && prefill == row.Value;
                              sb.AppendFormat("<option value='{0}' {2}>{1}</option>",
                                  H(row.Value), H(row.Text), sel ? "selected" : "");
                         }
                         sb.Append("</select></div></div>");
                         continue;
                    }

                    // Generic widgets
                    if (dbt.StartsWith("datetime"))
                    {
                         sb.Append("<div class='form-group'>");
                         sb.AppendFormat("<label class='col-sm-3 control-label'>{0}:</label><div class='col-sm-6'>", H(label));
                         sb.AppendFormat("<input type='datetime-local' class='form-control' name='{0}' id='{0}' value='{1}' />",
                             H(htmlName), H(prefill));
                         sb.Append("</div></div>");
                    }
                    else if (dbt.StartsWith("int"))
                    {
                         sb.Append("<div class='form-group'>");
                         sb.AppendFormat("<label class='col-sm-3 control-label'>{0}:</label><div class='col-sm-6'>", H(label));
                         sb.AppendFormat("<input type='number' class='form-control' name='{0}' id='{0}' value='{1}' />",
                             H(htmlName), H(prefill));
                         sb.Append("</div></div>");
                    }
                    else if (dbt.StartsWith("bit"))
                    {
                         bool isChecked = prefill == "1" || prefill.Equals("true", StringComparison.OrdinalIgnoreCase);
                         sb.Append("<div class='form-group'>");
                         sb.AppendFormat("<label class='col-sm-3 control-label'>{0}:</label><div class='col-sm-6'>", H(label));
                         sb.AppendFormat("<input type='checkbox' name='{0}' id='{0}' {1} />",
                             H(htmlName), isChecked ? "checked" : "");
                         sb.Append("</div></div>");
                    }
                    else
                    {
                         sb.Append("<div class='form-group'>");
                         sb.AppendFormat("<label class='col-sm-3 control-label'>{0}:</label><div class='col-sm-6'>", H(label));
                         sb.AppendFormat("<input type='text' class='form-control' name='{0}' id='{0}' value='{1}' />",
                             H(htmlName), H(prefill));
                         sb.Append("</div></div>");
                    }
               }

               ltrParams.Text = sb.ToString();

               TraceLog("EXIT BuildFilterForm", stage: "EXIT");
          }
