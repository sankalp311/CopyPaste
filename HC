          private byte[] BuildPdfBytes(DataSet spResult, int emnno, int hbnno)
          {
               if (spResult == null)
                    throw new InvalidOperationException("No dataset returned.");

               if (spResult.Tables.Count == 0)
                    throw new InvalidOperationException("Stored procedure returned no result sets.");

               if (!HasAnyRows(spResult))
                    throw new InvalidOperationException("No rows returned for report.");

               string rdlcPath = Server.MapPath(NormalizeRdlcPath(RDLC_VIRTUAL_PATH));
               if (!File.Exists(rdlcPath))
                    throw new FileNotFoundException("RDLC not found: " + rdlcPath);

               BindRoomBlockReport(rdlcPath, spResult, emnno, hbnno);

               string mimeType;
               string encoding;
               string extension;
               string[] streams;
               Warning[] warnings;

               string deviceInfo = $@"<DeviceInfo>
  <OutputFormat>PDF</OutputFormat>
  <PageWidth>{DEFAULT_PAGE_WIDTH}</PageWidth>
  <MarginTop>0.50in</MarginTop>
  <MarginLeft>0.35in</MarginLeft>
  <MarginRight>0.35in</MarginRight>
  <MarginBottom>.35in</MarginBottom>
</DeviceInfo>";

               byte[] bytes = rv.LocalReport.Render(
                   "PDF",
                   deviceInfo,
                   out mimeType,
                   out encoding,
                   out extension,
                   out streams,
                   out warnings
               );

               return bytes;
          }

          private void BindRoomBlockReport(string rdlcPhysicalPath, DataSet ds, int emnno, int hbnno)
          {
               if (ds == null)
                    throw new InvalidOperationException("DataSet is null.");

               string xml = File.ReadAllText(rdlcPhysicalPath);

               rv.Reset();
               rv.ProcessingMode = ProcessingMode.Local;

               using (StringReader sr = new StringReader(xml))
               {
                    rv.LocalReport.LoadReportDefinition(sr);
               }

               rv.LocalReport.EnableHyperlinks = true;
               rv.LocalReport.DataSources.Clear();

               rv.LocalReport.DataSources.Add(new ReportDataSource(RDLC_DATASET_NAME_1, GetTableOrEmpty(ds, 0)));
               rv.LocalReport.DataSources.Add(new ReportDataSource(RDLC_DATASET_NAME_2, GetTableOrEmpty(ds, 1)));
               rv.LocalReport.DataSources.Add(new ReportDataSource(RDLC_DATASET_NAME_3, GetTableOrEmpty(ds, 2)));

               SetReportParametersFromData(ds, emnno, hbnno);

               rv.LocalReport.Refresh();
          }

          private void SetReportParametersFromData(DataSet ds, int emnno, int hbnno)
          {
               var reportParams = rv.LocalReport.GetParameters();
               if (reportParams == null || reportParams.Count == 0)
                    return;

               List<DataTable> orderedTables = ds.Tables
                   .Cast<DataTable>()
                   .Where(t => t != null)
                   .OrderBy(t => t.Rows.Count == 1 ? 0 : 1)
                   .ThenBy(t => t.Rows.Count == 0 ? 1 : 0)
                   .ToList();

               List<ReportParameter> toSet = new List<ReportParameter>();

               foreach (ReportParameterInfo pInfo in reportParams)
               {
                    string value = null;
                    string paramName = (pInfo.Name ?? "").Trim();

                    if (paramName.Equals("EMNNO", StringComparison.OrdinalIgnoreCase))
                    {
                         value = emnno.ToString(CultureInfo.InvariantCulture);
                    }
                    else if (
                        paramName.Equals("HBNNO", StringComparison.OrdinalIgnoreCase) ||
                        paramName.Equals("BlockNo", StringComparison.OrdinalIgnoreCase)
                    )
                    {
                         value = hbnno.ToString(CultureInfo.InvariantCulture);
                    }

                    if (string.IsNullOrWhiteSpace(value))
                    {
                         object raw = FindParameterValueFromTables(orderedTables, paramName);
                         value = FormatForParam(raw, pInfo.DataType);
                    }

                    if (string.IsNullOrWhiteSpace(value))
                    {
                         string qv = Q(paramName);
                         if (!string.IsNullOrWhiteSpace(qv))
                              value = qv.Trim();
                    }

                    if (string.IsNullOrWhiteSpace(value))
                    {
                         switch (pInfo.DataType)
                         {
                              case ParameterDataType.Integer:
                                   value = "0";
                                   break;
                              case ParameterDataType.Float:
                                   value = "0";
                                   break;
                              case ParameterDataType.Boolean:
                                   value = "False";
                                   break;
                              case ParameterDataType.DateTime:
                                   value = DateTime.Now.ToString("s", CultureInfo.InvariantCulture);
                                   break;
                              default:
                                   value = "";
                                   break;
                         }
                    }

                    toSet.Add(new ReportParameter(paramName, value));
               }

               rv.LocalReport.SetParameters(toSet);
          }

          private object FindParameterValueFromTables(IEnumerable<DataTable> tables, string paramName)
          {
               if (tables == null || string.IsNullOrWhiteSpace(paramName))
                    return null;

               string bareName = paramName.Trim().TrimStart('@');
               string withAt = "@" + bareName;

               foreach (DataTable t in tables)
               {
                    if (t == null || t.Rows.Count == 0 || t.Columns.Count == 0)
                         continue;

                    if (t.Columns.Contains(paramName))
                         return t.Rows[0][paramName];

                    if (t.Columns.Contains(bareName))
                         return t.Rows[0][bareName];

                    if (t.Columns.Contains(withAt))
                         return t.Rows[0][withAt];

                    foreach (DataColumn c in t.Columns)
                    {
                         string col = (c.ColumnName ?? "").Trim();

                         if (col.Equals(paramName, StringComparison.OrdinalIgnoreCase) ||
                             col.Equals(bareName, StringComparison.OrdinalIgnoreCase) ||
                             col.Equals(withAt, StringComparison.OrdinalIgnoreCase))
                         {
                              return t.Rows[0][c.ColumnName];
                         }
                    }
               }

               return null;
          }

          private static string FormatForParam(object raw, ParameterDataType type)
          {
               if (raw == null || raw == DBNull.Value) return null;

               switch (type)
               {
                    case ParameterDataType.Integer:
                         {
                              int i;
                              if (int.TryParse(Convert.ToString(raw, CultureInfo.InvariantCulture), out i))
                                   return i.ToString(CultureInfo.InvariantCulture);
                              return null;
                         }

                    case ParameterDataType.Float:
                         {
                              double d;
                              if (double.TryParse(Convert.ToString(raw, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out d))
                                   return d.ToString(CultureInfo.InvariantCulture);
                              return null;
                         }

                    case ParameterDataType.DateTime:
                         {
                              DateTime dt;
                              if (raw is DateTime)
                                   return ((DateTime)raw).ToString("s", CultureInfo.InvariantCulture);

                              if (DateTime.TryParse(Convert.ToString(raw, CultureInfo.InvariantCulture),
                                  CultureInfo.InvariantCulture,
                                  DateTimeStyles.AssumeLocal,
                                  out dt))
                              {
                                   return dt.ToString("s", CultureInfo.InvariantCulture);
                              }

                              return null;
                         }

                    case ParameterDataType.Boolean:
                         {
                              string s = Convert.ToString(raw, CultureInfo.InvariantCulture);
                              if (string.Equals(s, "1") || string.Equals(s, "true", StringComparison.OrdinalIgnoreCase))
                                   return "True";
                              if (string.Equals(s, "0") || string.Equals(s, "false", StringComparison.OrdinalIgnoreCase))
                                   return "False";
                              return null;
                         }

                    default:
                         return Convert.ToString(raw, CultureInfo.InvariantCulture);
               }
          }

