          /// <summary>
          /// Builds SqlCommand parameters from REPORT_PARAMETERS mapping.
          /// </summary>
          private void BuildParametersFromMap(string cs, string rptId, SqlCommand cmd)
          {
               const string sql = @"
SELECT ParamName, DbType, Source, SourceKey, DefaultValue, IsRequired
FROM ICM.dbo.REPORT_PARAMETERS
WHERE RMNNO=@id
ORDER BY Ordinal";
               using (var con = new SqlConnection(cs))
               using (var m = new SqlCommand(sql, con))
               {
                    var _secureQs1 = _secureQs;
                    var _secureToken1 = _secureToken;
                    m.Parameters.Add("@id", SqlDbType.VarChar, 50).Value = rptId;
                    con.Open();
                    using (var r = m.ExecuteReader())
                    {
                         while (r.Read())
                         {
                              string pName = r.GetString(0);
                              string dbType = r.GetString(1);
                              string source = r.GetString(2);
                              string key = r.IsDBNull(3) ? null : r.GetString(3);
                              string defVal = r.IsDBNull(4) ? null : r.GetString(4);
                              bool required = !r.IsDBNull(5) && r.GetBoolean(5);
                              string qsValue = Convert.ToString(Request.QueryString[key]);
                              string sessionValue = Convert.ToString(Session["LoginEmnno"]);
                              object rawValue = null;
                              if (source.Equals("QueryString", StringComparison.OrdinalIgnoreCase) &&
                              pName.Equals("@Token", StringComparison.OrdinalIgnoreCase))
                              {
                                   rawValue = _secureToken1;
                              }
                              else if (source.Equals("Form", StringComparison.OrdinalIgnoreCase))
                                   rawValue = Request.Form[string.IsNullOrWhiteSpace(key) ? pName.TrimStart('@') : key];
                              else if (source.Equals("QueryString", StringComparison.OrdinalIgnoreCase))
                                   // rawValue = string.IsNullOrWhiteSpace(key) ? null : Convert.ToString(Session["LoginEmnno"] ?? "");
                                   rawValue =
                                       !string.IsNullOrWhiteSpace(qsValue) ? qsValue :
                                       !string.IsNullOrWhiteSpace(sessionValue) ? sessionValue :
                                       null;
                              else if (source.Equals("Session", StringComparison.OrdinalIgnoreCase))
                                   rawValue = string.IsNullOrWhiteSpace(key) ? null : Session[key];
                              else if (source.Equals("Constant", StringComparison.OrdinalIgnoreCase))
                                   rawValue = defVal;

                              if (rawValue == null || (rawValue is string s && string.IsNullOrWhiteSpace(s))) rawValue = defVal;

                              cmd.Parameters.Add(CreateSqlParameterFromDbType(pName, dbType, rawValue, required));
                         }
                    }
               }

               // --- ensure @EMCNO only if the SP actually has it ---
               try
               {
                    // 1) Find EMNNO
                    string emnForLookup = null;
                    if (cmd.Parameters.Contains("@EMNNO") && cmd.Parameters["@EMNNO"].Value != DBNull.Value)
                         emnForLookup = Convert.ToString(cmd.Parameters["@EMNNO"].Value)?.Trim();

                    if (string.IsNullOrWhiteSpace(emnForLookup))
                         emnForLookup = (Request.QueryString["EMNNO"] ?? Convert.ToString(Session["LoginEmnno"] ?? "")).Trim();

                    // 2) If SP declares @EMCNO, populate it from EVENTS
                    if (cmd.Parameters.Contains("@EMCNO") && !string.IsNullOrWhiteSpace(emnForLookup))
                    {
                         string emcFromDb = GetEmcnoByEmnno(
                             ConfigurationManager.ConnectionStrings["ICMReportConnectionString"].ConnectionString,
                             emnForLookup);

                         if (!string.IsNullOrWhiteSpace(emcFromDb))
                         {
                              var val = cmd.Parameters["@EMCNO"].Value;
                              if (val == null || val == DBNull.Value || string.IsNullOrWhiteSpace(Convert.ToString(val)))
                                   cmd.Parameters["@EMCNO"].Value = emcFromDb;
                         }
                    }
               }
               catch { /* no-op */ }

          }

          /// <summary>
          /// Creates a typed SqlParameter based on a token DbType string from the mapping table.
          /// </summary>
          private SqlParameter CreateSqlParameterFromDbType(string name, string dbType, object raw, bool required)
          {
               dbType = (dbType ?? "").Trim().ToLowerInvariant();
               string sval = raw == null ? null : Convert.ToString(raw, CultureInfo.InvariantCulture).Trim();

               object valueOrNull(object v) => (v == null) ? (object)DBNull.Value : v;

               // Helpers to parse "(size)" or "(p,s)"
               int parseIntBetween(string openClose, int def = 0)
               {
                    try
                    {
                         int i1 = dbType.IndexOf('(');
                         int i2 = dbType.IndexOf(')');
                         if (i1 < 0 || i2 < 0 || i2 <= i1 + 1) return def;
                         string inner = dbType.Substring(i1 + 1, i2 - i1 - 1);
                         return int.Parse(inner, CultureInfo.InvariantCulture);
                    }
                    catch { return def; }
               }

               (byte p, byte s) parsePrecScale()
               {
                    try
                    {
                         int i1 = dbType.IndexOf('(');
                         int i2 = dbType.IndexOf(')');
                         string inner = dbType.Substring(i1 + 1, i2 - i1 - 1);
                         var parts = inner.Split(',');
                         byte prec = byte.Parse(parts[0], CultureInfo.InvariantCulture);
                         byte scal = (parts.Length > 1) ? byte.Parse(parts[1], CultureInfo.InvariantCulture) : (byte)0;
                         return (prec, scal);
                    }
                    catch { return (18, 2); }
               }

               SqlParameter p;

               if (dbType.StartsWith("int"))
               {
                    p = new SqlParameter(name, SqlDbType.Int)
                    {
                         Value = string.IsNullOrWhiteSpace(sval)
                                    ? (required ? throw new ArgumentException($"{name} is required") : (object)DBNull.Value)
                                        : int.Parse(sval, CultureInfo.InvariantCulture)
                    };
               }
               else if (dbType.StartsWith("bit"))
               {
                    bool? b = null;
                    if (!string.IsNullOrWhiteSpace(sval))
                    {
                         if (sval == "1" || sval.Equals("true", StringComparison.OrdinalIgnoreCase)) b = true;
                         else if (sval == "0" || sval.Equals("false", StringComparison.OrdinalIgnoreCase)) b = false;
                    }
                    p = new SqlParameter(name, SqlDbType.Bit) { Value = b.HasValue ? (object)b.Value : (required ? (object)1 /* or throw */ : DBNull.Value) };
               }
               else if (dbType.StartsWith("datetime"))
               {
                    DateTime? dt = null;
                    if (!string.IsNullOrWhiteSpace(sval))
                    {
                         if (DateTime.TryParse(sval, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var parsed))
                              dt = parsed;
                    }
                    p = new SqlParameter(name, SqlDbType.DateTime) { Value = dt.HasValue ? (object)dt.Value : (required ? (object)DateTime.Now : DBNull.Value) };
               }
               else if (dbType.StartsWith("decimal"))
               {
                    var (prec, scale) = parsePrecScale();
                    p = new SqlParameter(name, SqlDbType.Decimal) { Precision = prec, Scale = scale };
                    if (string.IsNullOrWhiteSpace(sval))
                         p.Value = required ? 0m : (object)DBNull.Value;
                    else
                         p.Value = Convert.ToDecimal(sval, CultureInfo.InvariantCulture);
               }
               else if (dbType.StartsWith("nvarchar"))
               {
                    int size = parseIntBetween("()", 4000);
                    p = new SqlParameter(name, SqlDbType.NVarChar, size) { Value = valueOrNull(sval) };
               }
               else if (dbType.StartsWith("varchar"))
               {
                    int size = parseIntBetween("()", 8000);
                    p = new SqlParameter(name, SqlDbType.VarChar, size) { Value = valueOrNull(sval) };
               }
               else
               {
                    // default to NVARCHAR(MAX)
                    p = new SqlParameter(name, SqlDbType.NVarChar, -1) { Value = valueOrNull(sval) };
               }

               return p;
          }

