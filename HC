SELECT
    X.RSNNO,
    CAST(
        'Change Requests:<br/>' +
        STUFF((
            SELECT
                -- FieldName + padding so "Was:" starts at same column everywhere
                '<b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;' + REPLACE(REPLACE(REPLACE(ISNULL(HRC2.HCC_FIELDNAME,''),'&','&amp;'),'<','&lt;'),'>','&gt;') + '</b>' +
                REPLICATE('&nbsp;', CASE
                    WHEN G.MaxFieldLen > LEN(ISNULL(HRC2.HCC_FIELDNAME,'')) 
                        THEN (G.MaxFieldLen - LEN(ISNULL(HRC2.HCC_FIELDNAME,'')) + 4)   -- +4 = gap before "Was:"
                    ELSE 4
                END) +
                '<b>Was:</b>&nbsp;' +
                REPLACE(REPLACE(REPLACE(ISNULL(CAST(HRC2.HCC_OLD_VALUE AS NVARCHAR(MAX)),''),'&','&amp;'),'<','&lt;'),'>','&gt;') +
                '<br/>' +

                -- indent "Now:" to start exactly under "Was:"
                REPLICATE('&nbsp;&nbsp;&nbsp;&nbsp;', G.MaxFieldLen + 2) +
                '<b>Now:</b>&nbsp;' +
                REPLACE(REPLACE(REPLACE(ISNULL(CAST(HRC2.HCC_NEW_VALUE AS NVARCHAR(MAX)),''),'&','&amp;'),'<','&lt;'),'>','&gt;') +
                '<br/><br/>'
            FROM [ICM_Report_Exports_Core_22Dec].[dbo].HOTEL_RES_CHANGES HRC2
            INNER JOIN [ICM_Report_Exports_Core_22Dec].[dbo].HOTEL_EXPORT_REPORTS HER2
                ON HER2.RSNNO = HRC2.RSNNO
            WHERE
                HER2.EXDT_RUNTIME = @RunTime
                AND HER2.EXC_REPORT_TYPE = 'C'
                AND LEN(CAST(HRC2.HCC_OLD_VALUE AS VARCHAR(100))) < 20
                AND HRC2.RSNNO = X.RSNNO
            ORDER BY HRC2.HCC_FIELDNAME
            FOR XML PATH(''), TYPE
        ).value('.', 'NVARCHAR(MAX)'), 1, 0, '')
    AS NVARCHAR(MAX)) AS RHCFIELDNAME,
	'' AS RHCOLDVALUE,
	'' AS RHCNEWVALUE
FROM
(
    SELECT DISTINCT HRC.RSNNO
    FROM [ICM_Report_Exports_Core_22Dec].[dbo].HOTEL_RES_CHANGES HRC
    INNER JOIN [ICM_Report_Exports_Core_22Dec].[dbo].HOTEL_EXPORT_REPORTS HER
        ON HER.RSNNO = HRC.RSNNO
    WHERE
        HER.EXDT_RUNTIME = @RunTime
        AND HER.EXC_REPORT_TYPE = 'C'
        AND LEN(CAST(HRC.HCC_OLD_VALUE AS VARCHAR(100))) < 20
) X
CROSS JOIN
(
    -- Global max field length for uniform alignment across ALL RSNNO
    SELECT MAX(LEN(ISNULL(HRC.HCC_FIELDNAME,''))) AS MaxFieldLen
    FROM [ICM_Report_Exports_Core_22Dec].[dbo].HOTEL_RES_CHANGES HRC
    INNER JOIN [ICM_Report_Exports_Core_22Dec].[dbo].HOTEL_EXPORT_REPORTS HER
        ON HER.RSNNO = HRC.RSNNO
    WHERE
        HER.EXDT_RUNTIME = @RunTime
        AND HER.EXC_REPORT_TYPE = 'C'
        AND LEN(CAST(HRC.HCC_OLD_VALUE AS VARCHAR(100))) < 20
) G
ORDER BY X.RSNNO DESC;

