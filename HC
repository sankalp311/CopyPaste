[NoAccessCaseFilter("WACO")]
public async Task<IActionResult> Aco()
{
	int EMNNO = Convert.ToInt32(HttpContext.Request.Query["EMNNO"].ToString());
	int RGNNOID = Convert.ToInt32(HttpContext.Request.Query["RGNNO"].ToString());

	registration_data obj = new registration_data
	{
		RGNNO = RGNNOID,
		EMNNO = EMNNO
	};

	var hotelList = await _eRepo.GetHotelList(obj);
	var AcoDetails = await _eRepo.GetAcoDetails(obj);
	var CCtype = await _eRepo.GetCCType(obj);

	ViewBag.objHotelList = hotelList;
	ViewBag.cctype = CCtype;
	ViewBag.RGNNO = RGNNOID;

	// TESTING ACCESS
	// default = 0
	// use ?testAccess=1 in url to test access level 1
	int userAccessLevel = 0;
	string testAccess = HttpContext.Request.Query["testAccess"].ToString();
	if (!string.IsNullOrWhiteSpace(testAccess) && int.TryParse(testAccess, out int parsedAccess))
	{
		userAccessLevel = parsedAccess == 1 ? 1 : 0;
	}
	ViewBag.UserAccessLevel = userAccessLevel;

	acoViewModel.objAcoList = (AcoDetails != null && AcoDetails.Count > 0)
	    ? AcoDetails[0]
	    : new registration_data();

	return View(acoViewModel);
}


