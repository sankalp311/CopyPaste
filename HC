 SELECT "ACTMST"."ACNEXTAMT", "REGMST"."RGCPLNM", "REGMST"."RGCPFNM", "REGMST"."RGNNO", "ACTMST"."ACCTXTYPE", "REGMST"."RGCPORG", "REGMST"."RGCPPFX", "REGMST"."RGCPSFX", "EVENTS"."EMNNO", "ACTMST"."ACNNO", "RESERVATIONS"."RSNNO", "HOTEL"."HTCDSC", "RESNIGHTS"."RNMPERNIGHTCHARGE", "ROOMTYPES"."RTCDESC", "HOTEL"."HTCAD1", "HOTEL"."HTCCITY", "HOTEL"."HTCST", "HOTEL"."HTCZIP", "RESERVATIONS"."RSCREQUESTSTRING", "ACTMST"."ACNDSBAMT", "RESERVATIONS"."RSCCCTYPE", "HOTEL"."HTNTAXINC", "REGMST"."RGCNO", "RESERVATIONS"."RSCPERSONCOMMENTS", "RESERVATIONS"."RSDTDEP", "RESERVATIONS"."RSDTARR", "RESERVATIONS"."RSDTXLD", "ROOMCATEGORIES"."RCCDESC", "RESERVATIONS"."HTNNO", "RESERVATIONS"."RSCCCEXP", "REGUSER"."RUNNO", "EVENTS"."EMCNM", "REGMST"."RGCEMAIL", "HOTEL"."HTNMIN_NIGHTS", "HOTEL"."HTNUSE_HOTEL_DEFAULTS", "RESERVATIONS"."RSCHOTELCOMMENTS", "RESERVATIONS"."RSNMASTERACCOUNT", "HOTEL"."HTCCNTRY", "RESERVATIONS"."RSCCCNO_MSK", "REGMST"."RGCPTEL", "REGMST"."RGCPAD1", "REGMST"."RGCPAD2", "REGMST"."RGCPCITY", "REGMST"."RGCPST", "REGMST"."RGCPZIP", "REGMST"."RGCPREGN", "REGMST"."RGCPCTRY", "HOTEL"."HTCACCTYPE", "HOTELROOMTYPECOSTS"."HCNCOST", "HOTELROOMTYPECOSTS"."HINNO", "RESNIGHTS"."HINNO", "EVENTS"."EMCREGHDR", "EVENTS"."EMCREGFTR", "EVENTS"."EMCHTLFTR", "EVENTS"."EMCHTLHDR", "CATEGORY"."CMCCNFHDR", "CATEGORY"."CMCCNFFTR", "REGMST"."RGCCNFTXT", "HOTEL"."HTCTAXCMT", "HOTEL"."HTCXLD", "HOTEL"."HTCFEATURES", "HOTEL"."HTCHDR", "HOTEL"."HTCFTR"
 FROM   ((((((((("ICM"."dbo"."EVENTS" "EVENTS" INNER JOIN "ICM"."dbo"."REGMST" "REGMST" ON "EVENTS"."EMNNO"="REGMST"."EMNNO") INNER JOIN "ICM"."dbo"."ACTMST" "ACTMST" ON "REGMST"."RGNNO"="ACTMST"."RGNNO") LEFT OUTER JOIN "ICM"."dbo"."REGUSER" "REGUSER" ON "REGMST"."RGNNO"="REGUSER"."RGNNO") INNER JOIN "ICM"."dbo"."CATEGORY" "CATEGORY" ON "REGMST"."CMNNO"="CATEGORY"."CMNNO") LEFT OUTER JOIN "ICM"."dbo"."RESERVATIONS" "RESERVATIONS" ON "ACTMST"."RSNNO"="RESERVATIONS"."RSNNO") LEFT OUTER JOIN "ICM"."dbo"."HOTEL" "HOTEL" ON "RESERVATIONS"."HTNNO"="HOTEL"."HTNNO") LEFT OUTER JOIN "ICM"."dbo"."RESNIGHTS" "RESNIGHTS" ON "RESERVATIONS"."RSNNO"="RESNIGHTS"."RSNNO") LEFT OUTER JOIN "ICM"."dbo"."ROOMTYPES" "ROOMTYPES" ON "RESERVATIONS"."RTNNO"="ROOMTYPES"."RTNNO") LEFT OUTER JOIN "ICM"."dbo"."ROOMCATEGORIES" "ROOMCATEGORIES" ON "RESERVATIONS"."RCNNO"="ROOMCATEGORIES"."RCNNO") LEFT OUTER JOIN "ICM"."dbo"."HOTELROOMTYPECOSTS" "HOTELROOMTYPECOSTS" ON "RESNIGHTS"."HINNO"="HOTELROOMTYPECOSTS"."HINNO"
 WHERE  "EVENTS"."EMNNO"=15590
 ORDER BY "EVENTS"."EMNNO"

 --  Crystal Subreport Deposit Grid
 SELECT "RESERVATIONS"."RSNNO", "HOTELINVENTORY"."HINNO", "HOTELINVENTORY"."HIDATE", "HOTELROOMTYPECOSTS"."HCNCOST", "HOTELROOMTYPECOSTS"."HCNDEPOSIT"
 FROM   ("ICM"."dbo"."RESNIGHTS" "RESNIGHTS" INNER JOIN "ICM"."dbo"."RESERVATIONS" "RESERVATIONS" ON "RESNIGHTS"."RSNNO"="RESERVATIONS"."RSNNO") INNER JOIN ("ICM"."dbo"."HOTELROOMTYPECOSTS" "HOTELROOMTYPECOSTS" INNER JOIN "ICM"."dbo"."HOTELINVENTORY" "HOTELINVENTORY" ON "HOTELROOMTYPECOSTS"."HINNO"="HOTELINVENTORY"."HINNO") ON "RESNIGHTS"."HINNO"="HOTELINVENTORY"."HINNO"
 WHERE  "RESERVATIONS"."RSNNO"=2706649
 ORDER BY "RESERVATIONS"."RSNNO", "HOTELINVENTORY"."HINNO"



