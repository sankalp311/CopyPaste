RDLC SP

CREATE   PROCEDURE dbo.sp_ICM_RPT_BlkInventory_ByEvent_RDLC    
(    
    @EMNNO INT,    
    @ExcludeSpecial BIT = 1   -- keep default ON to match Crystal "exclude" note    
 -- EXEC sp_ICM_RPT_BlkInventory_ByEvent_RDLC 19590    
)    
AS    
BEGIN    
    SET NOCOUNT ON;    
    SET XACT_ABORT ON;    
    SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;    
    
    ----------------------------------------------------------------------    
    -- 1) Block headers (small rowset) - 1 row per HBNNO    
    ----------------------------------------------------------------------    
    CREATE TABLE #Blocks    
    (    
        HBNNO        INT           NOT NULL PRIMARY KEY,    
        EMCNM        VARCHAR(200)  NULL,    
        EMDTBEG      DATETIME      NULL,    
        EMDTEND      DATETIME      NULL,    
        HBDTAPPROVED DATETIME      NULL,    
        HBCORG       VARCHAR(200)  NULL,    
        HBCFNM       VARCHAR(200)  NULL,    
        HBCLNM       VARCHAR(200)  NULL,    
        HBCEMAIL     VARCHAR(300)  NULL,    
        HTCDSC       VARCHAR(300)  NULL    
    );    
    
    INSERT INTO #Blocks (HBNNO, EMCNM, EMDTBEG, EMDTEND, HBDTAPPROVED, HBCORG, HBCFNM, HBCLNM, HBCEMAIL, HTCDSC)    
    SELECT DISTINCT    
          HRB.HBNNO    
        , E.EMCNM    
        , E.EMDTBEG    
        , E.EMDTEND    
        , HRB.HBDTAPPROVED    
        , HRB.HBCORG    
        , HRB.HBCFNM    
        , HRB.HBCLNM    
        , HRB.HBCEMAIL    
        , H.HTCDSC    
    FROM dbo.EVENTS E    
    INNER JOIN dbo.HOTEL H    
        ON H.EMNNO = E.EMNNO    
    INNER JOIN dbo.HOTELROOMBLOCKS HRB    
        ON HRB.HTNNO = H.HTNNO    
    WHERE    
        E.EMNNO = @EMNNO    
        AND     
  (    
              @ExcludeSpecial = 0    
              OR NOT (    
                    (UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCFNM,'')))) = 'IND'        AND UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCLNM,'')))) = 'RESERVATIONS')    
                 OR (UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCFNM,'')))) = 'JOHN'       AND UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCLNM,'')))) = 'BILLINGSLEY')    
                 OR (UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCFNM,'')))) = 'TOURNAMENT' AND UPPER(LTRIM(RTRIM(ISNULL(HRB.HBCLNM,'')))) = 'COMP')    
              )    
        );    
    
    ----------------------------------------------------------------------    
    -- 2) Aggregate inventory ONLY for selected blocks (RunPeakNight = SUM)    
    ----------------------------------------------------------------------    
    CREATE TABLE #Agg    
    (    
        HBNNO        INT NOT NULL PRIMARY KEY,    
        RunPeakNight DECIMAL(18,2) NOT NULL    
    );    
    
    INSERT INTO #Agg (HBNNO, RunPeakNight)    
    SELECT    
          I.HBNNO    
        , SUM(CAST(ISNULL(I.RBNAMOUNTRESERVED,0) AS DECIMAL(18,2)) + CAST(ISNULL(I.RBNADJUSTMENTS,0) AS DECIMAL(18,2))) AS RunPeakNight    
    FROM dbo.HOTELROOMBLOCKINVENTORY I    
    INNER JOIN #Blocks B    
        ON B.HBNNO = I.HBNNO    
    GROUP BY    
        I.HBNNO;    
    
    ----------------------------------------------------------------------    
    -- 3) Final output (ONLY the required columns + formatted date range)    
    ----------------------------------------------------------------------    
    SELECT    
          B.EMCNM    
        , (CONVERT(VARCHAR(10), CAST(B.EMDTBEG AS DATE), 101) + ' - ' +    
           CONVERT(VARCHAR(10), CAST(B.EMDTEND AS DATE), 101)) AS EventDateRange    
        , B.HBDTAPPROVED    
        , B.HBCORG    
        , (LTRIM(RTRIM(ISNULL(B.HBCFNM,''))) +    
           CASE WHEN ISNULL(LTRIM(RTRIM(B.HBCFNM)),'') <> '' AND ISNULL(LTRIM(RTRIM(B.HBCLNM)),'') <> '' THEN ' ' ELSE '' END +    
           LTRIM(RTRIM(ISNULL(B.HBCLNM,'')))) AS BlockTeamName    
        , B.HBCEMAIL    
        , B.HTCDSC    
        , ISNULL(A.RunPeakNight, 0) AS RunPeakNight    
    FROM #Blocks B    
    LEFT JOIN #Agg A    
        ON A.HBNNO = B.HBNNO    
    ORDER BY    
          ISNULL(B.HBDTAPPROVED, '19000101')    
        , ISNULL(B.HBCORG,'')    
        , (LTRIM(RTRIM(ISNULL(B.HBCFNM,''))) +    
           CASE WHEN ISNULL(LTRIM(RTRIM(B.HBCFNM)),'') <> '' AND ISNULL(LTRIM(RTRIM(B.HBCLNM)),'') <> '' THEN ' ' ELSE '' END +    
           LTRIM(RTRIM(ISNULL(B.HBCLNM,''))))    
        , B.HTCDSC;    
END 


